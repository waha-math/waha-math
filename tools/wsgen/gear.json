{
 "lines": {
  "gen.gear.helmet": "وَهَذِهِ خُوذَةُ المُهَنْدِسِ {لَكَ|لَكِ}: {أَعَدْتَ|أَعَدْتِ} حِجَارَةَ النَّبْعِ كُلَّهَا!",
  "gen.gear.ruler": "وَفِي {حَقِيبَتِكَ|حَقِيبَتِكِ} الآنَ المِسْطَرَةُ!",
  "gen.gear.prot": "وَفِي {حَقِيبَتِكَ|حَقِيبَتِكِ} الآنَ المِنْقَلَةُ أَيْضًا!",
  "gen.gear.compass": "وَاكْتَمَلَتِ الحَقِيبَةُ بِالفِرْجَارِ وَمُثَلَّثِ الرَّسْمِ!",
  "gen.gear.glasses": "وَهَذِهِ نَظَّارَاتُ المِقْيَاسِ {لَكَ|لَكِ}: يَصْغُرُ بِهَا الكَبِيرُ وَيَكْبُرُ الصَّغِيرُ!",
  "gen.gear.cap": "وَهَذِهِ قُبَّعَةُ المُخْتَرِعِ الزَّرْقَاءُ {لَكَ|لَكِ}!",
  "gen.gear.pen": "وَهَذَا قَلَمُ الفِرْجَارِ الذَّهَبِيُّ {لَكَ|لَكِ}!",
  "gen.gear.lamp": "وَهَذَا مِصْبَاحُ البُرْهَانِ {لَكَ|لَكِ}: {بَرْهَنْتَ|بَرْهَنْتِ} بِالأَدَوَاتِ!"
 },
