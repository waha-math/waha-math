 "lines": {
  "home.back": "{قِسْتَ|قِسْتِ} أَقْطَارَ الأَشْيَاءِ المُسْتَدِيرَةِ فِي البَيْتِ. وَالآنَ: أَسْئِلَةُ الأَحْيَاءِ كُلِّهَا.",
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قَلَمٌ وَوَرَقَةٌ لِلْحِسَابِ؟ أَمْ نَحْسُبُ فِي الرَّأْسِ عَلَى الشَّاشَةِ؟",
  "hook.01": "وَصَلْنَا إِلَى بَوَّابَةِ البَنَّائِينَ! الحَارِسُ يَسْأَلُ عَنْ كُلِّ أَحْيَاءِ المَدِينَةِ.",
  "hook.02": "عِشْرُونَ سُؤَالًا، بِلَا عَجَلَةٍ. {خُذِ|خُذِي} اسْتِرَاحَةً مَتَى {شِئْتَ|شِئْتِ}.",
  "mat.01": "{خُذِ|خُذِي} القَلَمَ وَالوَرَقَةَ، {وَاحْسُبْ|وَاحْسُبِي} عَلَيْهَا مَا {شِئْتَ|شِئْتِ}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "q.rulerMm": "كَمْ مِلِّيمِتْرًا طُولُ هَذَا الشَّيْءِ عَلَى المِسْطَرَةِ؟",
  "q.add": "كَمْ يَكُونُ المَجْمُوعُ؟",
  "q.mid": "{ضَعِ|ضَعِي} النُّقْطَةَ مِيم عِنْدَ مُنْتَصَفِ القِطْعَةِ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "q.pair": "مَا عَلَاقَةُ هَذَيْنِ المُسْتَقِيمَيْنِ؟",
  "q.gap": "كَمْ مُرَبَّعًا بَيْنَ المُسْتَقِيمَيْنِ المُتَوَازِيَيْنِ؟",
  "q.kind": "مَا نَوْعُ هَذِهِ الزَّاوِيَةِ؟",
  "q.rfx": "قِيَاسُ الزَّاوِيَةِ الصُّغْرَى مَكْتُوبٌ. كَمْ دَرَجَةً الزَّاوِيَةُ المُنْعَكِسَةُ؟",
  "q.name": "مَا اسْمُ هَذَا الرُّبَاعِيِّ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "q.reg": "هَلْ هَذَا المُضَلَّعُ مُنْتَظِمٌ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "q.count": "كَمْ مِحْوَرَ تَمَاثُلٍ لِهَذَا الشَّكْلِ؟",
  "q.perim": "كَمْ سَنْتِيمِتْرًا مُحِيطُ هَذَا الشَّكْلِ؟",
  "q.comp": "كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مِسَاحَةُ هَذِهِ الأَرْضِ؟",
  "q.read": "مَا الكَسْرُ المُلَوَّنُ؟",
  "q.cmp": "أَيُّ الكَسْرَيْنِ أَكْبَرُ؟",
  "q.dia": "نِصْفُ القُطْرِ مَكْتُوبٌ فَوْقُ. كَمْ سَنْتِيمِتْرًا القُطْرُ؟",
  "w.1": "قَالَتْ فَوْضَى: طُولُ الطَّاوِلَةِ ثَمَانُونَ. لِمَاذَا لَا يَكْفِي هَذَا؟",
  "w.1a": "لِأَنَّ العَدَدَ بِلَا وَحْدَةٍ لَا يَقُولُ: ثَمَانُونَ مَاذَا؟",
  "w.1b": "لِأَنَّ الطَّاوِلَةَ تُقَاسُ بِالشِّبْرِ لَا بِالأَعْدَادِ.",
  "w.1c": "لِأَنَّ ثَمَانِينَ عَدَدٌ كَبِيرٌ جِدًّا لَا يُقَاسُ بِهِ شَيْءٌ.",
  "w.2": "هَلِ المُرَبَّعُ مُسْتَطِيلٌ؟",
  "w.2a": "نَعَمْ: زَوَايَاهُ الأَرْبَعُ قَائِمَةٌ.",
  "w.2b": "نَعَمْ: لَهُ أَرْبَعَةُ أَضْلَاعٍ مِثْلَهُ.",
  "w.2c": "لَا: أَضْلَاعُ المُسْتَطِيلِ غَيْرُ مُتَسَاوِيَةٍ.",
  "w.3": "لِمَاذَا لَيْسَ قُطْرُ المُسْتَطِيلِ مِحْوَرَ تَمَاثُلٍ؟",
  "w.3a": "لِأَنَّا إِذَا طَوَيْنَاهُ عَلَيْهِ لَا يَنْطَبِقُ النِّصْفَانِ.",
  "w.3b": "لِأَنَّ القُطْرَ أَطْوَلُ مِنْ كُلِّ ضِلْعٍ فِي المُسْتَطِيلِ.",
  "w.3c": "لِأَنَّ المُسْتَطِيلَ لَيْسَ لَهُ أَيُّ مِحْوَرِ تَمَاثُلٍ أَصْلًا.",
  "w.4": "أَرْضَانِ مُسْتَطِيلَتَانِ سُورَاهُمَا بِالطُّولِ نَفْسِهِ: هَلْ تَتَّسِعَانِ لِلعُشْبِ نَفْسِهِ؟",
  "w.4a": "لَيْسَ دَائِمًا: قَدْ تَخْتَلِفُ المِسَاحَةُ وَالمُحِيطُ وَاحِدٌ.",
  "w.4b": "نَعَمْ: المُحِيطُ وَالمِسَاحَةُ شَيْءٌ وَاحِدٌ بِاسْمَيْنِ.",
  "w.4c": "لَا: الأَرْضُ الأَطْوَلُ مِنْهُمَا تَتَّسِعُ لِعُشْبٍ أَكْثَرَ مِنَ الأُخْرَى.",
  "fa.after": "{أَحْسَنْتَ|أَحْسَنْتِ} الصَّبْرَ! بَقِيَتْ مَهَامُّ الأَدَوَاتِ وَمُخَطَّطُ المَدِينَةِ فِي يَوْمٍ آخَرَ.",
  "wrap.01": "انْتَهَى الجُزْءُ الأَوَّلُ مِنْ بَوَّابَةِ البَنَّائِينَ."
 },
