 "lines": {
  "home.back": "{قِسْتَ|قِسْتِ} الظِّلَالَ فِي شَمْسِ العَصْرِ. وَالآنَ: أَسْئِلَةُ الأَحْيَاءِ كُلِّهَا.",
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قَلَمٌ وَوَرَقَةٌ لِلْحِسَابِ؟ أَمْ نَحْسُبُ فِي رُؤُوسِنَا؟",
  "hook.01": "وَصَلْنَا إِلَى بَوَّابَةِ المُهَنْدِسِينَ! الحَارِسُ يَسْأَلُ عَنْ كُلِّ أَحْيَاءِ المَدِينَةِ.",
  "hook.02": "عِشْرُونَ سُؤَالًا، بِلَا عَجَلَةٍ. {خُذِ|خُذِي} اسْتِرَاحَةً مَتَى {شِئْتَ|شِئْتِ}.",
  "mat.01": "{خُذِ|خُذِي} القَلَمَ وَالوَرَقَةَ، {وَاحْسُبْ|وَاحْسُبِي} عَلَيْهَا مَا {شِئْتَ|شِئْتِ}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "q.toDcm": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالسَّنْتِيمِتْرِ وَحْدَهُ:",
  "w.1": "أَرْضٌ مُسْتَطِيلَةٌ، وَقُطْرَاهَا مَعْرُوفَانِ. لِمَاذَا لَا نَحْسُبُ مِسَاحَتَهَا بِنِصْفِ حَاصِلِ ضَرْبِ القُطْرَيْنِ؟",
  "w.1a": "قُطْرَاهَا لَا يَتَعَامَدَانِ إِلَّا فِي المُرَبَّعِ.",
  "w.1b": "لِأَنَّ قُطْرَيِ المُسْتَطِيلِ مُتَسَاوِيَانِ دَائِمًا.",
  "w.1c": "لِأَنَّ الأَرْضَ المُسْتَطِيلَةَ لَا قُطْرَ لَهَا.",
  "w.2": "نَافُورَتَانِ: نِصْفُ قُطْرِ الثَّانِيَةِ ضِعْفُ الأُولَى. لِمَاذَا تَحْتَاجُ أَرْبَعَةَ أَضْعَافِ البَلَاطِ؟",
  "w.2a": "نِصْفُ القُطْرِ يُضْرَبُ فِي نَفْسِهِ: اثْنَانِ فِي اثْنَيْنِ.",
  "w.2b": "لِأَنَّ مُحِيطَهَا أَرْبَعَةُ أَضْعَافِ مُحِيطِ الأُولَى.",
  "w.2c": "لِأَنَّ بَاي يَتَضَاعَفُ حِينَ تَكْبُرُ الدَّائِرَةُ.",
  "w.3": "رَسَمَ مُهَنْدِسٌ لِمَبْنًى مَسْقَطًا أَمَامِيًّا وَاحِدًا. لِمَاذَا لَا يَكْفِي لِيَبْنِيَهُ البَنَّاؤُونَ؟",
  "w.3a": "يُظْهِرُ بُعْدَيْنِ، وَيُخْفِي العُمْقَ.",
  "w.3b": "لِأَنَّ المَسْقَطَ الأَمَامِيَّ أَصْغَرُ المَسَاقِطِ.",
  "w.3c": "لِأَنَّ المَبْنَى لَا يُرْسَمُ عَلَى وَرَقٍ.",
  "fa.after": "{أَحْسَنْتَ|أَحْسَنْتِ} الصَّبْرَ! بَقِيَتْ مَهَامُّ الأَدَوَاتِ وَمَدِينَةُ المِقْيَاسِ فِي يَوْمٍ آخَرَ.",
  "wrap.01": "انْتَهَى الجُزْءُ الأَوَّلُ مِنْ بَوَّابَةِ المُهَنْدِسِينَ."
 },
