  "ms.1": "إِطَارُ نَافِذَةٍ مُسْتَدِيرَةٍ قُطْرُهَا مِتْرٌ. كَمْ مِتْرًا مِنَ الخَشَبِ يَلْزَمُ لِحَافَتِهَا تَقْرِيبًا؟",
  "ms.1a": "أَكْثَرُ مِنْ ثَلَاثَةِ أَمْتَارٍ بِقَلِيلٍ.",
  "ms.1b": "مِتْرٌ وَاحِدٌ: الحَافَةُ بِطُولِ القُطْرِ.",
  "ms.1c": "مِتْرَانِ: الحَافَةُ قُطْرَانِ، وَاحِدٌ فَوْقُ وَوَاحِدٌ تَحْتُ.",
  "ms.recall": "نَتَذَكَّرُ: المُحِيطُ بَاي فِي القُطْرِ، وَبِنِصْفِ القُطْرِ نَضْرِبُ فِي اثْنَيْنِ أَيْضًا.",
  "ms.x1": "قُطْرُ دَائِرَةٍ عَشَرَةُ سَنْتِيمِتْرَاتٍ. لِمَاذَا مُحِيطُهَا أَكْثَرُ مِنْ ثَلَاثِينَ؟",
  "ms.x1a": "بَاي أَكْبَرُ مِنْ ثَلَاثَةٍ، فَالمُحِيطُ أَكْثَرُ مِنْ ثَلَاثَةِ أَقْطَارٍ.",
  "ms.x1b": "المُحِيطُ ضِعْفُ القُطْرِ، ثُمَّ نَزِيدُ عَلَيْهِ عَشَرَةً أُخْرَى.",
  "ms.x1c": "المُحِيطُ يُقَاسُ بِالسَّنْتِيمِتْرِ المُرَبَّعِ، لَا بِالسَّنْتِيمِتْرِ.",
