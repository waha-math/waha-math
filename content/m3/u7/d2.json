 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ وَمِسْطَرَةٌ وَعُلْبَةٌ مُسْتَدِيرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "مُحِيطُ الدَّائِرَةِ ثَلَاثَةُ أَضْعَافِ قُطْرِهَا بِالضَّبْطِ!"
  ],
  "hk.02": "نَفْرُدُ الخَيْطَ وَنَضَعُ عَلَيْهِ ثَلَاثَةَ أَقْطَارٍ: يَبْقَى مِنْهُ جُزْءٌ صَغِيرٌ. المُحِيطُ أَطْوَلُ قَلِيلًا مِنْ ثَلَاثَةِ أَقْطَارٍ.",
  "st.01": "المُحِيطُ طُولُ الحَافَةِ كُلِّهَا: نَلُفُّ الخَيْطَ حَوْلَ العُلْبَةِ، ثُمَّ نَفْرُدُهُ عَلَى المِسْطَرَةِ.",
  "st.02": "نَقْسِمُ المُحِيطَ عَلَى القُطْرِ فِي العُلَبِ الثَّلَاثِ: ثَلَاثَةٌ وَعُشْرٌ تَقْرِيبًا كُلَّ مَرَّةٍ، صَغُرَتِ العُلْبَةُ أَوْ كَبُرَتْ.",
  "pi.01": "هَذِهِ النِّسْبَةُ الثَّابِتَةُ اسْمُهَا بَاي، وَهِيَ عَدَدٌ لَا يَنْتَهِي، وَتَقْرِيبُهُ ثَلَاثَةٌ وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ.",
  "pi.02": "فَالمُحِيطُ يُسَاوِي بَاي فِي القُطْرِ، أَيْ ثَلَاثَةً وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ فِي القُطْرِ.",
  "pi.03": "وَبِنِصْفِ القُطْرِ: القُطْرُ نِصْفَا قُطْرٍ، فَنَضْرِبُ فِي اثْنَيْنِ أَيْضًا. نِصْفُ قُطْرٍ خَمْسَةٌ: المُحِيطُ وَاحِدٌ وَثَلَاثُونَ وَأَرْبَعَةُ أَعْشَارٍ.",
  "pi.04": "وَنُقَرِّبُ المُحِيطَ إِلَى مَنْزِلَةٍ عَشْرِيَّةٍ وَاحِدَةٍ، وَنَتَحَقَّقُ بِالخَيْطِ.",
  "ar.01": "حِكَايَةٌ: قَبْلَ أَكْثَرَ مِنْ أَلْفَيْ عَامٍ رَسَمَ العَالِمُ أَرْخَمِيدِسُ سُدَاسِيًّا دَاخِلَ الدَّائِرَةِ وَآخَرَ خَارِجَهَا، وَمُحِيطُ الدَّائِرَةِ بَيْنَ مُحِيطَيْهِمَا.",
  "ar.02": "ثُمَّ ضَاعَفَ الأَضْلَاعَ مَرَّةً بَعْدَ مَرَّةٍ، فَاقْتَرَبَ المُضَلَّعَانِ مِنَ الدَّائِرَةِ.",
  "ar.03": "وَكُلَّمَا زَادَتِ الأَضْلَاعُ ضَاقَتِ المَسَافَةُ بَيْنَ المُضَلَّعَيْنِ، فَعَرَفَ أَنَّ بَاي أَكْبَرُ مِنْ ثَلَاثَةٍ وَعُشْرٍ، وَأَصْغَرُ مِنْ ثَلَاثَةٍ وَسُبْعٍ.",
  "mat.01": "{لُفَّ|لُفِّي} خَيْطًا حَوْلَ عُلْبَةٍ مُسْتَدِيرَةٍ، {وَافْرُدْهُ|وَافْرُدِيهِ} عَلَى المِسْطَرَةِ، {وَقِسْ|وَقِيسِي} قُطْرَهَا، {وَاقْسِمِ|وَاقْسِمِي} المُحِيطَ عَلَى القُطْرِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: سَاعِي الخَيْطِ! {تَوَقَّعْ|تَوَقَّعِي} طُولَ الخَيْطِ حَوْلَ العُلْبَةِ، ثُمَّ نَفْرُدُهُ وَنَقِيسُ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: مُحِيطُ دَائِرَةٍ نِصْفُ قُطْرِهَا خَمْسَةٌ هُوَ ثَلَاثَةٌ وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ فِي خَمْسَةٍ. مَا خَطَؤُهَا؟",
  "pr.r1a": "نَسِيَتِ الضَّرْبَ فِي اثْنَيْنِ.",
  "pr.r1b": "لَا خَطَأَ: نَضْرِبُ فِي نِصْفِ القُطْرِ وَحْدَهُ.",
  "pr.r1c": "كَانَ عَلَيْهَا أَنْ تَضْرِبَ فِي ثَلَاثَةٍ لَا فِي بَاي.",
  "pr.r2": "لِمَاذَا لَا نَقُولُ إِنَّ بَاي يُسَاوِي ثَلَاثَةً وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ تَمَامًا؟",
  "pr.r2a": "هَذَا تَقْرِيبٌ، وَأَرْقَامُ بَاي لَا تَنْتَهِي.",
  "pr.r2b": "بَاي يَتَغَيَّرُ مِنْ دَائِرَةٍ إِلَى دَائِرَةٍ أُخْرَى.",
  "pr.r2c": "بَاي ثَلَاثَةٌ صَحِيحَةٌ، بِلَا كَسْرٍ بَعْدَهَا.",
  "ch.find": "قَالَتْ فَوْضَى: المُحِيطُ ثَلَاثَةٌ وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ فِي نِصْفِ القُطْرِ. {صَحِّحْ|صَحِّحِي}: كَمْ مُحِيطُ الدَّائِرَةِ؟ نِصْفُ قُطْرِهَا:",
  "ch.after": [
