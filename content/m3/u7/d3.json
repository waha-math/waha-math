  ],
  "ask": "bag.ask",
  "adult": "ورق مربعات وفرجار بإشرافكم.",
  "screenPath": "على الشاشة يقدّر الطفل مساحة القرص بين مربعين، ويحسبها بالقانون، ويميّز السياج (المحيط) من العشب (المساحة)."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagCompass": "فِرْجَارٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَفِرْجَارٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "مِسَاحَةُ الدَّائِرَةِ مُحِيطُهَا فِي نِصْفِ قُطْرِهَا: مِئَةٌ وَسَبْعَةٌ وَخَمْسُونَ!"
  ],
  "hk.02": "لَكِنَّ القُرْصَ دَاخِلَ مُرَبَّعٍ مِسَاحَتُهُ مِئَةٌ، فَمِسَاحَتُهُ أَقَلُّ مِنْ مِئَةٍ. نَحْسُبُ وَنَعُدُّ.",
  "ds.01": "القُرْصُ هُوَ مَا دَاخِلَ الدَّائِرَةِ. هَذَا قُرْصٌ نِصْفُ قُطْرِهِ اثْنَانِ عَلَى وَرَقِ المُرَبَّعَاتِ.",
  "ds.02": "أَرْبَعَةُ مُرَبَّعَاتٍ كَامِلَةٍ فِي الوَسَطِ.",
  "ds.03": "وَثَمَانِيَةُ مُرَبَّعَاتٍ حَوْلَهَا، فِي كُلٍّ مِنْهَا أَكْثَرُ مِنْ نِصْفِهِ: نَعُدُّهَا كَامِلَةً، فَصَارَتِ اثْنَيْ عَشَرَ.",
  "ds.04": "وَالقِطَعُ الأَرْبَعُ فِي الأَرْكَانِ فِي كُلٍّ مِنْهَا أَقَلُّ مِنْ نِصْفِ مُرَبَّعٍ، فَلَا نَعُدُّهَا: فَالمَجْمُوعُ قَرِيبٌ مِنِ اثْنَيْ عَشَرَ مُرَبَّعًا.",
  "ds.05": "وَالقَانُونُ: ثَلَاثَةٌ وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ فِي نِصْفِ القُطْرِ فِي نِصْفِ القُطْرِ: اثْنَا عَشَرَ وَسِتَّةٌ وَخَمْسُونَ جُزْءًا مِنْ مِئَةٍ. قَرِيبٌ مِنَ العَدِّ!",
  "bd.01": "قُرْصٌ نِصْفُ قُطْرِهِ ثَلَاثَةٌ.",
  "bd.02": "المُرَبَّعُ حَوْلَهُ سِتَّةٌ فِي سِتَّةٍ: سِتَّةٌ وَثَلَاثُونَ، وَالمُرَبَّعُ المَائِلُ دَاخِلَهُ ثَمَانِيَةَ عَشَرَ. مِسَاحَةُ القُرْصِ بَيْنَهُمَا.",
  "bd.03": "وَالقَانُونُ يُعْطِي ثَمَانِيَةً وَعِشْرِينَ وَسِتَّةً وَعِشْرِينَ جُزْءًا مِنْ مِئَةٍ: بَيْنَ ثَمَانِيَةَ عَشَرَ وَسِتَّةٍ وَثَلَاثِينَ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} بِالفِرْجَارِ عَلَى وَرَقِ المُرَبَّعَاتِ قُرْصًا، {وَعُدَّ|وَعُدِّي} المُرَبَّعَاتِ الكَامِلَةَ وَأَنْصَافَهَا دَاخِلَهُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مُهَنْدِسُ الحَدَائِقِ! السِّيَاجُ حَوْلَ الحَدِيقَةِ مُحِيطٌ، وَالبُذُورُ لِلْعُشْبِ مِسَاحَةٌ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَ طَالِبٌ: مِسَاحَةُ قُرْصٍ نِصْفُ قُطْرِهِ ثَلَاثَةٌ هِيَ ثَلَاثَةٌ وَأَرْبَعَةَ عَشَرَ جُزْءًا مِنْ مِئَةٍ فِي ثَلَاثَةٍ. مَا خَطَؤُهُ؟",
  "pr.r1a": "نَسِيَ نِصْفَ القُطْرِ الثَّانِيَ: نَضْرِبُ فِيهِ مَرَّتَيْنِ.",
  "pr.r1b": "لَا خَطَأَ: المِسَاحَةُ بَاي فِي نِصْفِ القُطْرِ وَحْدَهُ.",
  "pr.r1c": "كَانَ عَلَيْهِ أَنْ يَضْرِبَ فِي اثْنَيْنِ كَالمُحِيطِ.",
  "pr.two": "{أَقْنِعْنِي|أَقْنِعِينِي} بِسَبَبَيْنِ: مُحِيطُ أَيِّ دَائِرَةٍ يُسَاوِي قُطْرَهَا مَضْرُوبًا فِي بَاي تَقْرِيبًا. {اِلْمِسِ|اِلْمِسِي} البِطَاقَتَيْنِ الصَّحِيحَتَيْنِ، ثُمَّ «تَمَّ».",
  "pr.twoa": "لَفَفْتُ خَيْطًا حَوْلَ ثَلَاثِ عُلَبٍ، وَقَسَمْتُ المُحِيطَ عَلَى القُطْرِ فَخَرَجَ ثَلَاثَةٌ وَعُشْرٌ تَقْرِيبًا كُلَّ مَرَّةٍ.",
  "pr.twob": "السُّدَاسِيُّ دَاخِلَ الدَّائِرَةِ مُحِيطُهُ ثَلَاثَةُ أَقْطَارٍ، وَالدَّائِرَةُ خَارِجَهُ فَمُحِيطُهَا أَطْوَلُ قَلِيلًا.",
  "pr.twoc": "لَفَفْتُ خَيْطًا حَوْلَ عُلْبَةٍ كَبِيرَةٍ فَكَانَ أَطْوَلَ، فَالنِّسْبَةُ تَكْبُرُ كُلَّمَا كَبِرَتِ العُلْبَةُ.",
  "pr.twoHint": "السَّبَبُ المُقْنِعُ قِيَاسٌ أَوْ رَسْمٌ، وَالتَّقْرِيبُ لَيْسَ بِالضَّبْطِ.",
  "ch.find": "قَالَتْ فَوْضَى: المِسَاحَةُ المُحِيطُ فِي نِصْفِ القُطْرِ. {صَحِّحْ|صَحِّحِي}: كَمْ مِسَاحَةُ القُرْصِ؟ نِصْفُ قُطْرِهِ:",
  "ch.after": [
   "chaos",
   "آه! ضَاعَفْتُ المِسَاحَةَ."
  ],
  "ch.right": "بَاي فِي نِصْفِ القُطْرِ فِي نِصْفِ القُطْرِ.",
  "ch.wrong": [
   "chaos",
   "المُحِيطُ فِي نِصْفِ القُطْرِ."
  ],
  "ms.1": "نُرِيدُ قُمَاشًا لِطَاوِلَةٍ مُسْتَدِيرَةٍ، وَشَرِيطًا عَلَى حَافَتِهِ. أَيُّهُمَا نَحْسُبُهُ بِالمِسَاحَةِ؟",
  "ms.1a": "القُمَاشُ: يُغَطِّي القُرْصَ كُلَّهُ.",
  "ms.1b": "الشَّرِيطُ: يَدُورُ حَوْلَ الحَافَةِ كُلِّهَا.",
  "ms.1c": "كِلَاهُمَا يُحْسَبُ بِالمِسَاحَةِ نَفْسِهَا.",
  "ms.recall": "نَتَذَكَّرُ: المِسَاحَةُ بَاي فِي نِصْفِ القُطْرِ فِي نِصْفِ القُطْرِ، وَبِالوَحْدَةِ المُرَبَّعَةِ.",
  "ms.x1": "نُرِيدُ أَنْ نَطْلِيَ أَرْضِيَّةَ نَافُورَةٍ مُسْتَدِيرَةٍ. بِأَيِّ وَحْدَةٍ نَكْتُبُ مَا نَطْلِيهِ؟",
  "ms.x1a": "بِالمِتْرِ المُرَبَّعِ: نُغَطِّي سَطْحًا.",
  "ms.x1b": "بِالمِتْرِ وَحْدَهُ: نَقِيسُ الحَافَةَ الَّتِي تَدُورُ حَوْلَهَا.",
  "ms.x1c": "بِعَدَدِ الأَقْطَارِ الَّتِي نَرْسُمُهَا فِي أَرْضِيَّتِهَا.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} مِسَاحَةَ القُرْصِ!",
  "wrap.01": "الخَيْطُ لِلْمُحِيطِ، وَالبَلَاطُ لِلْمِسَاحَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} قُرْصًا عَلَى وَرَقِ المُرَبَّعَاتِ، {وَعُدَّ|وَعُدِّي} مُرَبَّعَاتِهِ، {وَقَارِنْ|وَقَارِنِي} بِالقَانُونِ مَعَ {أَهْلِكَ|أَهْلِكِ}."
  ]
