   "مَرَّتَانِ كَنِصْفِ القُطْرِ."
  ],
  "ms.1": "نِصْفُ قُطْرِ قُرْصٍ صَارَ ضِعْفًا. أَيُّ قَوْلٍ صَحِيحٌ؟",
  "ms.1a": "المِسَاحَةُ أَرْبَعَةُ أَضْعَافٍ، وَالمُحِيطُ ضِعْفٌ.",
  "ms.1b": "المِسَاحَةُ ضِعْفٌ، وَالمُحِيطُ أَرْبَعَةُ أَضْعَافٍ.",
  "ms.1c": "المِسَاحَةُ وَالمُحِيطُ ضِعْفَانِ كِلَاهُمَا.",
  "ms.recall": "نَتَذَكَّرُ: نِصْفُ القُطْرِ ضِعْفٌ، فَالمِسَاحَةُ أَرْبَعَةُ أَضْعَافٍ، لِأَنَّنَا نَضْرِبُ فِيهِ مَرَّتَيْنِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} المِسَاحَةَ حِينَ يَكْبُرُ القُرْصُ!",
  "wrap.01": "سِيَاجٌ بِالمِتْرِ، وَعُشْبٌ بِالمِتْرِ المُرَبَّعِ!",
  "wrap.home": [
