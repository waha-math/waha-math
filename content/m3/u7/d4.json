 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَفِرْجَارٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "db.01": "قُرْصٌ نِصْفُ قُطْرِهِ اثْنَانِ: مِسَاحَتُهُ اثْنَا عَشَرَ وَسِتَّةٌ وَخَمْسُونَ جُزْءًا مِنْ مِئَةٍ.",
  "db.02": "ضَاعَفْنَا نِصْفَ القُطْرِ إِلَى أَرْبَعَةٍ: المِسَاحَةُ خَمْسُونَ وَأَرْبَعَةٌ وَعِشْرُونَ جُزْءًا مِنْ مِئَةٍ.",
  "db.03": "المُرَبَّعُ حَوْلَ الكَبِيرِ يَسَعُ أَرْبَعَةَ مُرَبَّعَاتٍ كَالمُرَبَّعِ حَوْلَ الصَّغِيرِ: الطُّولُ ضِعْفٌ، وَالعَرْضُ ضِعْفٌ.",
  "db.04": "فَتَتَضَاعَفُ المِسَاحَةُ أَرْبَعَ مَرَّاتٍ: اثْنَانِ فِي اثْنَيْنِ، لِأَنَّنَا نَضْرِبُ فِي نِصْفِ القُطْرِ مَرَّتَيْنِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} بِالفِرْجَارِ عَلَى وَرَقِ المُرَبَّعَاتِ قُرْصًا صَغِيرًا، وَآخَرَ نِصْفُ قُطْرِهِ ضِعْفُ نِصْفِ قُطْرِ الصَّغِيرِ، {وَعُدَّ|وَعُدِّي} المُرَبَّعَاتِ دَاخِلَ كُلٍّ مِنْهُمَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "هَيَّا نُقَارِنُ الدَّوَائِرَ قَبْلَ المَشْرُوعِ.",
  "gd.01": "مَشْرُوعُ الحَدِيقَةِ المُسْتَدِيرَةِ: نِصْفُ قُطْرِهَا خَمْسَةُ أَمْتَارٍ، وَكُلُّ مُرَبَّعٍ مِتْرٌ.",
  "gd.02": "السِّيَاجُ حَوْلَهَا مُحِيطٌ: اثْنَانِ فِي بَاي فِي خَمْسَةٍ، وَاحِدٌ وَثَلَاثُونَ مِتْرًا وَأَرْبَعَةُ أَعْشَارٍ.",
  "gd.03": "وَالعُشْبُ مِسَاحَةُ القُرْصِ: بَاي فِي خَمْسَةٍ فِي خَمْسَةٍ، ثَمَانِيَةٌ وَسَبْعُونَ مِتْرًا مُرَبَّعًا وَخَمْسَةُ أَعْشَارٍ.",
  "gd.04": "وَالقُطْرُ يَقْسِمُ القُرْصَ نِصْفَيْنِ مُتَسَاوِيَيْنِ: لِكُلِّ نِصْفٍ تِسْعَةٌ وَثَلَاثُونَ مِتْرًا مُرَبَّعًا وَخَمْسَةٌ وَعِشْرُونَ جُزْءًا مِنْ مِئَةٍ.",
  "tb.01": "جَدْوَلُ المَشْرُوعِ: لِكُلِّ عُنْصُرٍ حِسَابُهُ وَنَاتِجُهُ وَوَحْدَتُهُ؛ المِتْرُ لِلسِّيَاجِ، وَالمِتْرُ المُرَبَّعُ لِلْعُشْبِ.",
  "tb.02": "وَالآنَ {صَمِّمْ|صَمِّمِي} حَوْضَيْنِ دَائِرِيَّيْنِ بِنِصْفَيْ قُطْرٍ مُخْتَلِفَيْنِ، {وَقَارِنْ|وَقَارِنِي} مُحِيطَيْهِمَا وَمِسَاحَتَيْهِمَا.",
  "prj.intro": "نَبْنِي الحَدِيقَةَ: كُلُّ مُرَبَّعٍ مِتْرٌ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: ضَاعَفْتُ نِصْفَ القُطْرِ، فَتَضَاعَفَتِ المِسَاحَةُ مَرَّتَيْنِ. مَا خَطَؤُهَا؟",
  "pr.r1a": "تَتَضَاعَفُ أَرْبَعَ مَرَّاتٍ: نَضْرِبُ فِي نِصْفِ القُطْرِ مَرَّتَيْنِ.",
  "pr.r1b": "لَا خَطَأَ: المِسَاحَةُ تَتَضَاعَفُ دَائِمًا كَمَا يَتَضَاعَفُ نِصْفُ القُطْرِ.",
  "pr.r1c": "المِسَاحَةُ لَا تَتَغَيَّرُ أَبَدًا، فَالشَّكْلُ مَا زَالَ دَائِرَةً.",
  "ch.find": "قَالَتْ فَوْضَى: ضَاعَفْتُ نِصْفَ القُطْرِ فَتَضَاعَفَتِ المِسَاحَةُ مَرَّتَيْنِ. كَمْ مَرَّةً تَتَضَاعَفُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! أَرْبَعَ مَرَّاتٍ."
  ],
  "ch.right": "اثْنَانِ فِي اثْنَيْنِ: أَرْبَعُ مَرَّاتٍ.",
  "ch.wrong": [
