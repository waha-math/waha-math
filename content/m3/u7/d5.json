  "ask": "bag.ask",
  "adult": "خيط وفرجار ومسطرة وعلبة مستديرة.",
  "screenPath": "أسئلة الوحدة على الشاشة: أجزاء الدائرة، وفتحة الفرجار، والمحيط، والمساحة، والخيط والعدد باي."
 },
 "labels": {
  "bagThread": "خَيْطٌ",
  "bagCompass": "فِرْجَارٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ وَفِرْجَارٌ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ الدَّائِرَةِ أَخْطَاءُ فَوْضَى: مُحِيطٌ بِلَا ضَرْبٍ فِي اثْنَيْنِ، وَمِسَاحَةٌ بِالقُطْرِ، وَفَتْحَةُ فِرْجَارٍ بِطُولِ القُطْرِ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {حِرَفِيِّ|حِرَفِيَّةِ} الدَّائِرَةِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ الثَّامِنِ.",
  "mat.01": "{لُفَّ|لُفِّي} خَيْطًا حَوْلَ عُلْبَةٍ {وَقِسْهُ|وَقِيسِيهِ} بِالمِسْطَرَةِ، {وَارْسُمْ|وَارْسُمِي} بِالفِرْجَارِ دَائِرَةً، {وَقُلْ|وَقُولِي} أَيْنَ المُحِيطُ وَأَيْنَ القُرْصُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: فَتْحَةُ الفِرْجَارِ نِصْفُ القُطْرِ، وَالمُحِيطُ بَاي فِي القُطْرِ.",
  "rv.02": "وَالمِسَاحَةُ بَاي فِي نِصْفِ القُطْرِ فِي نِصْفِ القُطْرِ، بِالوَحْدَةِ المُرَبَّعَةِ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى فِي حَيِّ الدَّائِرَةِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.perim": "ضَرَبَتْ فَوْضَى بَاي فِي نِصْفِ القُطْرِ وَحْدَهُ. {صَحِّحْ|صَحِّحِي}: كَمْ مُحِيطُ الدَّائِرَةِ؟ نِصْفُ قُطْرِهَا:",
  "gm.area": "ضَرَبَتْ فَوْضَى بِالقُطْرِ لَا بِنِصْفِهِ. {صَحِّحْ|صَحِّحِي}: كَمْ مِسَاحَةُ القُرْصِ؟ قُطْرُهُ:",
  "gm.open": "ضَبَطَتْ فَوْضَى الفَتْحَةَ عَلَى القُطْرِ. {اِضْبِطْهَا|اِضْبِطِيهَا} صَحِيحَةً، ثُمَّ «تَمَّ». القُطْرُ:",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "pr.part": "مَا اسْمُ الجُزْءِ المُلَوَّنِ مِنَ الدَّائِرَةِ؟",
  "pr.rd": "نَعْرِفُ نِصْفَ القُطْرِ. كَمْ قُطْرُ الدَّائِرَةِ؟",
  "gm.q": "دَائِرَةٌ بِهَذَا القُطْرِ: {اِضْبِطْ|اِضْبِطِي} فَتْحَةَ الفِرْجَارِ، ثُمَّ «تَمَّ». القُطْرُ:",
  "ts.11": "قَالَ طَالِبٌ: مُحِيطُ دَائِرَةٍ نِصْفُ قُطْرِهَا خَمْسَةٌ هُوَ بَاي فِي خَمْسَةٍ فِي خَمْسَةٍ. مَا خَطَؤُهُ؟",
  "ts.11a": "خَلَطَ بَيْنَ القَانُونَيْنِ: هَذِهِ مِسَاحَةُ القُرْصِ، لَا طُولُ حَافَتِهِ.",
  "ts.11b": "لَا خَطَأَ: المُحِيطُ وَالمِسَاحَةُ يُحْسَبَانِ بِالقَانُونِ نَفْسِهِ.",
  "ts.11c": "كَانَ عَلَيْهِ أَنْ يَضْرِبَ فِي خَمْسَةٍ مَرَّةً ثَالِثَةً.",
  "ts.12": "لِمَاذَا تَتَضَاعَفُ المِسَاحَةُ أَرْبَعَ مَرَّاتٍ حِينَ يَتَضَاعَفُ نِصْفُ القُطْرِ؟",
  "ts.12a": "حَوْلَ الكَبِيرِ مُرَبَّعٌ يَسَعُ أَرْبَعَةً كَمُرَبَّعِ الصَّغِيرِ.",
  "ts.12b": "القُطْرُ يَتَضَاعَفُ أَيْضًا، وَاثْنَانِ وَاثْنَانِ أَرْبَعَةٌ.",
  "ts.12c": "المُحِيطُ يَصِيرُ أَرْبَعَةَ أَضْعَافٍ، فَتَتْبَعُهُ المِسَاحَةُ.",
  "ts.rem": "نَعُودُ إِلَى الخَيْطِ وَالعُلَبِ، وَنَعُدُّ مُرَبَّعَاتِ قُرْصٍ عَلَى الشَّبَكَةِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ الثَّامِنِ."
  ],
  "ts.win1": "{أَنْتَ حِرَفِيُّ|أَنْتِ حِرَفِيَّةُ} الدَّائِرَةِ!",
  "ts.win2": "{سَمَّيْتَ|سَمَّيْتِ} أَجْزَاءَهَا، {وَحَسَبْتَ|وَحَسَبْتِ} مُحِيطَهَا وَمِسَاحَتَهَا، {وَمَيَّزْتَ|وَمَيَّزْتِ} السِّيَاجَ مِنَ العُشْبِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {حِرَفِيِّ|حِرَفِيَّةِ} الدَّائِرَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} قُطْرَ طَبَقٍ وَقُطْرَ كُوبٍ، {وَاحْسُبْ|وَاحْسُبِي} مُحِيطَ كُلٍّ مِنْهُمَا، ثُمَّ {تَحَقَّقْ|تَحَقَّقِي} بِخَيْطٍ."
  ]
 },
