 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ الإِحْدَاثِيَّاتِ أَخْطَاءُ فَوْضَى: زَوْجٌ مَقْلُوبٌ، وَمُرَبَّعَاتٌ مَعْدُودَةٌ بَدَلَ الخُطُوطِ، وَمَسَافَةٌ بِالجَمْعِ، وَرَأْسٌ رَابِعٌ فِي غَيْرِ مَكَانِهِ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {رَسَّامِ|رَسَّامَةِ} الإِحْدَاثِيَّاتِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ السَّادِسِ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمِ|اُرْسُمِي} المِحْوَرَ الأُفُقِيَّ وَالمِحْوَرَ الرَّأْسِيَّ بِالمِسْطَرَةِ، {وَعَيِّنْ|وَعَيِّنِي} رُؤُوسَ مُسْتَطِيلٍ، {وَاحْسُبْ|وَاحْسُبِي} مُحِيطَهُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: الزَّوْجُ المُرَتَّبُ يَمِينًا أَوَّلًا ثُمَّ لِأَعْلَى، وَالنُّقْطَةُ عِنْدَ التَّقَاطُعِ.",
  "rv.02": "وَالمَسَافَةُ عَلَى خَطٍّ أُفُقِيٍّ أَوْ رَأْسِيٍّ فَرْقٌ، وَالرَّأْسُ المَجْهُولُ مِنْ جَارَيْهِ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى الإِحْدَاثِيَّاتِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.swap": "قَلَبَتْ فَوْضَى التَّرْتِيبَ. {عَيِّنِ|عَيِّنِي} النُّقْطَةَ صَحِيحَةً:",
  "gm.square": "عَدَّتْ فَوْضَى المُرَبَّعَاتِ لَا الخُطُوطَ. مَا إِحْدَاثِيَّا النُّقْطَةِ حَقًّا؟",
  "gm.sum": "جَمَعَتْ فَوْضَى الإِحْدَاثِيَّيْنِ. كَمِ المَسَافَةُ حَقًّا؟",
  "gm.vertex": "وَضَعَتْ فَوْضَى الرَّأْسَ الرَّابِعَ لِلْمُسْتَطِيلِ فِي غَيْرِ مَكَانِهِ. {عَيِّنْهُ|عَيِّنِيهِ} حَقًّا، ثُمَّ «تَمَّ».",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "pr.rect": "هَذِهِ ثَلَاثَةُ رُؤُوسٍ لِمُسْتَطِيلٍ. {عَيِّنِ|عَيِّنِي} الرَّأْسَ الرَّابِعَ، ثُمَّ «تَمَّ».",
  "pr.square": "هَذِهِ ثَلَاثَةُ رُؤُوسٍ لِمُرَبَّعٍ. {عَيِّنِ|عَيِّنِي} الرَّأْسَ الرَّابِعَ، ثُمَّ «تَمَّ».",
  "gm.draw": "{اِلْمِسِ|اِلْمِسِي} الرُّؤُوسَ المَكْتُوبَةَ بِالتَّرْتِيبِ، ثُمَّ «تَمَّ».",
  "ts.11": "قَالَتْ فَوْضَى: المَسَافَةُ عَلَى خَطٍّ رَأْسِيٍّ مَجْمُوعُ الإِحْدَاثِيَّيْنِ. مَا خَطَؤُهَا؟",
  "ts.11a": "المَسَافَةُ فَرْقٌ لَا مَجْمُوعٌ.",
  "ts.11b": "كَانَ عَلَيْهَا أَنْ تَجْمَعَ الأُفُقِيَّيْنِ.",
  "ts.11c": "لَا خَطَأَ عَلَى الخَطِّ الرَّأْسِيِّ.",
  "ts.12": "لِمَاذَا ثَلَاثَةٌ وَاثْنَانِ، وَاثْنَانِ وَثَلَاثَةٌ، نُقْطَتَانِ مُخْتَلِفَتَانِ؟",
  "ts.12a": "الأَوَّلُ يَمِينًا، فَالطَّرِيقَانِ مُخْتَلِفَانِ.",
  "ts.12b": "لِأَنَّ ثَلَاثَةً أَكْبَرُ مِنَ اثْنَيْنِ.",
  "ts.12c": "لَيْسَتَا مُخْتَلِفَتَيْنِ: العَدَدَانِ أَنْفُسُهُمَا.",
  "ts.rem": "نَمْشِي بِالإِصْبَعِ عَلَى خُطُوطِ الشَّبَكَةِ مَعَ الكِبَارِ، وَنَرْسُمُ خَرِيطَةَ غُرْفَةٍ بِالإِحْدَاثِيَّاتِ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ السَّادِسِ."
  ],
  "ts.win1": "{أَنْتَ رَسَّامُ|أَنْتِ رَسَّامَةُ} الإِحْدَاثِيَّاتِ!",
  "ts.win2": "{عَيَّنْتَ|عَيَّنْتِ} النِّقَاطَ {وَقَرَأْتَهَا|وَقَرَأْتِهَا}، {وَحَسَبْتَ|وَحَسَبْتِ} المَسَافَاتِ، {وَوَجَدْتَ|وَوَجَدْتِ} الرُّؤُوسَ المَجْهُولَةَ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {رَسَّامِ|رَسَّامَةِ} الإِحْدَاثِيَّاتِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُطْلُبْ|اُطْلُبِي} مِنْ {أَهْلِكَ|أَهْلِكِ} أَنْ يُخَبِّئُوا شَيْئًا وَيَكْتُبُوا {لَكَ|لَكِ} زَوْجَهُ بِالبَلَاطِ، {وَجِدْهُ|وَجِدِيهِ} بِالعَدِّ."
  ]
 },
