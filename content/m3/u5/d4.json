 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَأَقْلَامٌ مُلَوَّنَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "ثَلَاثَةُ رُؤُوسٍ لِمُسْتَطِيلٍ، وَالرَّابِعُ: وَاحِدٌ يَمِينًا، وَخَمْسَةٌ لِأَعْلَى!"
  ],
  "hk.02": "نُعَيِّنُهُ فَنَرَى: الضِّلْعَانِ المُتَقَابِلَانِ لَيْسَا مُتَسَاوِيَيْنِ. الرَّابِعُ وَاحِدٌ يَمِينًا، وَأَرْبَعَةٌ لِأَعْلَى.",
  "sh.01": "نُعَيِّنُ الرُّؤُوسَ وَنَصِلُهَا بِالتَّرْتِيبِ: مُسْتَطِيلٌ ضِلْعَاهُ بِالفَرْقِ أَرْبَعَةٌ وَثَلَاثَةٌ، مُحِيطُهُ أَرْبَعَةَ عَشَرَ، وَمِسَاحَتُهُ اثْنَا عَشَرَ.",
  "sh.02": "وَالرَّأْسُ المَجْهُولُ لِلْمُرَبَّعِ: إِحْدَاثِيُّهُ الأُفُقِيُّ مِنْ جَارِهِ، وَالرَّأْسِيُّ مِنْ جَارِهِ الآخَرِ، فَالأَضْلَاعُ المُتَقَابِلَةُ مُتَسَاوِيَةٌ.",
  "sh.03": "وَمُثَلَّثٌ قَاعِدَتُهُ أُفُقِيَّةٌ طُولُهَا خَمْسَةٌ، وَارْتِفَاعُهُ فَرْقٌ رَأْسِيٌّ: أَرْبَعَةٌ. مِسَاحَتُهُ عَشَرَةٌ.",
  "sh.04": "وَشَكْلٌ كَالزَّاوِيَةِ نُقَسِّمُهُ مُسْتَطِيلَيْنِ: اثْنَا عَشَرَ وَتِسْعَةٌ، وَاحِدٌ وَعِشْرُونَ؛ وَمُحِيطُهُ اثْنَانِ وَعِشْرُونَ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {عَيِّنْ|عَيِّنِي} رُؤُوسَ مُسْتَطِيلٍ {وَصِلْهَا|وَصِلِيهَا} بِالتَّرْتِيبِ، {وَلَوِّنْهُ|وَلَوِّنِيهِ} بِالأَقْلَامِ المُلَوَّنَةِ، {وَاكْتُبْ|وَاكْتُبِي} أَزْوَاجَ رُؤُوسِهِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: الرَّسْمُ بِالإِحْدَاثِيَّاتِ! {صِلِ|صِلِي} الرُّؤُوسَ بِالتَّرْتِيبِ فَتَظْهَرُ الصُّورَةُ.",
  "gm.draw": "{اِلْمِسِ|اِلْمِسِي} الرُّؤُوسَ المَكْتُوبَةَ بِالتَّرْتِيبِ، ثُمَّ «تَمَّ».",
  "pj.01": "مَشْرُوعُ خَرِيطَةِ مَدِينَتِي: المَدْرَسَةُ مُسْتَطِيلٌ، وَالحَدِيقَةُ مُثَلَّثٌ، كُلُّ مُرَبَّعٍ مِنَ الشَّبَكَةِ وَحْدَةٌ.",
  "pj.02": "نَحْسُبُ مِسَاحَةَ كُلِّ مَبْنًى وَمُحِيطَهُ، وَنَجِدُ رُؤُوسَ المَخْبَزِ، ثُمَّ نَكْتُبُ جَدْوَلًا.",
  "pj.03": "هَذَا جَدْوَلُ المَدِينَةِ: لِكُلِّ مَبْنًى رُؤُوسُهُ، وَأَطْوَالُهُ، وَمُحِيطُهُ، وَمِسَاحَتُهُ بِوَحْدَتِهَا.",
  "prj.intro": "نَرْسُمُ خَرِيطَةَ المَدِينَةِ.",
