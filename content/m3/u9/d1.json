 "labels": {
  "bagCubes": "مُكَعَّبَاتٌ صَغِيرَةٌ",
  "bagBox": "عُلْبَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مُكَعَّبَاتٌ صَغِيرَةٌ وَعُلْبَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "هَذِهِ العُلْبَةُ تَسَعُ خَمْسِينَ قِطْعَةً صَغِيرَةً!"
  ],
  "hk.02": "لَا نَحْكُمُ بِالنَّظَرِ: نَمْلَؤُهَا مُكَعَّبَاتٍ طَبَقَةً بَعْدَ طَبَقَةٍ.",
  "fl.01": "الطَّبَقَةُ الأُولَى سِتَّةُ مُكَعَّبَاتٍ: ثَلَاثَةٌ فِي اثْنَيْنِ.",
  "fl.02": "وَالطَّبَقَاتُ أَرْبَعٌ، كُلٌّ سِتَّةٌ: أَرْبَعَةٌ وَعِشْرُونَ مُكَعَّبًا بِلَا فَرَاغٍ. هَذَا حَجْمُ الصُّنْدُوقِ.",
  "va.01": "المِسَاحَةُ تَعُدُّ المُرَبَّعَاتِ عَلَى سَطْحٍ: هُنَا سِتَّةُ مُرَبَّعَاتٍ.",
  "va.02": "وَالحَجْمُ يَعُدُّ المُكَعَّبَاتِ دَاخِلَ مُجَسَّمٍ: هُنَا اثْنَا عَشَرَ مُكَعَّبًا. المُكَعَّبَاتُ تَمْلَأُ، وَالمُرَبَّعَاتُ تُغَطِّي.",
  "tm.01": "مُكَعَّبَاتُ الطَّبَقَةِ الطُّولُ فِي العَرْضِ، وَالطَّبَقَاتُ بِعَدَدِ الارْتِفَاعِ: فَالحَجْمُ الطُّولُ فِي العَرْضِ فِي الارْتِفَاعِ.",
  "mat.01": "{اِمْلَأِ|اِمْلَئِي} العُلْبَةَ بِالمُكَعَّبَاتِ الصَّغِيرَةِ طَبَقَةً بَعْدَ طَبَقَةٍ بِلَا فَرَاغٍ، {وَعُدَّ|وَعُدِّي} مُكَعَّبَاتِ الطَّبَقَةِ وَالطَّبَقَاتِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: {اِمْلَأِ|اِمْلَئِي} الصُّنْدُوقَ! {أَضِفِ|أَضِيفِي} الطَّبَقَاتِ حَتَّى يَمْتَلِئَ، ثُمَّ «تَمَّ».",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: المِسَاحَةُ وَالحَجْمُ مُتَسَاوِيَانِ، فَالأَعْدَادُ نَفْسُهَا. مَا خَطَؤُهَا؟",
  "pr.r1a": "المِسَاحَةُ تَعُدُّ مُرَبَّعَاتٍ، وَالحَجْمُ يَعُدُّ مُكَعَّبَاتٍ.",
  "pr.r1b": "لَا خَطَأَ: كُلُّ عُلْبَةٍ حَجْمُهَا مِثْلُ مِسَاحَتِهَا.",
  "pr.r1c": "الحَجْمُ أَصْغَرُ مِنَ المِسَاحَةِ، فَالأَعْدَادُ لَا تَتَسَاوَى.",
  "ch.find": "قَالَتْ فَوْضَى: الصُّنْدُوقُ يَسَعُ الطَّبَقَةَ الأُولَى فَقَطْ. كَمْ مُكَعَّبًا يَسَعُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! نَسِيتُ الطَّبَقَاتِ فَوْقَهَا."
  ],
  "ch.right": "الطَّبَقَةُ فِي عَدَدِ الطَّبَقَاتِ.",
  "ch.wrong": [
   "chaos",
   "طَبَقَةٌ وَاحِدَةٌ تَكْفِي."
  ],
  "ms.1": "لِمَاذَا نَضْرِبُ مُكَعَّبَاتِ الطَّبَقَةِ فِي عَدَدِ الطَّبَقَاتِ؟",
  "ms.1a": "لِأَنَّ الطَّبَقَاتِ كُلَّهَا مُتَسَاوِيَةٌ فِي عَدَدِ مُكَعَّبَاتِهَا.",
  "ms.1b": "لِأَنَّ الطَّبَقَةَ الأُولَى أَكْبَرُ مِنَ الطَّبَقَاتِ فَوْقَهَا.",
  "ms.1c": "لِأَنَّنَا نَعُدُّ الأَوْجُهَ الظَّاهِرَةَ مِنْ خَارِجِ الصُّنْدُوقِ.",
  "ms.recall": "نَتَذَكَّرُ: نَعُدُّ مُكَعَّبَاتِ طَبَقَةٍ، ثُمَّ نَضْرِبُ فِي عَدَدِ الطَّبَقَاتِ، فَلَا نَعُدُّ الظَّاهِرَ وَحْدَهُ.",
  "ms.x1": "صُنْدُوقٌ فِي طَبَقَتِهِ السُّفْلَى عَشَرَةُ مُكَعَّبَاتٍ، وَفِيهِ ثَلَاثُ طَبَقَاتٍ. كَمْ مُكَعَّبًا يَسَعُ؟",
  "ms.x1a": "ثَلَاثِينَ: عَشَرَةٌ فِي كُلِّ طَبَقَةٍ، وَالطَّبَقَاتُ ثَلَاثٌ.",
  "ms.x1b": "ثَلَاثَةَ عَشَرَ: نُضِيفُ عَدَدَ الطَّبَقَاتِ إِلَى العَشَرَةِ.",
  "ms.x1c": "عَشَرَةً: نَعُدُّ مَا يَظْهَرُ مِنْ فَوْقِ الصُّنْدُوقِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} عَدَّ الحَجْمِ!",
  "wrap.01": "المُكَعَّبَاتُ تَمْلَأُ، وَالمُرَبَّعَاتُ تُغَطِّي!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِمْلَأْ|اِمْلَئِي} عُلْبَةً بِمُكَعَّبَاتِ السُّكَّرِ أَوِ المُكَعَّبَاتِ الصَّغِيرَةِ مَعَ {أَهْلِكَ|أَهْلِكِ}، {وَعُدَّ|وَعُدِّي} طَبَقَاتِهَا."
  ]
 },
