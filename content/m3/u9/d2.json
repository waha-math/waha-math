  "ask": "bag.ask",
  "adult": "علبة ومسطرة.",
  "screenPath": "على الشاشة يحسب الطفل حجم علب ومكعبات بالضرب، ويختار وحدة الحجم."
 },
 "labels": {
  "bagBox": "عُلْبَةٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُلْبَةٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "حَجْمُ العُلْبَةِ مَجْمُوعُ أَطْوَالِهَا: اثْنَا عَشَرَ!"
  ],
  "hk.02": "نَمْلَؤُهَا مُكَعَّبَاتٍ: سِتُّونَ مُكَعَّبًا. المَجْمُوعُ لَا يَصْلُحُ، وَالضَّرْبُ يَصْلُحُ.",
  "ml.01": "خَمْسَةٌ فِي أَرْبَعَةٍ عِشْرُونَ مُكَعَّبًا فِي الطَّبَقَةِ، وَثَلَاثُ طَبَقَاتٍ: سِتُّونَ. الحَجْمُ الطُّولُ فِي العَرْضِ فِي الارْتِفَاعِ.",
  "ml.02": "وَالحَجْمُ بِوَحْدَةٍ مُكَعَّبَةٍ: السَّنْتِيمِتْرُ المُكَعَّبُ مُكَعَّبٌ حَرْفُهُ سَنْتِيمِتْرٌ، وَالمِتْرُ المُكَعَّبُ مُكَعَّبٌ حَرْفُهُ مِتْرٌ.",
  "ml.03": "وَإِذَا تَسَاوَتِ الأَبْعَادُ فَهُوَ مُكَعَّبٌ: ثَلَاثَةٌ فِي ثَلَاثَةٍ فِي ثَلَاثَةٍ، سَبْعَةٌ وَعِشْرُونَ سَنْتِيمِتْرًا مُكَعَّبًا.",
  "mat.01": "{قِسْ|قِيسِي} أَبْعَادَ العُلْبَةِ بِالمِسْطَرَةِ، {وَاضْرِبْهَا|وَاضْرِبِيهَا}، {وَاكْتُبِ|وَاكْتُبِي} الحَجْمَ بِالسَّنْتِيمِتْرِ المُكَعَّبِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: صُنْدُوقُ العَدِّ! {اُحْسُبْ|اُحْسُبِي} حَجْمَ الصُّنْدُوقِ قَبْلَ مَلْئِهِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَ طَالِبٌ: حَجْمُ عُلْبَةٍ أَبْعَادُهَا اثْنَانِ وَثَلَاثَةٌ وَأَرْبَعَةٌ تِسْعَةُ سَنْتِيمِتْرَاتٍ مُكَعَّبَةٍ. مَا خَطَؤُهُ؟",
  "pr.r1a": "جَمَعَ الأَبْعَادَ، وَالحَجْمُ ضَرْبُهَا: أَرْبَعَةٌ وَعِشْرُونَ.",
  "pr.r1b": "لَا خَطَأَ: الحَجْمُ مَجْمُوعُ الأَبْعَادِ الثَّلَاثَةِ.",
  "pr.r1c": "كَانَ عَلَيْهِ أَنْ يَضْرِبَ بُعْدَيْنِ اثْنَيْنِ فَقَطْ مِنْهَا.",
  "ms.1": "لِمَاذَا نَضْرِبُ الأَبْعَادَ الثَّلَاثَةَ؟",
  "ms.1a": "بُعْدَانِ لِلطَّبَقَةِ، وَالثَّالِثُ لِلطَّبَقَاتِ.",
  "ms.1b": "لِأَنَّ الضَّرْبَ أَسْرَعُ مِنَ الجَمْعِ.",
  "ms.1c": "لِأَنَّ لِلْعُلْبَةِ ثَلَاثَةَ أَوْجُهٍ تُرَى.",
  "ms.2": "لِمَاذَا نَكْتُبُ الحَجْمَ بِالسَّنْتِيمِتْرِ المُكَعَّبِ، لَا المُرَبَّعِ؟",
  "ms.2a": "لِأَنَّنَا نَعُدُّ مُكَعَّبَاتٍ تَمْلَأُ، لَا مُرَبَّعَاتٍ تُغَطِّي.",
  "ms.2b": "لِأَنَّ المُكَعَّبَ أَكْبَرُ مِنَ المُرَبَّعِ فِي كُلِّ شَيْءٍ.",
  "ms.2c": "لَا فَرْقَ: الحَجْمُ وَالمِسَاحَةُ بِالوَحْدَةِ نَفْسِهَا.",
  "ch.find": "قَالَتْ فَوْضَى: حَجْمُ العُلْبَةِ مَجْمُوعُ أَطْوَالِهَا. كَمْ حَجْمُهَا حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! نَضْرِبُ وَلَا نَجْمَعُ."
  ],
  "ch.right": "الطُّولُ فِي العَرْضِ فِي الارْتِفَاعِ.",
  "ch.wrong": [
   "chaos",
   "المَجْمُوعُ يَكْفِي."
  ],
  "ms.recall": "نَتَذَكَّرُ: الحَجْمُ الطُّولُ فِي العَرْضِ فِي الارْتِفَاعِ، وَبِالسَّنْتِيمِتْرِ المُكَعَّبِ.",
  "ms.recall2": "نَتَذَكَّرُ: نَعُدُّ مُكَعَّبَاتٍ، فَالوَحْدَةُ مُكَعَّبَةٌ: سَنْتِيمِتْرٌ مُكَعَّبٌ أَوْ مِتْرٌ مُكَعَّبٌ.",
  "ms.x1": "عُلْبَةٌ طُولُهَا خَمْسَةٌ، وَعَرْضُهَا اثْنَانِ، وَارْتِفَاعُهَا أَرْبَعَةٌ. لِمَاذَا حَجْمُهَا أَرْبَعُونَ؟",
  "ms.x1a": "فِي الطَّبَقَةِ عَشَرَةُ مُكَعَّبَاتٍ، وَالطَّبَقَاتُ أَرْبَعٌ.",
  "ms.x1b": "لِأَنَّنَا نَجْمَعُ الأَبْعَادَ، ثُمَّ نَضْرِبُ النَّاتِجَ فِي أَرْبَعَةٍ.",
  "ms.x1c": "لِأَنَّ لِلْعُلْبَةِ أَرْبَعِينَ وَجْهًا صَغِيرًا ظَاهِرًا.",
  "ms.x2": "نَمْلَأُ حَوْضًا بِالمَاءِ. بِأَيِّ وَحْدَةٍ نَقِيسُ مَا يَسَعُهُ؟",
  "ms.x2a": "بِالمِتْرِ المُكَعَّبِ: نَعُدُّ مُكَعَّبَاتٍ تَمْلَؤُهُ.",
  "ms.x2b": "بِالمِتْرِ المُرَبَّعِ: نُغَطِّي أَرْضِيَّتَهُ بِالبَلَاطِ.",
  "ms.x2c": "بِالمِتْرِ وَحْدَهُ: نَقِيسُ عُمْقَ المَاءِ فِيهِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} حَجْمَ المَنْشُورِ!",
  "wrap.01": "الطُّولُ فِي العَرْضِ فِي الارْتِفَاعِ، بِوَحْدَةٍ مُكَعَّبَةٍ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} صُنْدُوقَ حِذَاءٍ وَعُلْبَةَ مَنَادِيلَ، {وَاحْسُبْ|وَاحْسُبِي} حَجْمَيْهِمَا، ثُمَّ {اِمْلَأِ|اِمْلَئِي} الصَّغِيرَةَ أَرُزًّا بِالكُوبِ مَعَ {أَهْلِكَ|أَهْلِكِ} {وَعُدَّ|وَعُدِّي} الأَكْوَابَ."
  ]
