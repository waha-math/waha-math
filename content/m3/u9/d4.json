 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "tr.01": "مَشْرُوعُ صُنْدُوقِ الكَنْزِ: حَجْمُهُ مِئَةٌ وَعِشْرُونَ سَنْتِيمِتْرًا مُكَعَّبًا، وَأَبْعَادُهُ أَعْدَادٌ صَحِيحَةٌ حَتَّى عَشَرَةٍ.",
  "tr.02": "لَهُ أَبْعَادٌ مُمْكِنَةٌ كَثِيرَةٌ: خَمْسَةٌ فِي أَرْبَعَةٍ فِي سِتَّةٍ، وَعَشَرَةٌ فِي ثَلَاثَةٍ فِي أَرْبَعَةٍ، وَكُلُّهَا تُعْطِي مِئَةً وَعِشْرِينَ.",
  "tr.03": "وَنَحْسُبُ وَرَقَ أَحَدِهَا: مِسَاحَةُ سَطْحِ خَمْسَةٍ فِي سِتَّةٍ فِي أَرْبَعَةٍ مِئَةٌ وَثَمَانِيَةٌ وَأَرْبَعُونَ سَنْتِيمِتْرًا مُرَبَّعًا.",
  "tb.01": "جَدْوَلُ المَشْرُوعِ: الأَبْعَادُ، وَالحَجْمُ بِالسَّنْتِيمِتْرِ المُكَعَّبِ، وَالوَرَقُ بِالسَّنْتِيمِتْرِ المُرَبَّعِ.",
  "tb.02": "وَالآنَ {صَمِّمْ|صَمِّمِي} صُنْدُوقًا آخَرَ بِأَكْبَرِ حَجْمٍ {تَسْتَطِيعُهُ|تَسْتَطِيعِينَهُ} بِوَرَقٍ مَحْدُودٍ، {وَقَارِنِ|وَقَارِنِي} النَّتَائِجَ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ صُنْدُوقَ كَنْزٍ، {وَقِسْهُ|وَقِيسِيهِ} بِالمِسْطَرَةِ، {وَاكْتُبْ|وَاكْتُبِي} أَبْعَادَهُ، {وَتَحَقَّقْ|وَتَحَقَّقِي} مِنْ حَجْمِهِ بِالضَّرْبِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "prj.intro": "نَصْنَعُ صُنْدُوقَ الكَنْزِ: أَبْعَادُهُ وَوَرَقُهُ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: لِصُنْدُوقٍ حَجْمُهُ مِئَةٌ وَعِشْرُونَ أَبْعَادٌ وَاحِدَةٌ فَقَطْ. مَا خَطَؤُهَا؟",
  "pr.r1a": "لِلْحَجْمِ الوَاحِدِ أَبْعَادٌ كَثِيرَةٌ مُمْكِنَةٌ.",
  "pr.r1b": "لَا خَطَأَ: لِكُلِّ حَجْمٍ صُنْدُوقٌ وَاحِدٌ فَقَطْ دَائِمًا.",
  "pr.r1c": "الأَبْعَادُ يَجِبُ أَنْ تَكُونَ مُتَسَاوِيَةً فِي كُلِّ صُنْدُوقٍ.",
  "ch.find": "قَالَتْ فَوْضَى: أَبْعَادُ صُنْدُوقٍ حَجْمُهُ مِئَةٌ وَعِشْرُونَ مَجْمُوعُهَا مِئَةٌ وَعِشْرُونَ. أَيُّ الأَبْعَادِ صَحِيحَةٌ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! حَاصِلُ ضَرْبِهَا لَا مَجْمُوعُهَا."
  ],
  "ch.right": "حَاصِلُ ضَرْبِ الأَبْعَادِ هُوَ الحَجْمُ.",
  "ch.wrong": [
   "chaos",
   "مَجْمُوعُهَا يَكْفِي."
  ],
  "ms.1": "كَيْفَ نَتَحَقَّقُ أَنَّ أَبْعَادَ صُنْدُوقٍ تُعْطِي حَجْمًا مَطْلُوبًا؟",
  "ms.1a": "نَضْرِبُ الأَبْعَادَ الثَّلَاثَةَ وَنُقَارِنُ بِالحَجْمِ.",
  "ms.1b": "نَجْمَعُ الأَبْعَادَ الثَّلَاثَةَ وَنُقَارِنُ بِالحَجْمِ المَطْلُوبِ.",
  "ms.1c": "نَحْسُبُ مِسَاحَةَ وَجْهٍ وَاحِدٍ مِنْ أَوْجُهِهِ فَقَطْ.",
  "ms.recall": "نَتَذَكَّرُ: حَاصِلُ ضَرْبِ الأَبْعَادِ الثَّلَاثَةِ هُوَ الحَجْمُ، وَلِلْحَجْمِ الوَاحِدِ أَبْعَادٌ كَثِيرَةٌ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} تَصْمِيمَ الصُّنْدُوقِ!",
  "wrap.01": "حَجْمٌ وَاحِدٌ، وَصَنَادِيقُ كَثِيرَةٌ!",
  "wrap.home": [
