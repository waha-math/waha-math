 "labels": {
  "bagCubes": "مُكَعَّبَاتٌ صَغِيرَةٌ",
  "bagPaper": "وَرَقٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مُكَعَّبَاتٌ صَغِيرَةٌ وَوَرَقٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "العُلَبُ المُتَشَابِهَةُ لَهَا الحَجْمُ نَفْسُهُ وَالمِسَاحَةُ نَفْسُهَا!"
  ],
  "hk.02": "هَاتَانِ العُلْبَتَانِ حَجْمُ كُلٍّ مِنْهُمَا أَرْبَعَةٌ وَعِشْرُونَ سَنْتِيمِتْرًا مُكَعَّبًا.",
  "hk.03": "لَكِنَّ مِسَاحَةَ سَطْحِ الأُولَى اثْنَانِ وَخَمْسُونَ سَنْتِيمِتْرًا مُرَبَّعًا، وَالأُخْرَى المُسَطَّحَةِ ثَمَانِيَةٌ وَسِتُّونَ: مُخْتَلِفَتَانِ.",
  "sm.01": "الحَجْمُ وَالمِسَاحَةُ مُسْتَقِلَّانِ: الحَجْمُ نَفْسُهُ لَا يَعْنِي المِسَاحَةَ نَفْسَهَا، فَالصُّنْدُوقُ يَحْتَاجُ الحَجْمَ وَالوَرَقَ مَعًا.",
  "mat.01": "{اِبْنِ|اِبْنِي} بِالمُكَعَّبَاتِ الصَّغِيرَةِ عُلَبًا بِالعَدَدِ نَفْسِهِ مِنَ المُكَعَّبَاتِ، {وَغَطِّ|وَغَطِّي} كُلًّا مِنْهُمَا بِالوَرَقِ {وَقَارِنْ|وَقَارِنِي} بَيْنَهُمَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: عُلْبَةُ الهَدِيَّةِ الذَّكِيَّةُ! أَيُّ عُلْبَةٍ تَسَعُ المُكَعَّبَاتِ وَتُكَلِّفُ أَقَلَّ وَرَقٍ؟",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: عُلْبَتَانِ بِالحَجْمِ نَفْسِهِ لَهُمَا المِسَاحَةُ نَفْسُهَا. مَا خَطَؤُهَا؟",
  "pr.r1a": "قَدْ تَخْتَلِفُ مِسَاحَتَاهُمَا، كَعُلْبَتَيِ الأَرْبَعَةِ وَالعِشْرِينَ.",
  "pr.r1b": "لَا خَطَأَ: الحَجْمُ نَفْسُهُ يَعْنِي المِسَاحَةَ نَفْسَهَا.",
  "pr.r1c": "العُلْبَتَانِ بِالحَجْمِ نَفْسِهِ لَهُمَا الأَبْعَادُ نَفْسُهَا.",
  "pr.two": "{أَقْنِعْنِي|أَقْنِعِينِي} بِسَبَبَيْنِ: عُلْبَتَانِ بِالحَجْمِ نَفْسِهِ قَدْ تَخْتَلِفُ مِسَاحَتَا سَطْحَيْهِمَا. {اِلْمِسِ|اِلْمِسِي} البِطَاقَتَيْنِ الصَّحِيحَتَيْنِ، ثُمَّ «تَمَّ».",
  "pr.twoa": "عُلْبَةُ أَرْبَعَةٍ فِي ثَلَاثَةٍ فِي اثْنَيْنِ، وَعُلْبَةُ سِتَّةٍ فِي أَرْبَعَةٍ فِي وَاحِدٍ: الحَجْمُ أَرْبَعَةٌ وَعِشْرُونَ، وَالمِسَاحَتَانِ اثْنَانِ وَخَمْسُونَ وَثَمَانِيَةٌ وَسِتُّونَ.",
  "pr.twob": "الحَجْمُ يَعُدُّ المُكَعَّبَاتِ فِي الدَّاخِلِ، وَالمِسَاحَةُ تَعُدُّ مُرَبَّعَاتِ الأَوْجُهِ، وَالعُلْبَةُ المُسَطَّحَةُ تَكْشِفُ أَوْجُهًا أَكْبَرَ.",
  "pr.twoc": "لِأَنَّ الوَرَقَ يُقَاسُ بِالسَّنْتِيمِتْرِ، وَالمُكَعَّبَاتِ بِالسَّنْتِيمِتْرِ المُكَعَّبِ.",
  "pr.twoHint": "البِطَاقَةُ المُقْنِعَةُ مِثَالٌ بِأَعْدَادٍ، أَوْ تَشْرَحُ مَا يَعُدُّهُ الحَجْمُ وَمَا تَعُدُّهُ المِسَاحَةُ.",
  "ch.find": "قَالَتْ فَوْضَى: هَذِهِ العُلَبُ حَجْمُهَا وَاحِدٌ، فَوَرَقُهَا وَاحِدٌ. أَيُّهَا تَحْتَاجُ أَقَلَّ وَرَقٍ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! الوَرَقُ مُخْتَلِفٌ."
  ],
  "ch.right": "الحَجْمُ وَاحِدٌ، وَالوَرَقُ مُخْتَلِفٌ.",
  "ch.wrong": [
   "chaos",
   "الحَجْمُ نَفْسُهُ، فَالوَرَقُ نَفْسُهُ."
  ],
  "ms.1": "عُلْبَتَانِ بِالحَجْمِ نَفْسِهِ. أَيُّهُمَا تَحْتَاجُ وَرَقًا أَكْثَرَ غَالِبًا؟",
  "ms.1a": "المُسَطَّحَةُ: أَوْجُهُهَا الكَبِيرَةُ مَكْشُوفَةٌ.",
  "ms.1b": "لَا فَرْقَ: الوَرَقُ عَلَى قَدْرِ الحَجْمِ.",
  "ms.1c": "الَّتِي تُشْبِهُ المُكَعَّبَ: أَوْجُهُهَا مُتَسَاوِيَةٌ.",
  "ms.recall": "نَتَذَكَّرُ: الحَجْمُ يَعُدُّ مَا فِي الدَّاخِلِ، وَمِسَاحَةُ السَّطْحِ تَعُدُّ الأَوْجُهَ؛ وَقَدْ يَتَسَاوَى الأَوَّلُ وَيَخْتَلِفُ الثَّانِي.",
  "ms.x1": "عُلْبَتَانِ فِي كُلٍّ مِنْهُمَا أَرْبَعَةٌ وَعِشْرُونَ مُكَعَّبًا. هَلْ تَحْتَاجَانِ الوَرَقَ نَفْسَهُ؟",
  "ms.x1a": "لَيْسَ دَائِمًا: الوَرَقُ لِلْأَوْجُهِ، لَا لِلدَّاخِلِ.",
  "ms.x1b": "نَعَمْ: الحَجْمُ نَفْسُهُ يَعْنِي الوَرَقَ نَفْسَهُ.",
  "ms.x1c": "لَا: الطَّوِيلَةُ النَّحِيفَةُ تَحْتَاجُ وَرَقًا أَقَلَّ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} الفَرْقَ بَيْنَ الحَجْمِ وَالمِسَاحَةِ!",
  "wrap.01": "الحَجْمُ نَفْسُهُ، وَالوَرَقُ مُخْتَلِفٌ!",
