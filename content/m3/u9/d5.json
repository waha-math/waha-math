 "labels": {
  "bagCubes": "مُكَعَّبَاتٌ صَغِيرَةٌ",
  "bagBox": "عُلْبَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مُكَعَّبَاتٌ صَغِيرَةٌ وَعُلْبَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي مَصَانِعِ الصَّنَادِيقِ أَخْطَاءُ فَوْضَى: حَجْمٌ بِالجَمْعِ، وَحَجْمٌ يُسَاوِي المِسَاحَةَ، وَعُلْبَتَانِ بِحَجْمٍ وَاحِدٍ لَهُمَا وَرَقٌ وَاحِدٌ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {بَطَلِ|بَطَلَةِ} الحُجُومِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ العَاشِرِ.",
  "mat.01": "{اِمْلَأِ|اِمْلَئِي} العُلْبَةَ بِالمُكَعَّبَاتِ الصَّغِيرَةِ، {وَعُدَّ|وَعُدِّي} طَبَقَاتِهَا، {وَقُلْ|وَقُولِي} مَا الفَرْقُ بَيْنَ مَا يَمْلَؤُهَا وَمَا يُغَطِّيهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: الحَجْمُ مُكَعَّبَاتٌ تَمْلَأُ، الطُّولُ فِي العَرْضِ فِي الارْتِفَاعِ، بِالسَّنْتِيمِتْرِ المُكَعَّبِ.",
  "rv.02": "وَالحَجْمُ نَفْسُهُ قَدْ يَأْتِي بِوَرَقٍ مُخْتَلِفٍ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى الحُجُومِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.sum": "جَمَعَتْ فَوْضَى الأَبْعَادَ. {صَحِّحْ|صَحِّحِي}: كَمْ حَجْمُ العُلْبَةِ؟",
  "gm.area": "قَالَتْ فَوْضَى: الحَجْمُ عَدَدُ مُكَعَّبَاتِ الطَّبَقَةِ الأُولَى. كَمْ مُكَعَّبًا فِيهِ حَقًّا؟",
  "gm.same": "قَالَتْ فَوْضَى: الحَجْمُ وَاحِدٌ، فَالوَرَقُ وَاحِدٌ. أَيُّ عُلْبَةٍ تَحْتَاجُ أَقَلَّ وَرَقٍ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.12": "قَالَ طَالِبٌ: حَجْمُ مُكَعَّبٍ حَرْفُهُ أَرْبَعَةٌ سِتَّةَ عَشَرَ. مَا خَطَؤُهُ؟",
  "ts.12a": "ضَرَبَ بُعْدَيْنِ فَقَطْ: الحَجْمُ أَرْبَعَةٌ وَسِتُّونَ.",
  "ts.12b": "لَا خَطَأَ: حَجْمُ المُكَعَّبِ وَجْهٌ وَاحِدٌ.",
  "ts.12c": "كَانَ عَلَيْهِ أَنْ يَجْمَعَ الأَبْعَادَ.",
  "ts.13": "لِمَاذَا لَا تَكْفِي المِسَاحَةُ لِمَعْرِفَةِ الحَجْمِ؟",
  "ts.13a": "عُلْبَتَانِ بِالمِسَاحَةِ نَفْسِهَا قَدْ يَخْتَلِفُ حَجْمَاهُمَا.",
  "ts.13b": "لِأَنَّ أَعْدَادَ المِسَاحَةِ أَصْغَرُ مِنْ أَعْدَادِ الحَجْمِ.",
  "ts.13c": "لِأَنَّ الحَجْمَ لَا يُقَاسُ إِلَّا بِالمَاءِ فِي كُوبٍ.",
  "ts.rem": "نَعُودُ إِلَى مَلْءِ العُلَبِ بِالمُكَعَّبَاتِ وَعَدِّ الطَّبَقَاتِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ العَاشِرِ."
  ],
  "ts.win1": "{أَنْتَ بَطَلُ|أَنْتِ بَطَلَةُ} الحُجُومِ!",
  "ts.win2": "{مَلَأْتَ|مَلَأْتِ} {وَعَدَدْتَ|وَعَدَدْتِ} {وَضَرَبْتَ|وَضَرَبْتِ}، {وَمَيَّزْتَ|وَمَيَّزْتِ} الحَجْمَ مِنَ المِسَاحَةِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {بَطَلِ|بَطَلَةِ} الحُجُومِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قَدِّرْ|قَدِّرِي} حَجْمَ عُلْبَةِ شَايٍ بِالنَّظَرِ، ثُمَّ {قِسْ|قِيسِي} أَبْعَادَهَا {وَاحْسُبْ|وَاحْسُبِي}، {وَقَارِنْ|وَقَارِنِي} مَعَ {أَهْلِكَ|أَهْلِكِ}."
  ]
 },
