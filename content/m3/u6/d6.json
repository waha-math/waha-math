  "ask": "bag.ask",
  "adult": "ورق شفّاف ومرآة صغيرة آمنة.",
  "screenPath": "أسئلة الوحدة على الشاشة: الانعكاس والانسحاب والدوران والتماثل الدوراني والتطابق."
 },
 "labels": {
  "bagTrace": "وَرَقٌ شَفَّافٌ",
  "bagMirror": "مِرْآةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقٌ شَفَّافٌ وَمِرْآةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المِرْآةِ الكُبْرَى أَخْطَاءُ فَوْضَى: نُسْخَةٌ بِالاتِّجَاهِ نَفْسِهِ، وَانْسِحَابٌ بِدَوَرَانٍ، وَمَرْكَزٌ يَتَحَرَّكُ، وَمُثَلَّثَانِ بِالزَّوَايَا نَفْسِهَا تَقُولُ إِنَّهُمَا مُتَطَابِقَانِ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {سَيِّدِ|سَيِّدَةِ} التَّحْوِيلَاتِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ السَّابِعِ.",
  "mat.01": "{ضَعْ|ضَعِي} شَكْلًا عَلَى الوَرَقِ الشَّفَّافِ أَمَامَ المِرْآةِ، {وَحَرِّكْهُ|وَحَرِّكِيهِ} بِالانْسِحَابِ ثُمَّ بِالدَّوَرَانِ ثُمَّ بِالقَلْبِ، {وَقُلْ|وَقُولِي} مَا يَبْقَى وَمَا يَتَغَيَّرُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: الانْعِكَاسُ يَقْلِبُ بِالبُعْدِ نَفْسِهِ، وَالانْسِحَابُ يَنْقُلُ بِلَا إِدَارَةٍ، وَالدَّوَرَانُ حَوْلَ مَرْكَزٍ ثَابِتٍ.",
  "rv.02": "وَأَصْغَرُ زَاوِيَةٍ لِلتَّمَاثُلِ الدَّوَرَانِيِّ الدَّوْرَةُ عَلَى عَدَدِ الانْطِبَاقَاتِ، وَالمُتَطَابِقَانِ يَنْطَبِقَانِ بِحَرَكَةٍ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى التَّحْوِيلَاتِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.copy": "نَسَخَتْ فَوْضَى الشَّكْلَ بِالاتِّجَاهِ نَفْسِهِ. {عَيِّنْ|عَيِّنِي} صُورَتَهُ بِالانْعِكَاسِ حَقًّا، ثُمَّ «تَمَّ».",
  "gm.turn": "أَدَارَتْ فَوْضَى الشَّكْلَ وَهِيَ تَسْحَبُهُ. {عَيِّنْ|عَيِّنِي} صُورَتَهُ بِالانْسِحَابِ حَقًّا، ثُمَّ «تَمَّ»:",
  "gm.center": "حَرَّكَتْ فَوْضَى المَرْكَزَ مَعَ الشَّكْلِ. {عَيِّنِ|عَيِّنِي} الصُّورَةَ حَوْلَ المَرْكَزِ الثَّابِتِ، ثُمَّ «تَمَّ».",
  "gm.angles": "قَالَتْ فَوْضَى: الزَّوَايَا نَفْسُهَا، فَهُمَا مُتَطَابِقَانِ. مَا {رَأْيُكَ|رَأْيُكِ}؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.2": "لِمَاذَا نَقُولُ إِنَّ الصُّورَةَ بِالانْعِكَاسِ عَلَى البُعْدِ نَفْسِهِ؟",
  "ts.2a": "الخَطُّ يُنَصِّفُ الوَاصِلَ بَيْنَ النُّقْطَةِ وَصُورَتِهَا.",
  "ts.2b": "لِأَنَّ الصُّورَةَ أَكْبَرُ مِنَ الأَصْلِ بِقَلِيلٍ دَائِمًا.",
  "ts.2c": "لِأَنَّ الصُّورَةَ عَلَى الخَطِّ نَفْسِهِ فِي كُلِّ مَرَّةٍ.",
  "ts.13": "قَالَتْ فَوْضَى: نِصْفُ الدَّوْرَةِ هُوَ الانْعِكَاسُ. مَا خَطَؤُهَا؟",
  "ts.13a": "نَقْلِبُ فِي الانْعِكَاسِ، وَنُدِيرُ فِي الدَّوَرَانِ.",
  "ts.13b": "لَا خَطَأَ: الصُّورَتَانِ وَاحِدَةٌ فِي كُلِّ شَكْلٍ.",
  "ts.13c": "نِصْفُ الدَّوْرَةِ يُغَيِّرُ الأَطْوَالَ.",
  "ts.14": "هَلْ لِمُتَوَازِي الأَضْلَاعِ تَمَاثُلٌ؟",
  "ts.14a": "نَعَمْ، دَوَرَانِيٌّ بِنِصْفِ دَوْرَةٍ، وَلَا مِحْوَرَ لَهُ.",
  "ts.14b": "نَعَمْ، لَهُ مِحْوَرَانِ يَمُرَّانِ بِرُؤُوسِهِ المُتَقَابِلَةِ.",
  "ts.14c": "لَا تَمَاثُلَ لَهُ، فَلَا يَنْطَبِقُ عَلَى نَفْسِهِ أَبَدًا.",
  "ts.rem": "نَعُودُ إِلَى الوَرَقِ الشَّفَّافِ وَالدَّبُّوسِ مَعَ الكِبَارِ: نَقْلِبُ وَنَسْحَبُ وَنُدِيرُ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ السَّابِعِ."
  ],
  "ts.win1": "{أَنْتَ سَيِّدُ|أَنْتِ سَيِّدَةُ} التَّحْوِيلَاتِ!",
  "ts.win2": "{عَكَسْتَ|عَكَسْتِ} {وَسَحَبْتَ|وَسَحَبْتِ} {وَأَدَرْتَ|وَأَدَرْتِ}، {وَعَدَدْتَ|وَعَدَدْتِ} الانْطِبَاقَاتِ، {وَحَكَمْتَ|وَحَكَمْتِ} بِالتَّطَابُقِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {سَيِّدِ|سَيِّدَةِ} التَّحْوِيلَاتِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: أَمَامَ المِرْآةِ {ضَعْ|ضَعِي} وَرَقَةً عَلَيْهَا {اسْمُكَ|اسْمُكِ}، {وَقُلْ|وَقُولِي} لِـ{أَهْلِكَ|أَهْلِكِ}: مَا الَّذِي بَقِيَ؟ وَمَا الَّذِي انْقَلَبَ؟"
  ]
 },
