 ],
 "concepts": {
  "C338": "الدوران حول نقطة: المركز ثابت، والمقدار ربع ونصف وثلاثة أرباع دورة، والاتجاه مع عقارب الساعة أو عكسها، والبعد عن المركز ثابت، ونصف الدورة مركزها منتصف الواصل وهي غير الانعكاس"
 },
 "bag": {
