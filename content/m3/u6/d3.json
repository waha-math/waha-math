  "ask": "bag.ask",
  "adult": "ورق شفّاف ومثلّث رسم، ودبّوس تثبيت بإشرافكم.",
  "screenPath": "على الشاشة يعيّن الطفل صورة النقطة والمثلث بالدوران حول مركز، ويجد مركز نصف الدورة."
 },
 "labels": {
  "bagTrace": "وَرَقٌ شَفَّافٌ",
  "bagSet": "مُثَلَّثُ الرَّسْمِ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقٌ شَفَّافٌ وَدَبُّوسٌ مَعَ الكِبَارِ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "أَدَرْتُ الشَّكْلَ نِصْفَ دَوْرَةٍ!"
  ],
  "hk.02": "نَضَعُ رُكْنَ الوَرَقَةِ عِنْدَ المَرْكَزِ: الزَّاوِيَةُ قَائِمَةٌ، فَهَذَا رُبْعُ دَوْرَةٍ، لَا نِصْفُهَا.",
  "ro.01": "المَرْكَزُ مِيم ثَابِتٌ لَا يَتَحَرَّكُ. رُبْعُ دَوْرَةٍ عَكْسَ عَقَارِبِ السَّاعَةِ: أَلِف شَرْطَة خَمْسَةٌ وَسَبْعَةٌ، وَبُعْدُهَا عَنِ المَرْكَزِ كَبُعْدِ أَلِف.",
  "ro.02": "نِصْفُ دَوْرَةٍ: أَلِف شَرْطَة اثْنَانِ وَأَرْبَعَةٌ، وَبَاء شَرْطَة اثْنَانِ وَاثْنَانِ.",
  "ro.03": "ثَلَاثَةُ أَرْبَاعِ دَوْرَةٍ عَكْسَ عَقَارِبِ السَّاعَةِ: الشَّكْلُ يَدُورُ إِلَى الأَسْفَلِ. وَتَبْقَى الأَطْوَالُ وَالزَّوَايَا.",
  "ro.04": "فِي نِصْفِ الدَّوْرَةِ المَرْكَزُ مُنْتَصَفُ الوَاصِلِ بَيْنَ النُّقْطَةِ وَصُورَتِهَا. وَهِيَ غَيْرُ الانْعِكَاسِ: نُدِيرُ الوَرَقَ الشَّفَّافَ وَلَا نَقْلِبُهُ.",
  "mat.01": "{ثَبِّتِ|ثَبِّتِي} الوَرَقَ الشَّفَّافَ بِالدَّبُّوسِ عِنْدَ نُقْطَةٍ مَعَ الكِبَارِ، {وَأَدِرْهُ|وَأَدِيرِيهِ} رُبْعَ دَوْرَةٍ ثُمَّ نِصْفَ دَوْرَةٍ، {وَرَاقِبِ|وَرَاقِبِي} النُّقْطَةَ الثَّابِتَةَ، {وَتَحَقَّقْ|وَتَحَقَّقِي} مِنَ الرُّبْعِ بِمُثَلَّثِ الرَّسْمِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: عَجَلَةُ الدَّوَرَانِ! {أَدِرِ|أَدِيرِي} الشَّكْلَ حَوْلَ المَرْكَزِ إِلَى صُورَتِهِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.center": "بَاء صُورَةُ أَلِف بِنِصْفِ دَوْرَةٍ. {عَيِّنْ|عَيِّنِي} مَرْكَزَ الدَّوَرَانِ، ثُمَّ «تَمَّ».",
  "pr.r1": "قَالَتْ فَوْضَى: المَرْكَزُ يَتَحَرَّكُ مَعَ الشَّكْلِ. مَا الصَّحِيحُ؟",
  "pr.r1a": "المَرْكَزُ ثَابِتٌ لَا يَتَحَرَّكُ.",
  "pr.r1b": "المَرْكَزُ يَتَحَرَّكُ رُبْعَ دَوْرَةٍ مَعَ الشَّكْلِ كُلَّهُ.",
  "pr.r1c": "لَا مَرْكَزَ لِلدَّوَرَانِ، فَالشَّكْلُ يَدُورُ حَوْلَ نَفْسِهِ.",
  "pr.r2": "قَالَتْ فَوْضَى: رُبْعُ الدَّوْرَةِ مِئَةٌ وَثَمَانُونَ دَرَجَةً. مَا الصَّحِيحُ؟",
  "pr.r2a": "رُبْعُ الدَّوْرَةِ زَاوِيَةٌ قَائِمَةٌ: تِسْعُونَ دَرَجَةً.",
  "pr.r2b": "صَدَقَتْ: الرُّبْعُ وَالنِّصْفُ زَاوِيَةٌ مُسْتَقِيمَةٌ وَاحِدَةٌ.",
  "pr.r2c": "رُبْعُ الدَّوْرَةِ ثَلَاثُمِئَةٍ وَسِتُّونَ دَرَجَةً كَامِلَةً.",
  "ch.find": "أَدَارَتْ فَوْضَى رُبْعَ دَوْرَةٍ وَقَالَتْ نِصْفَ دَوْرَةٍ. {عَيِّنِ|عَيِّنِي} الصُّورَةَ بِنِصْفِ دَوْرَةٍ حَقًّا، ثُمَّ «تَمَّ».",
  "ch.after": [
   "chaos",
   "آه! نِصْفُ الدَّوْرَةِ زَاوِيَةٌ مُسْتَقِيمَةٌ."
  ],
  "ch.right": "نِصْفُ دَوْرَةٍ حَوْلَ المَرْكَزِ الثَّابِتِ.",
  "ch.wrong": [
   "chaos",
   "رُبْعُ دَوْرَةٍ يَكْفِي."
  ],
  "ms.1": "مَاذَا يَبْقَى فِي الدَّوَرَانِ؟",
  "ms.1a": "المَرْكَزُ وَالأَطْوَالُ وَالزَّوَايَا، وَيَدُورُ الشَّكْلُ.",
  "ms.1b": "المَوْضِعُ وَحْدَهُ، وَتَتَغَيَّرُ الأَطْوَالُ.",
  "ms.1c": "الاتِّجَاهُ وَحْدَهُ، وَيَتَحَرَّكُ المَرْكَزُ مَعَهُ.",
  "ms.recall": "نَتَذَكَّرُ: المَرْكَزُ ثَابِتٌ، وَبُعْدُ النُّقْطَةِ عَنْهُ لَا يَتَغَيَّرُ، وَالزَّاوِيَةُ عِنْدَهُ مِقْدَارُ الدَّوَرَانِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} الدَّوَرَانَ!",
  "wrap.01": "مَرْكَزٌ ثَابِتٌ، وَمِقْدَارٌ، وَاتِّجَاهٌ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَدِرْ|أَدِيرِي} غِطَاءَ عُلْبَةٍ رُبْعَ دَوْرَةٍ ثُمَّ نِصْفَ دَوْرَةٍ، {وَاسْأَلْ|وَاسْأَلِي} {أَهْلَكَ|أَهْلَكِ}: أَيْنَ المَرْكَزُ الثَّابِتُ؟"
  ]
