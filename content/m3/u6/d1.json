{
 "id": "m3.u6.d1",
 "title": "الانْعِكَاسُ تَحْوِيلًا",
 "icon": [
  "xficon"
 ],
 "concepts": {
  "C312": "الانعكاس تحويلاً: الصورة أ' على الجهة الأخرى بالبعد نفسه والواصل عمودي، على الشبكة بخط موازٍ لأحد المحورين، وتبقى الأطوال والزوايا وينقلب الاتجاه"
 },
 "bag": {
  "items": [
   {
    "icon": "tracing",
    "label": "bagTrace"
   },
   {
    "icon": "mirror",
    "label": "bagMirror"
   }
  ],
  "ask": "bag.ask",
  "adult": "ورق شفّاف ومرآة صغيرة آمنة.",
  "screenPath": "على الشاشة يعيّن الطفل صورة النقطة والمثلث بالانعكاس في خط رأسي أو أفقي، ويجد الخط."
 },
 "labels": {
  "bagTrace": "وَرَقٌ شَفَّافٌ",
  "bagMirror": "مِرْآةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقٌ شَفَّافٌ وَمِرْآةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "نَسَخْتُ المُثَلَّثَ: هَذِهِ صُورَتُهُ فِي المِرْآةِ!"
  ],
  "hk.02": "نَقْلِبُ الوَرَقَ الشَّفَّافَ عَلَى الخَطِّ: الصُّورَةُ مَقْلُوبَةٌ، لَا نُسْخَةٌ بِالاتِّجَاهِ نَفْسِهِ.",
  "rf.01": "التَّحْوِيلُ الهَنْدَسِيُّ قَاعِدَةٌ تَنْقُلُ كُلَّ نُقْطَةٍ إِلَى صُورَتِهَا، وَنَكْتُبُ أَلِف شَرْطَة لِصُورَةِ أَلِف. فِي الانْعِكَاسِ نَعُدُّ بُعْدَ الرَّأْسِ عَنِ الخَطِّ: جِيم تَبْعُدُ ثَلَاثَةً.",
  "rf.02": "فَصُورَتُهَا فِي الجِهَةِ الأُخْرَى بِالبُعْدِ نَفْسِهِ: ثَلَاثَةٌ، وَالوَاصِلُ بَيْنَهُمَا عَمُودِيٌّ عَلَى الخَطِّ.",
  "rf.03": "وَمَعَ الخَطِّ الأُفُقِيِّ نَعُدُّ البُعْدَ لِأَعْلَى وَلِأَسْفَلَ بِالطَّرِيقَةِ نَفْسِهَا.",
  "rf.04": "بَقِيَتِ الأَطْوَالُ وَالزَّوَايَا، وَانْقَلَبَ الاتِّجَاهُ: اليَمِينُ صَارَ يَسَارًا. وَإِنِ انْطَبَقَ الشَّكْلُ عَلَى صُورَتِهِ فَالخَطُّ مِحْوَرُ تَمَاثُلٍ.",
  "mat.01": "{ضَعِ|ضَعِي} المِرْآةَ عَلَى خَطٍّ مَرْسُومٍ، {وَاشِفَّ|وَاشِفِّي} شَكْلًا عَلَى الوَرَقِ الشَّفَّافِ، ثُمَّ {اِقْلِبْهُ|اِقْلِبِيهِ} عَلَى الخَطِّ {وَقَارِنْ|وَقَارِنِي} بِمَا فِي المِرْآةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مِرْآةُ السِّحْرِ! {عَيِّنِ|عَيِّنِي} الصُّورَةَ عَلَى الجِهَةِ الأُخْرَى مِنَ الخَطِّ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: صُورَةُ الشَّكْلِ بِالانْعِكَاسِ نُسْخَةٌ بِالاتِّجَاهِ نَفْسِهِ. مَا خَطَؤُهَا؟",
  "pr.r1a": "الصُّورَةُ مَقْلُوبَةٌ: اليَمِينُ يَصِيرُ يَسَارًا.",
  "pr.r1b": "لَا خَطَأَ: الانْعِكَاسُ يَنْسَخُ الشَّكْلَ كَمَا هُوَ دَائِمًا.",
  "pr.r1c": "الصُّورَةُ أَصْغَرُ مِنَ الأَصْلِ، فَلَيْسَتْ نُسْخَةً.",
  "pr.r2": "قَالَ طَالِبٌ: بُعْدُ الصُّورَةِ عَنِ الخَطِّ غَيْرُ بُعْدِ الأَصْلِ. مَا الصَّحِيحُ؟",
  "pr.r2a": "البُعْدَانِ مُتَسَاوِيَانِ.",
  "pr.r2b": "الصُّورَةُ أَبْعَدُ عَنِ الخَطِّ دَائِمًا بِوَحْدَةٍ.",
  "pr.r2c": "الصُّورَةُ عَلَى الخَطِّ نَفْسِهِ دَائِمًا، فَلَا بُعْدَ لَهَا.",
  "pr.on": "هَذِهِ النُّقْطَةُ عَلَى خَطِّ الانْعِكَاسِ نَفْسِهِ. {عَيِّنْ|عَيِّنِي} صُورَتَهَا، ثُمَّ «تَمَّ».",
  "ch.find": "نَسَخَتْ فَوْضَى الشَّكْلَ بِالاتِّجَاهِ نَفْسِهِ. {عَيِّنْ|عَيِّنِي} صُورَتَهُ فِي الخَطِّ الرَّأْسِيِّ حَقًّا، ثُمَّ «تَمَّ».",
  "ch.after": [
   "chaos",
   "آه! الصُّورَةُ مَقْلُوبَةٌ، بِالبُعْدِ نَفْسِهِ."
  ],
  "ch.right": "البُعْدُ نَفْسُهُ فِي الجِهَةِ الأُخْرَى.",
  "ch.wrong": [
   "chaos",
   "نُسْخَةٌ كَمَا هِيَ."
  ],
  "ms.1": "مَاذَا يَبْقَى وَمَاذَا يَتَغَيَّرُ فِي الانْعِكَاسِ؟",
  "ms.1a": "تَبْقَى الأَطْوَالُ وَالزَّوَايَا، وَيَنْقَلِبُ الاتِّجَاهُ.",
  "ms.1b": "تَتَغَيَّرُ الأَطْوَالُ، وَيَبْقَى الاتِّجَاهُ كَمَا هُوَ.",
  "ms.1c": "يَبْقَى كُلُّ شَيْءٍ، حَتَّى المَوْضِعُ.",
  "ms.recall": "نَتَذَكَّرُ: الصُّورَةُ فِي الجِهَةِ الأُخْرَى بِالبُعْدِ نَفْسِهِ، وَالوَاصِلُ عَمُودِيٌّ عَلَى الخَطِّ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} الانْعِكَاسَ!",
  "wrap.01": "البُعْدُ نَفْسُهُ فِي الجِهَةِ الأُخْرَى، وَالاتِّجَاهُ يَنْقَلِبُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: أَمَامَ المِرْآةِ {اِرْفَعْ|اِرْفَعِي} {يَدَكَ|يَدَكِ} اليُمْنَى، {وَاسْأَلْ|وَاسْأَلِي} {أَهْلَكَ|أَهْلَكِ}: أَيَّ يَدٍ تَرْفَعُ الصُّورَةُ؟"
  ]
 },
