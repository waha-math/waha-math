{
 "id": "m3.u6.d2",
 "title": "الانْسِحَابُ",
 "icon": [
  "xficon"
 ],
 "concepts": {
  "C313": "الانسحاب: كل نقطة تتحرّك المسافة نفسها في الاتجاه نفسه، بالأعداد جمعاً لليمين ولأعلى وطرحاً لليسار ولأسفل، والأسهم متوازية ومتساوية، ويبقى الاتجاه"
 },
 "bag": {
  "items": [
   {
    "icon": "tracing",
    "label": "bagTrace"
   },
   {
    "icon": "gridPaper",
    "label": "bagGrid"
   }
  ],
  "ask": "bag.ask",
  "adult": "ورق شفّاف وورق مربعات.",
  "screenPath": "على الشاشة يعيّن الطفل صورة الشكل بالانسحاب، ويختار الانسحاب الذي ينقل نقطة إلى صورتها."
 },
 "labels": {
  "bagTrace": "وَرَقٌ شَفَّافٌ",
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقٌ شَفَّافٌ وَوَرَقُ مُرَبَّعَاتٍ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "نَقَلْتُ المُثَلَّثَ وَأَدَرْتُهُ رُبْعَ دَوْرَةٍ: هَذَا انْسِحَابٌ!"
  ],
  "hk.02": "فِي الانْسِحَابِ لَا نُدِيرُ: كُلُّ نُقْطَةٍ تَتَحَرَّكُ المَسَافَةَ نَفْسَهَا فِي الاتِّجَاهِ نَفْسِهِ.",
  "tr.01": "ثَلَاثَةٌ يَمِينًا وَاثْنَانِ لِأَعْلَى: نُضِيفُ ثَلَاثَةً إِلَى الإِحْدَاثِيِّ الأُفُقِيِّ، وَاثْنَيْنِ إِلَى الرَّأْسِيِّ، الأُفُقِيُّ أَوَّلًا.",
  "tr.02": "وَالأَسْهُمُ مِنْ كُلِّ رَأْسٍ إِلَى صُورَتِهِ مُتَوَازِيَةٌ وَمُتَسَاوِيَةُ الطُّولِ.",
  "tr.03": "وَيَسَارًا وَلِأَسْفَلَ نَطْرَحُ: أَرْبَعَةٌ يَسَارًا وَثَلَاثَةٌ لِأَسْفَلَ، وَالصُّورَةُ دَاخِلَ الرُّبُعِ.",
  "tr.04": "تَغَيَّرَ المَوْضِعُ، وَبَقِيَتِ الأَطْوَالُ وَالزَّوَايَا وَالاتِّجَاهُ: لَا قَلْبَ وَلَا لَفَّ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} شَكْلًا، {وَانْسَخْهُ|وَانْسَخِيهِ} عَلَى الوَرَقِ الشَّفَّافِ، {وَاسْحَبْهُ|وَاسْحَبِيهِ} يَمِينًا ثُمَّ لِأَعْلَى بِلَا إِدَارَةٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: قِطَارُ الانْسِحَابِ! أَيُّ انْسِحَابٍ يُوصِلُ القِطَارَ إِلَى المَحَطَّةِ؟",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: الانْسِحَابُ يُدِيرُ الشَّكْلَ قَلِيلًا. مَا الصَّحِيحُ؟",
  "pr.r1a": "لَا يُدِيرُهُ: يَبْقَى الاتِّجَاهُ.",
  "pr.r1b": "يُدِيرُهُ رُبْعَ دَوْرَةٍ فِي كُلِّ خُطْوَةٍ يَخْطُوهَا.",
  "pr.r1c": "يُدِيرُهُ إِذَا كَانَ الانْسِحَابُ يَسَارًا فَقَطْ.",
  "pr.r2": "قَالَ طَالِبٌ: ثَلَاثَةٌ يَمِينًا وَاثْنَانِ لِأَعْلَى تَعْنِي إِضَافَةَ اثْنَيْنِ إِلَى الأُفُقِيِّ. مَا خَطَؤُهُ؟",
  "pr.r2a": "الأُفُقِيُّ أَوَّلًا: نُضِيفُ ثَلَاثَةً إِلَيْهِ.",
  "pr.r2b": "لَا خَطَأَ: التَّرْتِيبُ بَيْنَ الأُفُقِيِّ وَالرَّأْسِيِّ لَا يُهِمُّ.",
  "pr.r2c": "كَانَ عَلَيْهِ أَنْ يُضِيفَ خَمْسَةً إِلَى كِلَيْهِمَا.",
  "ch.find": "نَقَلَتْ فَوْضَى الشَّكْلَ وَأَدَارَتْهُ. {عَيِّنْ|عَيِّنِي} صُورَتَهُ بِالانْسِحَابِ حَقًّا، ثُمَّ «تَمَّ»:",
  "ch.after": [
   "chaos",
   "آه! الانْسِحَابُ لَا يُدِيرُ."
  ],
  "ch.right": "المَسَافَةُ نَفْسُهَا وَالاتِّجَاهُ نَفْسُهُ لِكُلِّ نُقْطَةٍ.",
  "ch.wrong": [
   "chaos",
   "نَنْقُلُ وَنُدِيرُ."
  ],
  "ms.1": "يَصْعَدُ مِصْعَدٌ مِنَ الطَّابَقِ الأَوَّلِ إِلَى الرَّابِعِ. لِمَاذَا حَرَكَتُهُ انْسِحَابٌ؟",
  "ms.1a": "تَتَحَرَّكُ كُلُّ نُقْطَةٍ فِيهِ المَسَافَةَ نَفْسَهَا، بِلَا دَوَرَانٍ.",
  "ms.1b": "لِأَنَّهُ يَصْعَدُ لِأَعْلَى، وَالصُّعُودُ هُوَ مَعْنَى الانْسِحَابِ.",
  "ms.1c": "لِأَنَّهُ يَنْقَلِبُ فِي الطَّرِيقِ، فَيَصِيرُ أَعْلَاهُ أَسْفَلَهُ حِينَ يَصِلُ.",
  "ms.recall": "نَتَذَكَّرُ: نُضِيفُ لِلْيَمِينِ وَلِأَعْلَى، وَنَطْرَحُ لِلْيَسَارِ وَلِأَسْفَلَ، وَالأُفُقِيُّ أَوَّلًا.",
  "ms.x1": "مُرَبَّعٌ ضِلْعُهُ ثَلَاثَةٌ، سَحَبْنَاهُ خَمْسَةً يَمِينًا. كَمْ ضِلْعُ صُورَتِهِ؟",
  "ms.x1a": "ثَلَاثَةٌ: الانْسِحَابُ يَنْقُلُ وَلَا يُغَيِّرُ الأَطْوَالَ.",
  "ms.x1b": "ثَمَانِيَةٌ: نُضِيفُ الخَمْسَةَ إِلَى طُولِ كُلِّ ضِلْعٍ مِنْهُ.",
  "ms.x1c": "اثْنَانِ: يَصْغُرُ الشَّكْلُ كُلَّمَا ابْتَعَدَ عَنْ مَكَانِهِ.",
  "pr.isTr": "هَلِ الشَّكْلُ البُرْتُقَالِيُّ صُورَةُ الأَزْرَقِ بِانْسِحَابٍ؟",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} الانْسِحَابَ!",
  "wrap.01": "المَسَافَةُ نَفْسُهَا، وَالاتِّجَاهُ نَفْسُهُ، بِلَا إِدَارَةٍ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِسْحَبْ|اِسْحَبِي} كِتَابًا عَلَى الطَّاوِلَةِ بِلَا إِدَارَةٍ، {وَصِفْ|وَصِفِي} حَرَكَتَهُ {لِأَهْلِكَ|لِأَهْلِكِ}: كَمْ يَمِينًا؟ وَكَمْ إِلَى الأَمَامِ؟"
  ]
 },
