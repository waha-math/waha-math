  "ask": "bag.ask",
  "adult": "ورقة (ركنها زاوية قائمة) ومسطرة.",
  "screenPath": "على الشاشة يفحص الطفل التعامد بورقة الزاوية القائمة، ويدير القطر حتى يتعامد القطران."
 },
 "labels": {
  "bagRuler": "مِسْطَرَةٌ",
  "bagPaper": "وَرَقَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "قُطْرَا المُسْتَطِيلِ مُتَعَامِدَانِ، لِأَنَّ زَوَايَاهُ كُلَّهَا قَائِمَةٌ!"
  ],
  "hk.02": "نَضَعُ وَرَقَةَ الزَّاوِيَةِ القَائِمَةِ عِنْدَ التَّقَاطُعِ: لَا تَنْطَبِقُ.",
  "pp.01": "فِي المُعَيَّنِ: وَرَقَةُ الزَّاوِيَةِ القَائِمَةِ تَنْطَبِقُ عِنْدَ التَّقَاطُعِ. القُطْرَانِ مُتَعَامِدَانِ.",
  "pp.02": "وَفِي المُسْتَطِيلِ لَا تَنْطَبِقُ: زَوَايَاهُ القَائِمَةُ عِنْدَ الرُّؤُوسِ، لَا عِنْدَ التَّقَاطُعِ.",
  "pp.03": "لِمَاذَا؟ قُطْرُ المِحْوَرِ يَقْطَعُ الآخَرَ عَمُودِيًّا وَفِي مُنْتَصَفِهِ.",
  "pp.04": "وَالقُطْرُ يَقْسِمُ زَاوِيَةَ المُعَيَّنِ نِصْفَيْنِ: سِتُّونَ تَصِيرُ ثَلَاثِينَ وَثَلَاثِينَ.",
  "pp.05": "وَالزَّاوِيَةُ المُجَاوِرَةُ لَهَا: مِئَةٌ وَثَمَانُونَ نَاقِصَ سِتِّينَ، أَيْ مِئَةٌ وَعِشْرُونَ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى الوَرَقَةِ مُعَيَّنًا وَقُطْرَيْهِ بِالمِسْطَرَةِ، {وَافْحَصِ|وَافْحَصِي} التَّعَامُدَ بِرُكْنِ وَرَقَةٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: {حَارِسُ|حَارِسَةُ} التَّقَاطُعِ! {أَدِرِ|أَدِيرِي} القُطْرَ حَتَّى يَتَعَامَدَ القُطْرَانِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: قُطْرَا هَذَا الرُّبَاعِيِّ مُتَعَامِدَانِ، إِذَنْ هُوَ مُرَبَّعٌ. مَا {رَأْيُكَ|رَأْيُكِ}؟",
  "pr.r1a": "قَدْ يَكُونُ مُعَيَّنًا أَوْ طَائِرَةً وَرَقِيَّةً.",
  "pr.r1b": "صَدَقَتْ: القُطْرَانِ المُتَعَامِدَانِ يَصْنَعَانِ مُرَبَّعًا.",
  "pr.r1c": "هُوَ مُسْتَطِيلٌ، فَزَوَايَاهُ قَائِمَةٌ.",
  "pr.r2": "أَيُّ قُطْرَيِ المُعَيَّنِ مِحْوَرُ تَمَاثُلٍ؟",
  "pr.r2a": "كِلَاهُمَا مِحْوَرُ تَمَاثُلٍ لَهُ.",
  "pr.r2b": "الأَطْوَلُ وَحْدَهُ، فَهُوَ يَقْطَعُ الآخَرَ فِي مُنْتَصَفِهِ.",
  "pr.r2c": "وَلَا وَاحِدٌ مِنْهُمَا.",
  "ch.find": "تَقُولُ فَوْضَى: قُطْرَا المُسْتَطِيلِ مُتَعَامِدَانِ دَائِمًا! مَا الصَّحِيحُ؟",
  "ch.after": [
   "chaos",
   "آه! الزَّوَايَا القَائِمَةُ عِنْدَ الرُّؤُوسِ، لَا عِنْدَ التَّقَاطُعِ."
  ],
  "ch.right": "نَفْحَصُ بِالوَرَقَةِ عِنْدَ التَّقَاطُعِ.",
  "ch.wrong": [
   "chaos",
   "زَوَايَاهُ قَائِمَةٌ، فَقُطْرَاهُ مُتَعَامِدَانِ."
  ],
  "ms.1": "لِمَاذَا قُطْرَا المُرَبَّعِ مُتَعَامِدَانِ؟",
  "ms.1a": "لَهُ قُطْرٌ هُوَ مِحْوَرُ تَمَاثُلٍ، فَيَقْطَعُ الآخَرَ عَمُودِيًّا.",
  "ms.1b": "زَوَايَاهُ الأَرْبَعُ قَائِمَةٌ، فَقُطْرَاهُ قَائِمَانِ أَيْضًا.",
  "ms.1c": "قُطْرَاهُ مُتَسَاوِيَانِ، وَالقُطْرَانِ المُتَسَاوِيَانِ يَتَعَامَدَانِ.",
  "ms.recall": "نَتَذَكَّرُ: نَضَعُ رُكْنَ الوَرَقَةِ عِنْدَ التَّقَاطُعِ، وَنَبْحَثُ عَنْ قُطْرٍ هُوَ مِحْوَرُ تَمَاثُلٍ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} الأَقْطَارَ المُتَعَامِدَةَ!",
  "wrap.01": "قُطْرُ المِحْوَرِ عَمُودِيٌّ، وَيَقْسِمُ الزَّاوِيَةَ نِصْفَيْنِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: طَيُّ وَرَقَةٍ مُرَبَّعَةٍ عَلَى قُطْرَيْهَا، ثُمَّ فَحْصُ الخَطَّيْنِ بِرُكْنِ وَرَقَةٍ أُخْرَى: هَلْ تَعَامَدَا؟"
  ]
 },
