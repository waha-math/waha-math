 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِسْطَرَةٌ وَوَرَقَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ الأَقْطَارِ أَخْطَاءُ فَوْضَى: قُطْرَا مُسْتَطِيلٍ مُتَعَامِدَانِ، وَطَائِرَةٌ قُطْرَاهَا مُنَصَّفَانِ، وَمُعَيَّنٌ لَيْسَ طَائِرَةً.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {حَارِسِ|حَارِسَةِ} الأَقْطَارِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ الثَّالِثِ.",
  "mat.01": "عَلَى الوَرَقَةِ {اُرْسُمْ|اُرْسُمِي} رُبَاعِيًّا وَقُطْرَيْهِ بِالمِسْطَرَةِ، {وَافْحَصْ|وَافْحَصِي} خَصَائِصَ القُطْرَيْنِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: نَفْحَصُ القُطْرَيْنِ: هَلْ يَتَسَاوَيَانِ؟ هَلْ يَتَقَاطَعَانِ فِي المُنْتَصَفِ؟ هَلْ يَتَعَامَدَانِ؟",
  "rv.02": "وَنُعَلِّلُ بِالمِحْوَرِ وَبِنِصْفِ الدَّوْرَةِ، وَنُسَمِّي الشَّكْلَ بِكُلِّ أَسْمَائِهِ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى القُطْرَيْنِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.perp": "تَقُولُ فَوْضَى: قُطْرَا المُسْتَطِيلِ مُتَعَامِدَانِ دَائِمًا. مَا الصَّحِيحُ؟",
  "gm.mid": "تَقُولُ فَوْضَى: قُطْرَا الطَّائِرَةِ يُنَصِّفُ كُلٌّ مِنْهُمَا الآخَرَ. مَا الصَّحِيحُ؟",
  "gm.r1": "تَقُولُ فَوْضَى: المُعَيَّنُ لَيْسَ طَائِرَةً وَرَقِيَّةً. مَا الصَّحِيحُ؟",
  "gm.r1a": "هُوَ طَائِرَةٌ: فِيهِ زَوْجَانِ مُتَجَاوِرَانِ مُتَسَاوِيَانِ.",
  "gm.r1b": "صَدَقَتْ: أَضْلَاعُ الطَّائِرَةِ مُخْتَلِفَةٌ دَائِمًا.",
  "gm.r1c": "صَدَقَتْ: المُعَيَّنُ لَيْسَ مُحَدَّبًا.",
  "gm.r2": "تَقُولُ فَوْضَى: المُرَبَّعُ لَيْسَ مُعَيَّنًا. مَا الصَّحِيحُ؟",
  "gm.r2a": "هُوَ مُعَيَّنٌ: أَضْلَاعُهُ الأَرْبَعَةُ مُتَسَاوِيَةٌ.",
  "gm.r2b": "صَدَقَتْ: زَوَايَا المُعَيَّنِ غَيْرُ قَائِمَةٍ دَائِمًا.",
  "gm.r2c": "صَدَقَتْ: المُرَبَّعُ أَصْغَرُ مِنَ المُعَيَّنِ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.11": "قَالَتْ فَوْضَى: كُلُّ شِبْهِ مُنْحَرِفٍ قُطْرَاهُ مُتَسَاوِيَانِ. مَا خَطَؤُهَا؟",
  "ts.11a": "هَذَا شِبْهُ مُنْحَرِفٍ، وَقُطْرَاهُ مُخْتَلِفَانِ.",
  "ts.11b": "لَا خَطَأَ: قُطْرَاهُ مُتَسَاوِيَانِ فِي كُلِّ مِثَالٍ.",
  "ts.11c": "شِبْهُ المُنْحَرِفِ لَا قُطْرَ لَهُ.",
  "ts.12": "هَلِ المُعَيَّنُ طَائِرَةٌ وَرَقِيَّةٌ؟ {بَرِّرْ|بَرِّرِي}.",
  "ts.12a": "نَعَمْ: أَضْلَاعُهُ المُتَجَاوِرَةُ مُتَسَاوِيَةٌ.",
  "ts.12b": "لَا: قُطْرَاهُ لَا يَتَعَامَدَانِ.",
  "ts.12c": "لَا: لِلطَّائِرَةِ ضِلْعَانِ قَصِيرَانِ دَائِمًا.",
  "ts.rem": "نَقِيسُ الأَقْطَارَ بِجَدْوَلٍ مَعَ الكِبَارِ، وَنَطْوِي عَلَى القُطْرِ، وَنَصْنَعُ رُبَاعِيًّا بِعُودَيْنِ وَمِسْمَارٍ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ الثَّالِثِ."
  ],
  "ts.win1": "{أَنْتَ حَارِسُ|أَنْتِ حَارِسَةُ} الأَقْطَارِ!",
  "ts.win2": "{فَحَصْتَ|فَحَصْتِ} القُطْرَيْنِ، {وَعَلَّلْتَ|وَعَلَّلْتِ} بِالمِحْوَرِ، {وَسَمَّيْتَ|وَسَمَّيْتِ} كُلَّ شَكْلٍ بِأَسْمَائِهِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {حَارِسِ|حَارِسَةِ} الأَقْطَارِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِفْحَصْ|اِفْحَصِي} إِطَارَ صُورَةٍ بِقُطْرَيْهِ، {وَقُلْ|وَقُولِي} لِأَهْلِ البَيْتِ كَيْفَ {عَرَفْتَ|عَرَفْتِ} أَنَّهُ مُسْتَطِيلٌ."
  ]
 },
