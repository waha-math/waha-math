 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قَلَمٌ وَوَرَقَةٌ لِلْحِسَابِ؟ أَمْ نَحْسُبُ فِي الرَّأْسِ عَلَى الشَّاشَةِ؟",
  "hook.01": "مَرْحَبًا فِي مَدِينَةِ المُهَنْدِسِينَ! قَبْلَ أَنْ نَبْدَأَ: أَسْئِلَةٌ قَلِيلَةٌ.",
  "hook.02": "لَا بَأْسَ إِنْ لَمْ {تَعْرِفْ|تَعْرِفِي}: {اِخْتَرْ|اِخْتَارِي} مَا {تَظُنُّ|تَظُنِّينَ}. الأَسْئِلَةُ تُخْبِرُنَا مِنْ أَيْنَ نَبْدَأُ، وَلَا دَرَجَةَ فِيهَا.",
  "mat.01": "{خُذِ|خُذِي} القَلَمَ وَالوَرَقَةَ، {وَاحْسُبْ|وَاحْسُبِي} عَلَيْهَا مَا {شِئْتَ|شِئْتِ}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "dg.intro": "أَسْئِلَةٌ مِنْ أَحْيَاءِ المَدِينَةِ، بِلَا عَجَلَةٍ.",
  "dg.after": "{شُكْرًا لَكَ|شُكْرًا لَكِ}! عَرَفْنَا مِنْ أَيْنَ نَبْدَأُ.",
  "wrap.01": "انْتَهَى الإِحْمَاءُ. هَيَّا إِلَى حَيِّ الأَعْشَارِ!"
 },
