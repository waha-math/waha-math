 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِسْطَرَةٌ وَشَرِيطُ قِيَاسٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "عِنْدَ بَوَّابَةِ حَيِّ الأَعْشَارِ أَخْطَاءُ فَوْضَى: صِفْرٌ زَائِدٌ بَعْدَ الفَاصِلَةِ، وَمُقَارَنَةٌ بِالأَرْقَامِ، وَأَعْشَارٌ مَكَانَ الأَجْزَاءِ مِنْ مِئَةٍ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {قَيَّاسِ|قَيَّاسَةِ} الأَعْشَارِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ الأَوَّلِ.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ قَلَمًا، وَبِالشَّرِيطِ طَاوِلَةً، {وَاكْتُبِ|وَاكْتُبِي} الطُّولَيْنِ بِالفَاصِلَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المِلِّيمِتْرُ عُشْرُ السَّنْتِيمِتْرِ، وَالسَّنْتِيمِتْرُ جُزْءٌ مِنْ مِئَةٍ مِنَ المِتْرِ.",
  "rv.02": "وَنُقَارِنُ وَنَحْسُبُ بِالوَحْدَةِ الأَصْغَرِ، ثُمَّ نَعُودُ، وَنَتَحَقَّقُ بِالتَّقْرِيبِ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى العَشْرِيَّةُ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.r": "كَتَبَتْ فَوْضَى طُولَ القَلَمِ بِصِفْرٍ بَعْدَ الفَاصِلَةِ. كَمْ طُولُهُ حَقًّا؟",
  "gm.cmp": "تَقُولُ فَوْضَى: الأَطْوَلُ مَا بَعْدَ فَاصِلَتِهِ أَرْقَامٌ أَكْثَرُ. أَيُّهُمَا أَطْوَلُ حَقًّا؟",
  "gm.mc": "كَتَبَتْ فَوْضَى السَّنْتِيمِتْرَاتِ أَعْشَارًا. مَا الصَّحِيحُ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "q.toDcm": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالسَّنْتِيمِتْرِ وَحْدَهُ:",
  "q.toCmm": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالسَّنْتِيمِتْرِ وَالمِلِّيمِتْرِ:",
  "q.toDm": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالمِتْرِ وَحْدَهُ:",
  "ts.9": "كَتَبَتْ فَوْضَى ثَلَاثَةَ سَنْتِيمِتْرَاتٍ وَسِتَّةَ مِلِّيمِتْرَاتٍ هَكَذَا. مَا خَطَؤُهَا؟",
  "ts.9a": "السِّتَّةُ أَعْشَارٌ، فَلَا صِفْرَ قَبْلَهَا.",
  "ts.9b": "الصَّحِيحُ سِتَّةٌ وَثَلَاثُونَ سَنْتِيمِتْرًا.",
  "ts.9c": "لَا خَطَأَ: الصِّفْرُ يَفْصِلُ الوَحْدَتَيْنِ.",
  "ts.10": "لِمَاذَا أَرْبَعَةُ أَمْتَارٍ وَسَبْعَةُ أَعْشَارٍ أَطْوَلُ؟",
  "ts.10a": "فِيهِ أَرْبَعُمِئَةٍ وَسَبْعُونَ سَنْتِيمِتْرًا، وَفِي الآخَرِ أَقَلُّ.",
  "ts.10b": "لِأَنَّ مَا بَعْدَ فَاصِلَتِهِ رَقْمٌ وَاحِدٌ، وَالأَقَلُّ أَرْقَامًا أَكْبَرُ دَائِمًا.",
  "ts.10c": "لِأَنَّ آخِرَ رَقْمٍ فِيهِ سَبْعَةٌ، وَآخِرُ رَقْمٍ فِي الآخَرِ خَمْسَةٌ.",
  "ts.rem": "نَعُدُّ الأَعْشَارَ عَلَى خَطِّ الأَعْدَادِ مَعَ الكِبَارِ، وَنُحَوِّلُ الأَطْوَالَ إِلَى مِلِّيمِتْرٍ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ الأَوَّلِ."
  ],
  "ts.win1": "{أَنْتَ قَيَّاسُ|أَنْتِ قَيَّاسَةُ} الأَعْشَارِ!",
  "ts.win2": "{قَرَأْتَ|قَرَأْتِ} الطُّولَ العَشْرِيَّ، {وَقَارَنْتَ|وَقَارَنْتِ} {وَحَسَبْتَ|وَحَسَبْتِ} بِالتَّحْوِيلِ، {وَعَلَّلْتَ|وَعَلَّلْتِ}.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {قَيَّاسِ|قَيَّاسَةِ} الأَعْشَارِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} فِي البَيْتِ أَوِ المَتْجَرِ عَنْ طُولٍ مَكْتُوبٍ بِالفَاصِلَةِ، {وَاقْرَأْهُ|وَاقْرَئِيهِ} بِالمِتْرِ وَالسَّنْتِيمِتْرِ."
  ]
 },
