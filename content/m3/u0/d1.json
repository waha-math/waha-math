  "ms.1": "قَالَتْ فَوْضَى: الطُّولَانِ مُتَسَاوِيَانِ. مَا الصَّحِيحُ؟",
  "ms.1a": "نِصْفُ السَّنْتِيمِتْرِ خَمْسَةُ مِلِّيمِتْرَاتٍ.",
  "ms.1b": "صَدَقَتْ: الرَّقْمُ خَمْسَةٌ فِي الطُّولَيْنِ.",
  "ms.1c": "الأَوَّلُ أَطْوَلُ، فَهُوَ خَمْسُونَ مِلِّيمِتْرًا.",
  "ms.recall": "نَتَذَكَّرُ: بَيْنَ كُلِّ رَقْمَيْنِ عَلَى المِسْطَرَةِ عَشَرَةُ مِلِّيمِتْرَاتٍ، وَكُلُّ مِلِّيمِتْرٍ عُشْرٌ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} الطُّولَ العَشْرِيَّ!",
  "wrap.01": "المِلِّيمِتْرُ عُشْرُ السَّنْتِيمِتْرِ، وَالأَعْشَارُ بَعْدَ الفَاصِلَةِ!",
