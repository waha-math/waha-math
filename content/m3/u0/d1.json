 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِسْطَرَةٌ وَوَرَقَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "قِسْتُ القَلَمَ: خَمْسَةُ سَنْتِيمِتْرَاتٍ وَثَمَانِيَةُ مِلِّيمِتْرَاتٍ."
  ],
  "hook.02": [
   "chaos",
   "وَكَتَبْتُ طُولَهُ بِالسَّنْتِيمِتْرِ وَحْدَهُ هَكَذَا!"
  ],
  "hook.03": "نَعْرِفُ اليَوْمَ مَاذَا يَعْنِي الرَّقْمُ بَعْدَ الفَاصِلَةِ.",
  "dt.01": "بَيْنَ سَبْعَةٍ وَثَمَانِيَةٍ عَلَى المِسْطَرَةِ عَشَرَةُ أَجْزَاءٍ مُتَسَاوِيَةٍ، كُلُّ جُزْءٍ مِلِّيمِتْرٌ.",
  "dt.02": "فَالمِلِّيمِتْرُ عُشْرُ السَّنْتِيمِتْرِ، وَيُكْتَبُ بِالفَاصِلَةِ هَكَذَا.",
  "dt.03": "يَسَارَ الفَاصِلَةِ سَنْتِيمِتْرَاتٌ كَامِلَةٌ، وَيَمِينَهَا أَعْشَارٌ: سَبْعَةُ سَنْتِيمِتْرَاتٍ وَأَرْبَعَةُ مِلِّيمِتْرَاتٍ هِيَ سَبْعَةُ سَنْتِيمِتْرَاتٍ وَأَرْبَعَةُ أَعْشَارٍ.",
  "dt.04": "وَقَلَمُ فَوْضَى: ثَمَانِيَةُ مِلِّيمِتْرَاتٍ هِيَ ثَمَانِيَةُ أَعْشَارٍ، فَلَا صِفْرَ بَعْدَ الفَاصِلَةِ.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ أَشْيَاءَ صَغِيرَةً، {وَاكْتُبْ|وَاكْتُبِي} عَلَى الوَرَقَةِ كُلَّ طُولٍ بِالطَّرِيقَتَيْنِ: بِالسَّنْتِيمِتْرِ وَالمِلِّيمِتْرِ، ثُمَّ بِالفَاصِلَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مِسْطَرَةُ فَوْضَى العَشْرِيَّةُ! {ضَعِ|ضَعِي} المُؤَشِّرَ عَلَى الطُّولِ المَطْلُوبِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "q.toDcm": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالسَّنْتِيمِتْرِ وَحْدَهُ:",
  "q.toCmm": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالسَّنْتِيمِتْرِ وَالمِلِّيمِتْرِ:",
  "q.toMm": "كَمْ مِلِّيمِتْرًا فِي هَذَا الطُّولِ؟",
  "ch.find": "قَاسَتْ فَوْضَى مِسْمَارًا. كَمْ طُولُهُ بِالسَّنْتِيمِتْرِ؟",
  "ch.after": [
   "chaos",
   "آه! المِلِّيمِتْرَاتُ أَعْشَارٌ، تُكْتَبُ بَعْدَ الفَاصِلَةِ مُبَاشَرَةً."
  ],
  "ch.right": "المِلِّيمِتْرُ عُشْرُ السَّنْتِيمِتْرِ.",
  "ch.wrong": [
