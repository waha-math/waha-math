 ],
 "concepts": {
  "C310": "مقياس الرسم «1 سم : 3 م»: من الورق إلى الواقع بالضرب، ومن الواقع إلى الورق بالقسمة، والوحدة مع كل طول (استدعاء C188 وC324)"
 },
 "bag": {
