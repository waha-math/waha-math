  ],
  "ask": "bag.ask",
  "adult": "مسطرة وورق مربعات.",
  "screenPath": "على الشاشة يحوّل الطفل أطوالاً بين الخريطة والواقع، ويرسم طرقاً بالمقياس."
 },
 "labels": {
  "bagRuler": "مِسْطَرَةٌ",
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِسْطَرَةٌ وَوَرَقُ مُرَبَّعَاتٍ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "أَرْسُمُ الغُرْفَةَ بِطُولِهَا الحَقِيقِيِّ: خَمْسَةَ عَشَرَ مِتْرًا، وَكُلُّهَا تَدْخُلُ فِي الوَرَقَةِ!"
  ],
  "hk.02": "الوَرَقَةُ أَقْصَرُ بِكَثِيرٍ مِنْ خَمْسَةَ عَشَرَ مِتْرًا: الخَطُّ يَخْرُجُ مِنْهَا. نَحْتَاجُ مِقْيَاسًا.",
  "sc.01": "نَخْتَارُ مِقْيَاسًا: كُلُّ سَنْتِيمِتْرٍ عَلَى الوَرَقِ يُمَثِّلُ ثَلَاثَةَ أَمْتَارٍ حَقِيقِيَّةٍ، وَنَكْتُبُهُ: سَنْتِيمِتْرٌ وَاحِدٌ إِلَى ثَلَاثَةِ أَمْتَارٍ.",
  "sc.02": "جِدَارٌ طُولُهُ سِتَّةُ أَمْتَارٍ نَرْسُمُهُ بِسَنْتِيمِتْرَيْنِ.",
  "up.01": "خَطٌّ عَلَى الوَرَقِ طُولُهُ خَمْسَةُ سَنْتِيمِتْرَاتٍ: كُلُّ سَنْتِيمِتْرٍ ثَلَاثَةُ أَمْتَارٍ، فَنَضْرِبُ فِي ثَلَاثَةٍ: خَمْسَةَ عَشَرَ مِتْرًا.",
  "up.02": "وَنَكْتُبُ الوَحْدَةَ مَعَ كُلِّ طُولٍ: خَمْسَةُ سَنْتِيمِتْرَاتٍ عَلَى الوَرَقِ، وَخَمْسَةَ عَشَرَ مِتْرًا حَقِيقِيَّةً، فَلَا نَخْلِطُ السَّنْتِيمِتْرَ بِالمِتْرِ.",
  "dn.01": "وَمِنَ الوَاقِعِ إِلَى الوَرَقِ نَقْسِمُ: حَافِلَةٌ صَغِيرَةٌ طُولُهَا سِتَّةُ أَمْتَارٍ.",
  "dn.02": "سِتَّةٌ عَلَى ثَلَاثَةٍ اثْنَانِ: نَرْسُمُهَا بِسَنْتِيمِتْرَيْنِ.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ خُطُوطًا {تَرْسُمُهَا|تَرْسُمِينَهَا} عَلَى وَرَقِ المُرَبَّعَاتِ، {وَاحْسُبْ|وَاحْسُبِي} طُولَ كُلٍّ مِنْهَا الحَقِيقِيَّ بِالمِقْيَاسِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: خَرِيطَةُ المَدِينَةِ! {اُرْسُمِ|اُرْسُمِي} الطُّرُقَ بِالمِقْيَاسِ، {وَاحْسُبْ|وَاحْسُبِي} أَطْوَالَهَا الحَقِيقِيَّةَ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: المِقْيَاسُ سَنْتِيمِتْرٌ لِكُلِّ ثَلَاثَةِ أَمْتَارٍ، فَخَطٌّ خَمْسَةُ سَنْتِيمِتْرَاتٍ ثَمَانِيَةُ أَمْتَارٍ. مَا خَطَؤُهَا؟",
  "pr.r1a": "جَمَعَتْ، وَالصَّحِيحُ أَنْ نَضْرِبَ: خَمْسَةَ عَشَرَ مِتْرًا.",
  "pr.r1b": "لَا خَطَأَ: نَجْمَعُ المِقْيَاسَ إِلَى طُولِ الخَطِّ.",
  "pr.r1c": "الصَّحِيحُ أَنْ نَقْسِمَ خَمْسَةً عَلَى ثَلَاثَةٍ.",
  "pr.two": "{أَقْنِعْنِي|أَقْنِعِينِي} بِسَبَبَيْنِ: حِينَ يَتَضَاعَفُ ضِلْعُ المُرَبَّعِ تَصِيرُ مِسَاحَتُهُ أَرْبَعَةَ أَضْعَافٍ. {اِلْمِسِ|اِلْمِسِي} البِطَاقَتَيْنِ الصَّحِيحَتَيْنِ، ثُمَّ «تَمَّ».",
  "pr.twoa": "عَدَدْنَا: مُرَبَّعٌ ضِلْعُهُ اثْنَانِ فِيهِ أَرْبَعَةُ مُرَبَّعَاتٍ، وَضِلْعُهُ أَرْبَعَةٌ فِيهِ سِتَّةَ عَشَرَ، وَهِيَ أَرْبَعَةُ أَضْعَافِ الأَرْبَعَةِ.",
  "pr.twob": "المِسَاحَةُ ضِلْعٌ فِي ضِلْعٍ، وَالمُعَامِلُ اثْنَانِ يَدْخُلُ مَرَّتَيْنِ، فَتُضْرَبُ المِسَاحَةُ فِي اثْنَيْنِ فِي اثْنَيْنِ.",
  "pr.twoc": "لِأَنَّ لِلْمُرَبَّعِ أَرْبَعَةَ أَضْلَاعٍ، فَمِسَاحَتُهُ تُضْرَبُ فِي عَدَدِهَا.",
  "pr.twoHint": "السَّبَبُ المُقْنِعُ عَدٌّ أَوْ ضَرْبٌ لِلطُّولِ وَالعَرْضِ، لَا عَدَدُ الأَضْلَاعِ.",
  "ch.find": "قَالَتْ فَوْضَى: بِسَنْتِيمِتْرٍ لِكُلِّ ثَلَاثَةِ أَمْتَارٍ، خَطٌّ عَشَرَةُ سَنْتِيمِتْرَاتٍ ثَلَاثَةَ عَشَرَ مِتْرًا. كَمْ طُولُهُ الحَقِيقِيُّ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! نَضْرِبُ وَلَا نَجْمَعُ."
  ],
  "ch.right": "عَشَرَةٌ فِي ثَلَاثَةٍ.",
  "ch.wrong": [
   "chaos",
   "نَجْمَعُ المِقْيَاسَ."
  ],
  "ms.1": "مِقْيَاسُ هَذِهِ الخَرِيطَةِ سَنْتِيمِتْرٌ لِخَمْسَةِ أَمْتَارٍ. لِمَاذَا نَضْرِبُ طُولَ الرَّسْمِ فِي خَمْسَةٍ؟",
  "ms.1a": "كُلُّ سَنْتِيمِتْرٍ مِنْهُ يُمَثِّلُ خَمْسَةَ أَمْتَارٍ فِي الحَقِيقَةِ.",
  "ms.1b": "لِأَنَّ الطُّولَ الحَقِيقِيَّ أَصْغَرُ مِنَ الرَّسْمِ.",
  "ms.1c": "لِأَنَّ المِتْرَ خَمْسَةُ سَنْتِيمِتْرَاتٍ فِي كُلِّ خَرِيطَةٍ.",
  "ms.recall": "نَتَذَكَّرُ: مِنَ الوَرَقِ إِلَى الوَاقِعِ نَضْرِبُ، وَمِنَ الوَاقِعِ إِلَى الوَرَقِ نَقْسِمُ، وَنَكْتُبُ الوَحْدَةَ مَعَ كُلِّ طُولٍ.",
  "ms.x1": "طُولُ مَلْعَبٍ أَرْبَعُونَ مِتْرًا، وَالمِقْيَاسُ سَنْتِيمِتْرٌ لِعَشَرَةِ أَمْتَارٍ. لِمَاذَا نَرْسُمُهُ أَرْبَعَةَ سَنْتِيمِتْرَاتٍ؟",
  "ms.x1a": "نَقْسِمُ أَرْبَعِينَ عَلَى عَشَرَةٍ: لِكُلِّ عَشَرَةِ أَمْتَارٍ سَنْتِيمِتْرٌ.",
  "ms.x1b": "نَطْرَحُ عَشَرَةَ أَمْتَارٍ مِنْ أَرْبَعِينَ، ثُمَّ نَكْتُبُ النَّاتِجَ سَنْتِيمِتْرَاتٍ.",
  "ms.x1c": "لِأَنَّ كُلَّ شَيْءٍ يُرْسَمُ أَرْبَعَةَ سَنْتِيمِتْرَاتٍ فِي كُلِّ خَرِيطَةٍ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} مِقْيَاسَ الرَّسْمِ!",
  "wrap.01": "سَنْتِيمِتْرٌ عَلَى الوَرَقِ، وَأَمْتَارٌ فِي الوَاقِعِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} مَعَ {أَهْلِكَ|أَهْلِكِ} خَرِيطَةً لِشَارِعِكُمْ بِمِقْيَاسِ سَنْتِيمِتْرٍ لِكُلِّ ثَلَاثَةِ أَمْتَارٍ، {وَاكْتُبِ|وَاكْتُبِي} الوَحْدَةَ مَعَ كُلِّ طُولٍ."
  ]
