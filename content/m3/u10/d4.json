 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ قِيَاسٍ وَوَرَقُ مُرَبَّعَاتٍ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "rm.01": "مَشْرُوعُ خَرِيطَةِ غُرْفَتِي: غُرْفَةٌ تِسْعَةُ أَمْتَارٍ فِي سِتَّةٍ، نَرْسُمُهَا بِمِقْيَاسِ سَنْتِيمِتْرٍ لِكُلِّ ثَلَاثَةِ أَمْتَارٍ: ثَلَاثَةُ سَنْتِيمِتْرَاتٍ فِي اثْنَيْنِ.",
  "rm.02": "وَالسَّجَّادَةُ ثَلَاثَةُ أَمْتَارٍ فِي ثَلَاثَةٍ: سَنْتِيمِتْرٌ فِي سَنْتِيمِتْرٍ. وَالرَّفُّ سِتَّةُ أَمْتَارٍ: سَنْتِيمِتْرَانِ.",
  "rm.03": "ثُمَّ نَقِيسُ عَلَى الوَرَقِ مِنَ البَابِ إِلَى السَّجَّادَةِ: سَنْتِيمِتْرَانِ، فَالمَسَافَةُ الحَقِيقِيَّةُ سِتَّةُ أَمْتَارٍ.",
  "tb.01": "جَدْوَلُ المَشْرُوعِ: العُنْصُرُ، وَطُولُهُ الحَقِيقِيُّ بِالمِتْرِ، وَطُولُهُ عَلَى الوَرَقِ بِالسَّنْتِيمِتْرِ.",
  "tb.02": "وَلِلْإِبْدَاعِ: {اُرْسُمْ|اُرْسُمِي} خَرِيطَةَ {مَدِينَتِكَ|مَدِينَتِكِ} بِمِقْيَاسِ سَنْتِيمِتْرٍ لِكُلِّ عَشَرَةِ أَمْتَارٍ، {وَانْظُرْ|وَانْظُرِي} كَيْفَ تَقْصُرُ الأَطْوَالُ عَلَى الوَرَقِ.",
  "mat.01": "{قِسْ|قِيسِي} {غُرْفَتَكَ|غُرْفَتَكِ} بِشَرِيطِ القِيَاسِ، {وَقَرِّبْ|وَقَرِّبِي} أَطْوَالَهَا إِلَى أَمْتَارٍ تَنْقَسِمُ عَلَى المِقْيَاسِ، ثُمَّ {اُرْسُمْهَا|اُرْسُمِيهَا} عَلَى وَرَقِ المُرَبَّعَاتِ {وَاكْتُبْ|وَاكْتُبِي} جَدْوَلَ أَطْوَالِهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "prj.intro": "نَرْسُمُ خَرِيطَةَ الغُرْفَةِ: أَبْعَادُهَا وَأَشْيَاؤُهَا بِالمِقْيَاسِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "اخْتَارَتْ فَوْضَى لِغُرْفَتِهَا طُولًا ثَمَانِيَةَ أَمْتَارٍ، فَلَمْ تَجِدْ طُولَهَا عَلَى الوَرَقِ عَدَدًا صَحِيحًا. مَا الحَلُّ؟",
  "pr.r1a": "نَخْتَارُ أَطْوَالًا تَنْقَسِمُ عَلَى ثَلَاثَةٍ: سِتَّةً أَوْ تِسْعَةً.",
  "pr.r1b": "نَرْسُمُ الغُرْفَةَ بِطُولِهَا الحَقِيقِيِّ عَلَى الوَرَقِ.",
  "pr.r1c": "نَطْرَحُ ثَلَاثَةً مِنْ كُلِّ طُولٍ دَائِمًا.",
  "ch.find": "قَالَتْ فَوْضَى: نَرْسُمُ الغُرْفَةَ بِضَرْبِ بُعْدَيْهَا فِي ثَلَاثَةٍ. مَا بُعْدَاهَا عَلَى الوَرَقِ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! مِنَ الوَاقِعِ إِلَى الوَرَقِ نَقْسِمُ."
  ],
  "ch.right": "نَقْسِمُ كُلَّ بُعْدٍ عَلَى ثَلَاثَةٍ.",
  "ch.wrong": [
   "chaos",
   "نَضْرِبُ فِي ثَلَاثَةٍ."
  ],
  "ms.1": "كَيْفَ نَعْرِفُ طُولًا حَقِيقِيًّا مِنَ الخَرِيطَةِ؟",
  "ms.1a": "نَقِيسُهُ، ثُمَّ نَضْرِبُ فِي أَمْتَارِ المِقْيَاسِ.",
  "ms.1b": "نَقِيسُهُ، ثُمَّ نَكْتُبُهُ بِالمِتْرِ كَمَا هُوَ.",
  "ms.1c": "نَقِيسُهُ، ثُمَّ نَقْسِمُ عَلَى أَمْتَارِ المِقْيَاسِ.",
  "ms.recall": "نَتَذَكَّرُ: نَقِيسُ عَلَى الخَرِيطَةِ وَنَضْرِبُ لِلْوَاقِعِ، وَنَقْسِمُ الحَقِيقِيَّ لِنَرْسُمَ، وَنَكْتُبُ الوَحْدَةَ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} خَرِيطَةَ الغُرْفَةِ!",
  "wrap.01": "خَرِيطَةٌ صَغِيرَةٌ لِغُرْفَةٍ كَبِيرَةٍ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَكْمِلْ|أَكْمِلِي} خَرِيطَةَ {غُرْفَتِكَ|غُرْفَتِكِ} بِأَشْيَائِهَا، {وَاعْرِضْهَا|وَاعْرِضِيهَا} عَلَى {أَهْلِكَ|أَهْلِكِ}، {وَاسْأَلْهُمْ|وَاسْأَلِيهِمْ}: كَمِ المَسَافَةُ الحَقِيقِيَّةُ مِنَ البَابِ إِلَى النَّافِذَةِ؟"
  ]
 },
