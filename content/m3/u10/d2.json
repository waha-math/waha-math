  "ask": "bag.ask",
  "adult": "ورق مربعات وورق شفّاف.",
  "screenPath": "على الشاشة يكبّر الطفل مستطيلاً من ركنه على الشبكة، ويحسب أبعاد المكبَّر ومساحته."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagTracing": "وَرَقٌ شَفَّافٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَوَرَقٌ شَفَّافٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "ضَاعَفْتُ أَضْلَاعَ المُثَلَّثِ، فَتَضَاعَفَتْ مِسَاحَتُهُ: أَرْبَعَةُ مُرَبَّعَاتٍ!"
  ],
  "hk.02": "نَعُدُّ: الصَّغِيرُ مُرَبَّعَانِ، وَالكَبِيرُ أَرْبَعُ نُسَخٍ مِنْهُ، ثَمَانِيَةُ مُرَبَّعَاتٍ: أَرْبَعَةُ أَضْعَافٍ، لَا ضِعْفَانِ.",
  "sq.01": "مُرَبَّعٌ ضِلْعُهُ اثْنَانِ، نُكَبِّرُهُ بِمُعَامِلِ اثْنَيْنِ: ضِلْعُهُ أَرْبَعَةٌ. تَضَاعَفَتِ الأَضْلَاعُ، وَبَقِيَتِ الزَّوَايَا قَائِمَةً.",
  "sq.02": "وَنَعُدُّ: الصَّغِيرُ أَرْبَعَةُ مُرَبَّعَاتٍ، وَالكَبِيرُ سِتَّةَ عَشَرَ. اثْنَانِ فِي اثْنَيْنِ أَرْبَعَةٌ، وَأَرْبَعَةٌ فِي أَرْبَعَةٍ سِتَّةَ عَشَرَ.",
  "tr.01": "نُكَبِّرُ مُثَلَّثًا بِمُعَامِلِ ثَلَاثَةٍ: أَضْلَاعُهُ ثَلَاثَةُ أَضْعَافٍ، وَمِسَاحَتُهُ تِسْعُ نُسَخٍ مِنْهُ: ثَلَاثَةٌ فِي ثَلَاثَةٍ.",
  "tr.02": "وَبِالوَرَقِ الشَّفَّافِ: زَوَايَا الكَبِيرِ هِيَ زَوَايَا الصَّغِيرِ نَفْسُهَا.",
  "rl.01": "القَاعِدَةُ: المُعَامِلُ يَضْرِبُ الأَطْوَالَ، وَمُرَبَّعُهُ يَضْرِبُ المِسَاحَاتِ.",
  "rl.02": "وَالتَّكْبِيرُ غَيْرُ التَّطَابُقِ: المُتَطَابِقَانِ بِالمَقَاسِ نَفْسِهِ، وَالمُكَبَّرُ مَقَاسُهُ أَكْبَرُ وَزَوَايَاهُ نَفْسُهَا.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ مُثَلَّثًا صَغِيرًا، ثُمَّ {كَبِّرْهُ|كَبِّرِيهِ} بِمُضَاعَفَةِ كُلِّ أَضْلَاعِهِ، {وَضَعِ|وَضَعِي} الوَرَقَ الشَّفَّافَ عَلَى زَوَايَاهُمَا {وَقَارِنْ|وَقَارِنِي}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: عَدَسَةُ المُكَبِّرِ! {كَبِّرِ|كَبِّرِي} المُسْتَطِيلَ مِنْ رُكْنِهِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَ طَالِبٌ: التَّكْبِيرُ بِمُعَامِلِ اثْنَيْنِ يُضَاعِفُ المِسَاحَةَ مَرَّتَيْنِ. مَا خَطَؤُهُ؟",
  "pr.r1a": "المِسَاحَةُ تُضْرَبُ فِي اثْنَيْنِ فِي اثْنَيْنِ: أَرْبَعَةُ أَضْعَافٍ.",
  "pr.r1b": "لَا خَطَأَ: المِسَاحَةُ تُضْرَبُ فِي المُعَامِلِ نَفْسِهِ.",
  "pr.r1c": "المِسَاحَةُ لَا تَتَغَيَّرُ حِينَ نُكَبِّرُ.",
  "ch.find": "قَالَتْ فَوْضَى: ضَاعَفْتُ أَضْلَاعَ المُسْتَطِيلِ، فَتَضَاعَفَتْ مِسَاحَتُهُ مَرَّتَيْنِ. كَمْ مِسَاحَتُهُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! أَرْبَعُ نُسَخٍ لَا اثْنَتَانِ."
  ],
  "ch.right": "المِسَاحَةُ فِي مُرَبَّعِ المُعَامِلِ.",
  "ch.wrong": [
   "chaos",
   "المِسَاحَةُ فِي المُعَامِلِ."
  ],
  "ms.1": "لِمَاذَا تُضْرَبُ المِسَاحَةُ فِي أَرْبَعَةٍ حِينَ نُكَبِّرُ بِمُعَامِلِ اثْنَيْنِ؟",
  "ms.1a": "الطُّولُ وَالعَرْضُ يُضْرَبَانِ فِي اثْنَيْنِ.",
  "ms.1b": "لِأَنَّ لِلْمُسْتَطِيلِ أَرْبَعَةَ أَضْلَاعٍ وَأَرْبَعَ زَوَايَا.",
  "ms.1c": "لِأَنَّنَا نُضِيفُ أَرْبَعَةَ مُرَبَّعَاتٍ إِلَى المِسَاحَةِ.",
  "ms.recall": "نَتَذَكَّرُ: المُعَامِلُ يَضْرِبُ كُلَّ ضِلْعٍ، وَمُرَبَّعُهُ يَضْرِبُ المِسَاحَةَ، وَالزَّوَايَا لَا تَتَغَيَّرُ.",
  "ms.x1": "كَبَّرْنَا مُثَلَّثًا بِمُعَامِلِ ثَلَاثَةٍ. مَاذَا حَدَثَ لِزَوَايَاهُ؟",
  "ms.x1a": "بَقِيَتْ كَمَا هِيَ: التَّكْبِيرُ لِلْأَطْوَالِ.",
  "ms.x1b": "ضُرِبَتْ فِي ثَلَاثَةٍ، كَمَا ضُرِبَتِ الأَضْلَاعُ.",
  "ms.x1c": "ضُرِبَتْ فِي تِسْعَةٍ، كَمَا ضُرِبَتِ المِسَاحَةُ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} التَّكْبِيرَ!",
  "wrap.01": "الأَطْوَالُ فِي المُعَامِلِ، وَالمِسَاحَةُ فِي مُرَبَّعِهِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {كَبِّرْ|كَبِّرِي} رَسْمًا صَغِيرًا عَلَى وَرَقِ المُرَبَّعَاتِ بِمُعَامِلِ اثْنَيْنِ، {وَعُدَّ|وَعُدِّي} مُرَبَّعَاتِ الرَّسْمَيْنِ مَعَ {أَهْلِكَ|أَهْلِكِ}."
  ]
 },
