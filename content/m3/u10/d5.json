  "screenPath": "أسئلة الوحدة على الشاشة: النسب المتكافئة، والتكبير ومساحته، ومقياس الرسم في الاتجاهين."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المِقْيَاسِ أَخْطَاءُ فَوْضَى: نِسَبٌ بِالطَّرْحِ، وَمِسَاحَةٌ تَتَضَاعَفُ مَعَ المُعَامِلِ، وَمِقْيَاسٌ بِالجَمْعِ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {خَبِيرِ|خَبِيرَةِ} المِقْيَاسِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ الحَادِي عَشَرَ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ مُرَبَّعًا {وَكَبِّرْهُ|وَكَبِّرِيهِ}، {وَقِسْ|وَقِيسِي} بِالمِسْطَرَةِ ضِلْعَيْهِمَا، {وَعُدَّ|وَعُدِّي} مُرَبَّعَاتِهِمَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: النِّسْبَةُ تَبْقَى بِضَرْبِ الطَّرَفَيْنِ، وَالمُعَامِلُ يَضْرِبُ الأَطْوَالَ وَمُرَبَّعُهُ المِسَاحَةَ.",
  "rv.02": "وَالمِقْيَاسُ: نَضْرِبُ إِلَى الوَاقِعِ، وَنَقْسِمُ إِلَى الوَرَقِ، وَالوَحْدَةُ مَعَ كُلِّ طُولٍ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى المَقَايِيسِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.ratio": "قَالَتْ فَوْضَى: الفَرْقُ وَاحِدٌ، فَالنِّسْبَتَانِ مُتَكَافِئَتَانِ. هَلْ هُمَا مُتَكَافِئَتَانِ حَقًّا؟",
  "gm.area": "قَالَتْ فَوْضَى: المِسَاحَةُ تُضْرَبُ فِي المُعَامِلِ. {صَحِّحْ|صَحِّحِي}: شَكْلٌ مِسَاحَتُهُ",
  "gm.scale": "جَمَعَتْ فَوْضَى المِقْيَاسَ إِلَى الطُّولِ. {صَحِّحْ|صَحِّحِي}: خَطٌّ عَلَى الوَرَقِ طُولُهُ",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.11": "قَالَتْ فَوْضَى: كَبَّرْنَا المُرَبَّعَ بِمُعَامِلِ ثَلَاثَةٍ، فَصَارَتْ مِسَاحَتُهُ ثَلَاثَةَ أَضْعَافٍ. مَا خَطَؤُهَا؟",
  "ts.11a": "تُضْرَبُ فِي ثَلَاثَةٍ مَرَّتَيْنِ: تِسْعَةُ أَضْعَافٍ.",
  "ts.11b": "لَا خَطَأَ: المِسَاحَةُ تُضْرَبُ فِي المُعَامِلِ وَحْدَهُ.",
  "ts.11c": "المِسَاحَةُ لَا تَتَغَيَّرُ حِينَ نُكَبِّرُ.",
  "ts.12": "لِمَاذَا تَصِيرُ المِسَاحَةُ أَرْبَعَةَ أَضْعَافٍ إِذَا تَضَاعَفَ الضِّلْعُ؟",
  "ts.12a": "الطُّولُ فِي اثْنَيْنِ وَالعَرْضُ فِي اثْنَيْنِ.",
  "ts.12b": "لِأَنَّ عَدَدَ أَضْلَاعِ المُرَبَّعِ أَرْبَعَةٌ.",
  "ts.12c": "لِأَنَّنَا نُضِيفُ إِلَيْهِ أَرْبَعَةَ مُرَبَّعَاتٍ.",
  "ts.rem": "نَعُودُ إِلَى الوَصَفَاتِ بِالكُوبِ، وَتَكْبِيرِ الرُّسُومِ عَلَى الشَّبَكَةِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ الحَادِي عَشَرَ."
  ],
  "ts.win1": "{أَنْتَ خَبِيرُ|أَنْتِ خَبِيرَةُ} المِقْيَاسِ!",
  "ts.win2": "{وَجَدْتَ|وَجَدْتِ} النِّسَبَ، {وَكَبَّرْتَ|وَكَبَّرْتِ} الأَشْكَالَ، {وَرَسَمْتَ|وَرَسَمْتِ} بِالمِقْيَاسِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {خَبِيرِ|خَبِيرَةِ} المِقْيَاسِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُطْبُخْ|اُطْبُخِي} مَعَ {أَهْلِكَ|أَهْلِكِ} وَصْفَةً بِالنِّسْبَةِ: إِذَا كُنَّا أَرْبَعَةً، كَمْ نَحْتَاجُ مِنَ الأَرُزِّ لِثَمَانِيَةٍ؟"
  ]
 },
