 "title": "النِّسَبُ المُتَكَافِئَةُ",
 "icon": [
  "raicon"
 ],
 "concepts": {
  "C324": "النسبة «لكل 2 من الأول 6 من الثاني» والنسب المتكافئة بضرب الطرفين أو قسمتهما على العدد نفسه، بالجدول، وربطها بالكسور المتكافئة (استدعاء C225)"
 },
