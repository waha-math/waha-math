 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagPens": "أَقْلَامُ تَلْوِينٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَأَقْلَامُ تَلْوِينٍ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "صَنَعْتُ عَصِيرَيْنِ: كُوبَانِ مِنَ المَاءِ بِسِتِّ مَلَاعِقَ، وَكُوبٌ بِثَلَاثِ مَلَاعِقَ. الطَّعْمُ نَفْسُهُ!"
  ],
  "hk.02": "نَتَحَقَّقُ: فِي العَصِيرَيْنِ لِكُلِّ كُوبٍ ثَلَاثُ مَلَاعِقَ، فَالطَّعْمُ نَفْسُهُ حَقًّا. صَدَقَتْ فَوْضَى هَذِهِ المَرَّةَ!",
  "rs.01": "النِّسْبَةُ اثْنَانِ إِلَى سِتَّةٍ تَعْنِي: لِكُلِّ اثْنَيْنِ مِنَ الأَوَّلِ سِتَّةٌ مِنَ الثَّانِي.",
  "rs.02": "نَقْسِمُ الطَّرَفَيْنِ عَلَى اثْنَيْنِ: وَاحِدٌ إِلَى ثَلَاثَةٍ، نِسْبَةٌ مُتَكَافِئَةٌ.",
  "rs.03": "وَنَضْرِبُ الطَّرَفَيْنِ فِي اثْنَيْنِ: أَرْبَعَةٌ إِلَى اثْنَيْ عَشَرَ. كُلُّهَا مُتَكَافِئَةٌ لِأَنَّنَا ضَرَبْنَا الطَّرَفَيْنِ أَوْ قَسَمْنَاهُمَا عَلَى العَدَدِ نَفْسِهِ.",
  "tb.01": "نَكْتُبُ جَدْوَلًا: كُوبٌ بِثَلَاثِ مَلَاعِقَ، وَكُوبَانِ بِسِتٍّ، وَثَلَاثَةٌ بِتِسْعٍ، وَأَرْبَعَةٌ بِاثْنَتَيْ عَشْرَةَ.",
  "tb.02": "كُلُّ عَمُودٍ نِسْبَةٌ تُكَافِئُ الأُولَى: ضَرَبْنَا الطَّرَفَيْنِ فِي العَدَدِ نَفْسِهِ.",
  "fr.01": "وَالنِّسَبُ تَتَكَافَأُ كَمَا تَتَكَافَأُ الكُسُورُ: ثُلُثٌ، وَسُدُسَانِ، وَأَرْبَعَةُ أَجْزَاءٍ مِنِ اثْنَيْ عَشَرَ، شَيْءٌ وَاحِدٌ.",
  "fr.02": "وَكَذَلِكَ وَاحِدٌ إِلَى ثَلَاثَةٍ، وَاثْنَانِ إِلَى سِتَّةٍ، وَأَرْبَعَةٌ إِلَى اثْنَيْ عَشَرَ: نَضْرِبُ الطَّرَفَيْنِ فِي العَدَدِ نَفْسِهِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ جَدْوَلًا: صَفٌّ لِلْأَكْوَابِ وَصَفٌّ لِلْمَلَاعِقِ، {وَامْلَأْهُ|وَامْلَئِيهِ} بِأَقْلَامِ التَّلْوِينِ بِنِسَبٍ مُتَكَافِئَةٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: وَصْفَةُ الفِرْقَةِ! الفِرْقَةُ تَكْبُرُ، وَالنِّسْبَةُ تَبْقَى. كَمْ تَحْتَاجُ؟",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: اثْنَانِ إِلَى سِتَّةٍ تُكَافِئُ اثْنَيْنِ إِلَى ثَلَاثَةٍ، لِأَنَّ سِتَّةً نَاقِصُ ثَلَاثَةٍ ثَلَاثَةٌ. مَا خَطَؤُهَا؟",
  "pr.r1a": "الطَّرْحُ لَا يَحْفَظُ النِّسْبَةَ: الصَّحِيحُ وَاحِدٌ إِلَى ثَلَاثَةٍ.",
  "pr.r1b": "لَا خَطَأَ: نَطْرَحُ مِنْ أَحَدِ الطَّرَفَيْنِ مَا نَشَاءُ، وَتَبْقَى النِّسْبَةُ.",
  "pr.r1c": "الصَّحِيحُ أَنْ نَطْرَحَ الثَّلَاثَةَ مِنَ الطَّرَفَيْنِ مَعًا.",
  "ch.find": "قَالَتْ فَوْضَى: ثَلَاثَةٌ إِلَى سِتَّةٍ تُكَافِئُ وَاحِدًا إِلَى أَرْبَعَةٍ، فَالفَرْقُ ثَلَاثَةٌ فِيهِمَا. هَلْ هُمَا مُتَكَافِئَتَانِ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! الفَرْقُ لَا يَكْفِي، نَضْرِبُ."
  ],
  "ch.right": "نَضْرِبُ الطَّرَفَيْنِ فِي العَدَدِ نَفْسِهِ.",
  "ch.wrong": [
   "chaos",
   "الفَرْقُ يَكْفِي."
  ],
  "ms.1": "خَلَطْنَا ثَلَاثَ عُلَبٍ زَرْقَاءَ بِعُلْبَتَيْنِ بَيْضَاوَيْنِ. لِنَصْنَعَ اللَّوْنَ نَفْسَهُ بِكَمِّيَّةٍ أَكْبَرَ، لِمَاذَا نَضْرِبُ العَدَدَيْنِ كِلَيْهِمَا فِي العَدَدِ نَفْسِهِ؟",
  "ms.1a": "حَتَّى يَبْقَى لِكُلِّ ثَلَاثِ عُلَبٍ زَرْقَاءَ عُلْبَتَانِ بَيْضَاوَانِ.",
  "ms.1b": "حَتَّى يَزِيدَ العَدَدَانِ بِالمِقْدَارِ نَفْسِهِ، فَيَتَسَاوَى مَا أَضَفْنَاهُ.",
  "ms.1c": "حَتَّى يَكْبُرَ الأَزْرَقُ وَحْدَهُ، فَالأَبْيَضُ لَا يُغَيِّرُ اللَّوْنَ.",
  "ms.recall": "نَتَذَكَّرُ: النِّسَبُ المُتَكَافِئَةُ نَضْرِبُ طَرَفَيْهَا أَوْ نَقْسِمُهُمَا عَلَى العَدَدِ نَفْسِهِ، وَلَا نَجْمَعُ وَلَا نَطْرَحُ.",
  "ms.x1": "عَصِيرٌ: كُوبُ بُرْتُقَالٍ لِكُلِّ كُوبَيْ مَاءٍ. ضَاعَفْنَا البُرْتُقَالَ. مَاذَا نَفْعَلُ بِالمَاءِ؟",
  "ms.x1a": "نُضَاعِفُهُ أَيْضًا، فَيَبْقَى الطَّعْمُ نَفْسُهُ.",
  "ms.x1b": "نُضِيفُ إِلَيْهِ كُوبًا وَاحِدًا، كَمَا أَضَفْنَا إِلَى البُرْتُقَالِ.",
  "ms.x1c": "نَتْرُكُهُ كَمَا هُوَ، فَالمَاءُ لَا يُغَيِّرُ الطَّعْمَ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} النِّسَبَ المُتَكَافِئَةَ!",
  "wrap.01": "نَضْرِبُ الطَّرَفَيْنِ، فَتَبْقَى النِّسْبَةُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: فِي شَمْسِ العَصْرِ {قِفْ أَنْتَ|قِفِي أَنْتِ} وَأَحَدُ {أَهْلِكَ|أَهْلِكِ} فِي الدَّقِيقَةِ نَفْسِهَا، {وَقِسْ|وَقِيسِي} طُولَ كُلٍّ مِنْكُمَا وَطُولَ ظِلِّهِ، {وَاكْتُبِ|وَاكْتُبِي} النِّسْبَتَيْنِ فِي جَدْوَلٍ: هَلْ هُمَا مُتَكَافِئَتَانِ تَقْرِيبًا؟ ثُمَّ {قِسْ|قِيسِي} ظِلَّ عَمُودٍ أَوْ شَجَرَةٍ، {وَقَدِّرْ|وَقَدِّرِي} طُولَهَا بِالنِّسْبَةِ نَفْسِهَا."
  ]
 },
