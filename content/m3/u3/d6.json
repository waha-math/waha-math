 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ الارْتِفَاعِ أَخْطَاءُ فَوْضَى: ضِلْعٌ مَائِلٌ مَكَانَ الارْتِفَاعِ، وَمُثَلَّثٌ بِلَا قِسْمَةٍ عَلَى اثْنَيْنِ، وَارْتِفَاعُ مُنْفَرِجٍ دَاخِلَهُ.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {بَنَّاءِ|بَنَّاءَةِ} الارْتِفَاعِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ الرَّابِعِ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} مُثَلَّثًا وَارْتِفَاعَهُ بِالمِسْطَرَةِ، {وَاحْسُبْ|وَاحْسُبِي} مِسَاحَتَهُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المَسَافَةُ إِلَى المُسْتَقِيمِ عَمُودٌ، وَالارْتِفَاعُ عَمُودٌ عَلَى القَاعِدَةِ أَوِ امْتِدَادِهَا.",
  "rv.02": "وَمُتَوَازِي الأَضْلَاعِ القَاعِدَةُ فِي الارْتِفَاعِ، وَالمُثَلَّثُ نِصْفُهُ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى الارْتِفَاعَاتِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.slant": "ضَرَبَتْ فَوْضَى الضِّلْعَ المَائِلَ فِي القَاعِدَةِ. كَمِ المِسَاحَةُ حَقًّا؟",
  "gm.half": "نَسِيَتْ فَوْضَى القِسْمَةَ عَلَى اثْنَيْنِ. كَمْ مِسَاحَةُ المُثَلَّثِ حَقًّا؟",
  "gm.out": "رَسَمَتْ فَوْضَى ارْتِفَاعَ المُنْفَرِجِ دَاخِلَهُ. أَيُّ القِطَعِ هِيَ الارْتِفَاعُ حَقًّا؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.10": "حَسَبَتْ فَوْضَى المِسَاحَةَ بِالضِّلْعِ المَائِلِ. مَا خَطَؤُهَا؟",
  "ts.10a": "المِسَاحَةُ بِالارْتِفَاعِ العَمُودِيِّ، لَا بِالمَائِلِ.",
  "ts.10b": "لَا خَطَأَ: كُلُّ ضِلْعٍ يَصْلُحُ ارْتِفَاعًا لِلْمُثَلَّثِ.",
  "ts.10c": "كَانَ عَلَيْهَا أَنْ تَجْمَعَ أَطْوَالَ الأَضْلَاعِ الثَّلَاثَةِ.",
  "ts.12": "{أَقْنِعْنِي|أَقْنِعِينِي} بِسَبَبَيْنِ: مِسَاحَةُ مُتَوَازِي الأَضْلَاعِ القَاعِدَةُ فِي الارْتِفَاعِ. {اِلْمِسِ|اِلْمِسِي} البِطَاقَتَيْنِ الصَّحِيحَتَيْنِ، ثُمَّ «تَمَّ».",
  "ts.12a": "قَصَصْتُ مُثَلَّثًا مِنْ طَرَفِهِ وَأَلْصَقْتُهُ بِالطَّرَفِ الآخَرِ، فَصَارَ مُسْتَطِيلًا.",
  "ts.12b": "قَطَعَهُ قُطْرُهُ مُثَلَّثَيْنِ، مِسَاحَةُ كُلٍّ مِنْهُمَا نِصْفُ القَاعِدَةِ فِي الارْتِفَاعِ.",
  "ts.12c": "ضَرَبْتُ ضِلْعَيْهِ المُتَجَاوِرَيْنِ، فَخَرَجَتِ المِسَاحَةُ نَفْسُهَا.",
  "ts.11": "قِطْعَةُ أَرْضٍ عَلَى شَكْلِ مُتَوَازِي أَضْلَاعٍ قَسَمَهَا قُطْرٌ. كَمْ مِسَاحَةُ أَحَدِ المُثَلَّثَيْنِ؟",
  "ts.rem": "نَعُدُّ المُرَبَّعَاتِ عَلَى الشَّبَكَةِ مَعَ الكِبَارِ، وَنَقُصُّ المُثَلَّثَ وَنَنْسَخُهُ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ الرَّابِعِ."
  ],
  "ts.win1": "{أَنْتَ بَنَّاءُ|أَنْتِ بَنَّاءَةُ} الارْتِفَاعِ!",
  "ts.win2": "{وَجَدْتَ|وَجَدْتِ} الارْتِفَاعَ دَاخِلًا وَخَارِجًا، {وَحَسَبْتَ|وَحَسَبْتِ} المِسَاحَاتِ، {وَعَلَّلْتَ|وَعَلَّلْتِ}.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {بَنَّاءِ|بَنَّاءَةِ} الارْتِفَاعِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِقْطَعْ|اِقْطَعِي} مَعَ {أَهْلِكَ|أَهْلِكِ} شَرِيحَةَ خُبْزٍ مِنْ رُكْنٍ إِلَى رُكْنٍ، {وَاحْسُبْ|وَاحْسُبِي} مِسَاحَةَ المُثَلَّثِ."
  ]
 },
