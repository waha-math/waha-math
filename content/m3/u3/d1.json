{
 "id": "m3.u3.d1",
 "title": "أَقْصَرُ طَرِيقٍ إِلَى المُسْتَقِيمِ",
 "icon": [
  "heighticon"
 ],
 "concepts": {
  "C126": "أقصر مسافة من نقطة إلى مستقيم: طول العمود النازل منها عليه، ومدّ المستقيم حين تقع القدم خارج القطعة"
 },
 "bag": {
  "items": [
   {
    "icon": "thread",
    "label": "bagThread"
   },
   {
    "icon": "ruler",
    "label": "bagRuler"
   }
  ],
  "ask": "bag.ask",
  "adult": "خيط ومسطرة وورقة مرسوم عليها مستقيم.",
  "screenPath": "على الشاشة يحرّك الطفل المضخة حتى يقصر الأنبوب، ويختار القطعة التي هي المسافة."
 },
 "labels": {
  "bagThread": "خَيْطٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "home.back": "البَابُ الَّذِي {قِسْتَ|قِسْتِ} قُطْرَيْهِ مُسْتَطِيلٌ أَوْ مَائِلٌ قَلِيلًا. وَاليَوْمَ نَسْأَلُ: إِذَا مَالَ المُسْتَطِيلُ، كَيْفَ نَقِيسُ ارْتِفَاعَهُ؟",
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "سَأَمُدُّ أُنْبُوبَ مَاءٍ مِنَ البِئْرِ إِلَى الطَّرِيقِ. كُلُّ نِقَاطِ الطَّرِيقِ تَبْعُدُ عَنِ البِئْرِ المَسَافَةَ نَفْسَهَا!"
  ],
  "hk.02": "نَشُدُّ خُيُوطًا وَنَقِيسُ: أَقْصَرُهَا الخَيْطُ النَّازِلُ عَمُودِيًّا إِلَى الطَّرِيقِ.",
  "pd.01": "هَذِهِ النُّقْطَةُ بَعِيدَةٌ عَنْ طَرَفِ القِطْعَةِ: نَمُدُّ المُسْتَقِيمَ بِالمِسْطَرَةِ.",
  "pd.02": "ثُمَّ نَرْسُمُ العَمُودَ: المَسَافَةُ مِنْ نُقْطَةٍ إِلَى مُسْتَقِيمٍ طُولُ العَمُودِ النَّازِلِ عَلَيْهِ.",
  "pd.03": "وَفِي المُتَوَازِيَيْنِ: كُلُّ عَمُودٍ بَيْنَهُمَا لَهُ الطُّولُ نَفْسُهُ.",
  "mat.01": "{شُدَّ|شُدِّي} الخَيْطَ مِنْ نُقْطَةٍ إِلَى مُسْتَقِيمٍ مَرْسُومٍ فِي أَمَاكِنَ مُخْتَلِفَةٍ، {وَقِسْهُ|وَقِيسِيهِ} بِالمِسْطَرَةِ: مَتَى يَكُونُ أَقْصَرَ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مِضَخَّةُ المَاءِ! {اِجْعَلِ|اِجْعَلِي} الأُنْبُوبَ أَقْصَرَ مَا يُمْكِنُ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: المَسَافَةُ مِنَ النُّقْطَةِ إِلَى المُسْتَقِيمِ أَيُّ قِطْعَةٍ تَصِلُهَا بِهِ. مَا الصَّحِيحُ؟",
  "pr.r1a": "المَسَافَةُ هِيَ العَمُودُ، فَهُوَ أَقْصَرُ القِطَعِ.",
  "pr.r1b": "صَدَقَتْ: كُلُّ قِطْعَةٍ تَصِلُهَا بِهِ مَسَافَةٌ صَحِيحَةٌ.",
  "pr.r1c": "المَسَافَةُ هِيَ القِطْعَةُ الَّتِي تَصِلُ إِلَى طَرَفِ القِطْعَةِ المَرْسُومَةِ.",
  "pr.r2": "أَيْنَ يَضَعُ المُزَارِعُ المِضَخَّةَ عَلَى النَّهْرِ المُسْتَقِيمِ لِيَكُونَ أُنْبُوبُهُ إِلَى البَيْتِ أَقْصَرَ؟",
  "pr.r2a": "عِنْدَ قَدَمِ العَمُودِ مِنَ البَيْتِ إِلَى النَّهْرِ.",
  "pr.r2b": "عِنْدَ أَبْعَدِ نُقْطَةٍ عَلَى النَّهْرِ.",
  "pr.r2c": "فِي أَيِّ مَكَانٍ، فَالأَطْوَالُ مُتَسَاوِيَةٌ.",
  "ch.find": "قَاسَتْ فَوْضَى المَسَافَةَ بِقِطْعَةٍ مَائِلَةٍ. أَيُّ القِطَعِ هِيَ المَسَافَةُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! العَمُودُ هُوَ الأَقْصَرُ، وَهُوَ المَسَافَةُ."
  ],
  "ch.right": "المَسَافَةُ طُولُ العَمُودِ.",
  "ch.wrong": [
   "chaos",
   "أَيُّ قِطْعَةٍ تَكْفِي."
  ],
  "ms.1": "قَارِبٌ فِي البَحْرِ، وَالشَّاطِئُ مُسْتَقِيمٌ: أَيُّ طَرِيقٍ نُسَمِّيهِ بُعْدَ القَارِبِ عَنِ الشَّاطِئِ؟",
  "ms.1a": "الطَّرِيقَ العَمُودِيَّ عَلَى الشَّاطِئِ، فَهُوَ أَقْصَرُ الطُّرُقِ إِلَيْهِ.",
  "ms.1b": "أَيَّ طَرِيقٍ مَائِلٍ، فَكُلُّ الطُّرُقِ تَصِلُ إِلَى الشَّاطِئِ فِي النِّهَايَةِ.",
  "ms.1c": "أَطْوَلَ طَرِيقٍ مَائِلٍ، فَهُوَ يَصِلُ إِلَى أَبْعَدِ نُقْطَةٍ عَلَى الشَّاطِئِ.",
  "ms.recall": "نَتَذَكَّرُ: نَضَعُ رُكْنَ الوَرَقَةِ القَائِمَ عَلَى المُسْتَقِيمِ، وَنُنْزِلُ مِنَ النُّقْطَةِ إِلَيْهِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} المَسَافَةَ إِلَى المُسْتَقِيمِ!",
  "wrap.01": "العَمُودُ أَقْصَرُ طَرِيقٍ إِلَى المُسْتَقِيمِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} بِالشَّرِيطِ أَقْصَرَ مَسَافَةٍ مِنْ رُكْنِ الطَّاوِلَةِ إِلَى الجِدَارِ، {وَاشْرَحْ|وَاشْرَحِي} لِأَحَدِ {أَهْلِكَ|أَهْلِكِ} لِمَاذَا هِيَ الأَقْصَرُ."
  ]
 },
