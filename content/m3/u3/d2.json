   }
  ],
  "ask": "bag.ask",
  "adult": "ورقة (ركنها زاوية قائمة) ومسطرة وقلم.",
  "screenPath": "على الشاشة ينزل الطفل خيط الرافعة عمودياً، ويختار الارتفاع بين ثلاث قطع."
 },
 "labels": {
  "bagPaper": "وَرَقَةٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "هَذَا الضِّلْعُ المَائِلُ ارْتِفَاعُ المُثَلَّثِ!"
  ],
  "hk.02": "أَيْنَ يَقِفُ الطَّوِيلُ فِي الصَّفِّ: مُسْتَقِيمًا أَمْ مَائِلًا؟ الارْتِفَاعُ عَمُودٌ.",
  "hs.01": "نَخْتَارُ ضِلْعًا قَاعِدَةً، وَمِنَ الرَّأْسِ المُقَابِلِ نَرْسُمُ عَمُودًا عَلَيْهَا: طُولُهُ ارْتِفَاعُ المُثَلَّثِ. وَفِي القَائِمِ: الارْتِفَاعُ ضِلْعُهُ.",
  "hs.02": "وَفِي المُنْفَرِجِ يَقَعُ العَمُودُ عَلَى هَذِهِ القَاعِدَةِ خَارِجَهَا: نَمُدُّهَا. وَلِلْمُنْفَرِجِ ارْتِفَاعَانِ خَارِجَهُ وَوَاحِدٌ دَاخِلَهُ.",
  "th.01": "لِكُلِّ مُثَلَّثٍ ثَلَاثَةُ ارْتِفَاعَاتٍ: مِنْ كُلِّ رَأْسٍ إِلَى الضِّلْعِ المُقَابِلِ. هَذَا مُثَلَّثٌ قَائِمٌ أَضْلَاعُهُ: سِتَّةٌ، وَثَمَانِيَةٌ، وَعَشَرَةٌ.",
  "th.02": "عَلَى قَاعِدَةِ الثَّمَانِيَةِ، الارْتِفَاعُ هُوَ ضِلْعُ السِّتَّةِ، وَعَلَى قَاعِدَةِ السِّتَّةِ هُوَ ضِلْعُ الثَّمَانِيَةِ.",
  "th.03": "وَعَلَى قَاعِدَةِ العَشَرَةِ: عَمُودٌ مِنَ الرَّأْسِ القَائِمِ، طُولُهُ أَرْبَعَةٌ وَثَمَانِيَةُ أَعْشَارٍ.",
  "hs.03": "وَلَوْ مَشَى الرَّأْسُ عَلَى خَطٍّ مُوَازٍ لِلْقَاعِدَةِ تَغَيَّرَ الشَّكْلُ، وَبَقِيَ الارْتِفَاعُ ثَابِتًا.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} مُثَلَّثًا عَلَى الوَرَقَةِ، {وَارْسُمِ|وَارْسُمِي} ارْتِفَاعَهُ بِرُكْنِ وَرَقَةٍ، {وَقِسْهُ|وَقِيسِيهِ} بِالمِسْطَرَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: رَافِعَةُ البِنَاءِ! {أَنْزِلِ|أَنْزِلِي} الخَيْطَ مِنَ الرَّأْسِ عَمُودِيًّا.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: الارْتِفَاعُ يَقَعُ دَائِمًا دَاخِلَ المُثَلَّثِ. مَا الصَّحِيحُ؟",
  "pr.r1a": "فِي المُنْفَرِجِ يَقَعُ خَارِجَهُ، بَعْدَ مَدِّ القَاعِدَةِ.",
  "pr.r1b": "صَدَقَتْ: العَمُودُ لَا يَخْرُجُ مِنَ المُثَلَّثِ.",
  "pr.r1c": "الارْتِفَاعُ هُوَ أَطْوَلُ أَضْلَاعِ المُثَلَّثِ.",
  "pr.r2": "كَمِ ارْتِفَاعًا لِلْمُثَلَّثِ؟",
  "pr.r2a": "ثَلَاثَةٌ: لِكُلِّ قَاعِدَةٍ ارْتِفَاعُهَا.",
  "pr.r2b": "وَاحِدٌ فَقَطْ، مِنَ الرَّأْسِ إِلَى أَسْفَلَ.",
  "pr.r2c": "اثْنَانِ، مِثْلَ القَائِمِ.",
  "ch.find": "تَقِيسُ فَوْضَى الارْتِفَاعَ بِضِلْعٍ مَائِلٍ. أَيُّ القِطَعِ هِيَ الارْتِفَاعُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! الارْتِفَاعُ عَمُودِيٌّ عَلَى القَاعِدَةِ، لَا مَائِلٌ."
  ],
  "ch.right": "الارْتِفَاعُ عَمُودٌ عَلَى القَاعِدَةِ.",
  "ch.wrong": [
   "chaos",
   "الضِّلْعُ المَائِلُ ارْتِفَاعٌ."
  ],
  "ms.1": "فِي هَذَا المُثَلَّثِ زَاوِيَةٌ مُنْفَرِجَةٌ عِنْدَ طَرَفِ القَاعِدَةِ السُّفْلَى. أَيْنَ يَقَعُ ارْتِفَاعُهُ عَلَى هَذِهِ القَاعِدَةِ؟",
  "ms.1a": "بَعْدَ طَرَفِ القَاعِدَةِ، فَنَمُدُّهَا حَتَّى يَصِلَ إِلَيْهَا العَمُودُ.",
  "ms.1b": "عِنْدَ مُنْتَصَفِ القَاعِدَةِ، فَالعَمُودُ يَنْزِلُ إِلَى الوَسَطِ.",
  "ms.1c": "عَلَى الضِّلْعِ المَائِلِ نَفْسِهِ، فَهُوَ ارْتِفَاعُ المُنْفَرِجِ.",
  "ms.recall": "نَتَذَكَّرُ: نَضَعُ رُكْنَ الوَرَقَةِ عَلَى القَاعِدَةِ أَوِ امْتِدَادِهَا، وَنُنْزِلُ مِنَ الرَّأْسِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} ارْتِفَاعَ المُثَلَّثِ!",
  "wrap.01": "الارْتِفَاعُ يَقِفُ مُسْتَقِيمًا، دَاخِلَ المُثَلَّثِ أَوْ خَارِجَهُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُطْلُبْ|اُطْلُبِي} مِنْ {أَهْلِكَ|أَهْلِكِ} مُثَلَّثًا وَرَقِيًّا، {وَارْسُمِ|وَارْسُمِي} ارْتِفَاعَاتِهِ بِرُكْنِ وَرَقَةٍ."
  ]
 },
