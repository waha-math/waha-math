{
 "id": "m3.u3.d2",
 "title": "ارْتِفَاعُ المُثَلَّثِ",
 "icon": [
  "heighticon"
 ],
 "concepts": {
  "C315": "ارتفاع المثلث: العمود من الرأس على القاعدة أو امتدادها، داخلياً أو خارجياً، ولكل قاعدة ارتفاعها"
 },
 "bag": {
  "items": [
   {
    "icon": "paper",
    "label": "bagPaper"
   },
   {
    "icon": "ruler",
