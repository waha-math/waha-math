    "label": "bagRuler"
   }
  ],
  "ask": "bag.ask",
  "adult": "علبة كرتونية فارغة ومسطرة.",
  "screenPath": "على الشاشة يحكم الطفل أمكعبٌ العلبة أم لا، من صورتها أو من أوجهها، ويجد الوجه المقابل المساوي."
 },
 "labels": {
  "bagBox": "عُلْبَةٌ كَرْتُونِيَّةٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُلْبَةٌ كَرْتُونِيَّةٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "هَذِهِ العُلْبَةُ مُكَعَّبٌ!"
  ],
  "hk.02": "هَلْ هِيَ مُكَعَّبٌ حَقًّا؟ نَقِيسُ أَطْوَالَهَا الثَّلَاثَةَ.",
  "bx.01": "أَطْوَالُهَا ثَمَانِيَةٌ وَسِتَّةٌ وَثَلَاثَةٌ، لَيْسَتْ مُتَسَاوِيَةً: فَلَيْسَتْ مُكَعَّبًا. هِيَ مُجَسَّمٌ أَوْجُهُهُ سِتَّةُ مُسْتَطِيلَاتٍ أَوْ مُرَبَّعَاتٍ، اسْمُهُ المَنْشُورُ المُسْتَطِيلُ، أَوْ مُتَوَازِي المُسْتَطِيلَاتِ.",
  "bx.02": "أَحْرُفُهُ الاثْنَا عَشَرَ: أَرْبَعَةٌ بِطُولِ ثَمَانِيَةٍ، وَأَرْبَعَةٌ بِطُولِ ثَلَاثَةٍ، وَأَرْبَعَةٌ بِطُولِ سِتَّةٍ.",
  "bx.03": "وَإِذَا تَسَاوَتِ الأَطْوَالُ الثَّلَاثَةُ صَارَ مُكَعَّبًا: فَالمُكَعَّبُ مَنْشُورٌ مُسْتَطِيلٌ أَحْرُفُهُ مُتَسَاوِيَةٌ.",
  "bx.04": "وَكُلُّ وَجْهَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ: نَقِيسُ زَوْجًا مِنْ كُلِّ لَوْنٍ لِنَتَحَقَّقَ.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ أَحْرُفَ العُلْبَةِ الكَرْتُونِيَّةِ، {وَقَارِنِ|وَقَارِنِي} الوَجْهَيْنِ المُتَقَابِلَيْنِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: العُلْبَةُ المَجْهُولَةُ! نَرَى أَوْجُهَهَا فَقَطْ: هَلْ هِيَ مُكَعَّبٌ؟",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَ طَالِبٌ: كُلُّ مَنْشُورٍ مُسْتَطِيلٍ مُكَعَّبٌ. مَا خَطَؤُهُ؟",
  "pr.r1a": "المُكَعَّبُ وَحْدَهُ تَتَسَاوَى أَحْرُفُهُ.",
  "pr.r1b": "لَا خَطَأَ: كُلُّ عُلْبَةٍ مُكَعَّبٌ مَهْمَا كَانَتْ أَطْوَالُهَا.",
  "pr.r1c": "المَنْشُورُ المُسْتَطِيلُ لَيْسَ لَهُ أَحْرُفٌ.",
  "pr.r2": "هَلِ المُكَعَّبُ مَنْشُورٌ مُسْتَطِيلٌ؟ لِمَاذَا؟",
  "pr.r2a": "نَعَمْ، أَوْجُهُهُ سِتَّةٌ وَأَحْرُفُهُ مُتَسَاوِيَةٌ.",
  "pr.r2b": "لَا، لِأَنَّ أَوْجُهَهُ مُرَبَّعَاتٌ لَا مُسْتَطِيلَاتٌ.",
  "pr.r2c": "لَا، لِأَنَّ المُكَعَّبَ لَيْسَ عُلْبَةً.",
  "ch.find": "قَالَتْ فَوْضَى: هَذِهِ العُلْبَةُ مُكَعَّبٌ. هَلْ هِيَ مُكَعَّبٌ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! أَطْوَالُهَا غَيْرُ مُتَسَاوِيَةٍ."
  ],
  "ch.right": "لَيْسَتْ مُكَعَّبًا: أَطْوَالُهَا مُخْتَلِفَةٌ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ عُلْبَةٍ مُكَعَّبٌ."
  ],
  "ms.1": "مَتَى يَكُونُ المَنْشُورُ المُسْتَطِيلُ مُكَعَّبًا؟",
  "ms.1a": "إِذَا تَسَاوَتْ أَطْوَالُ أَحْرُفِهِ الثَّلَاثَةُ.",
  "ms.1b": "إِذَا كَانَ لَهُ سِتَّةُ أَوْجُهٍ فَقَطْ مَهْمَا كَانَتْ.",
  "ms.1c": "إِذَا كَانَ وَجْهَاهُ المُتَقَابِلَانِ مُتَسَاوِيَيْنِ.",
  "ms.recall": "نَتَذَكَّرُ: نَقِيسُ الأَطْوَالَ الثَّلَاثَةَ؛ فَإِنْ تَسَاوَتْ فَهُوَ مُكَعَّبٌ، وَالمُتَقَابِلَانِ مُتَسَاوِيَانِ دَائِمًا.",
  "ms.x1": "مِسَاحَةُ الوَجْهِ الأَمَامِيِّ لِعُلْبَةٍ عِشْرُونَ. كَمْ مِسَاحَةُ الوَجْهِ الخَلْفِيِّ؟",
  "ms.x1a": "عِشْرُونَ: الوَجْهَانِ المُتَقَابِلَانِ مُتَسَاوِيَانِ.",
  "ms.x1b": "عَشَرَةٌ: الخَلْفِيُّ نِصْفُ الأَمَامِيِّ لِأَنَّهُ مَخْفِيٌّ.",
  "ms.x1c": "لَا نَعْرِفُ حَتَّى نَعُدَّ مُرَبَّعَاتِهِ المَخْفِيَّةَ وَاحِدًا وَاحِدًا.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} المَنْشُورَ المُسْتَطِيلَ!",
  "wrap.01": "كُلُّ مُكَعَّبٍ مَنْشُورٌ مُسْتَطِيلٌ، وَلَيْسَ كُلُّ مَنْشُورٍ مُكَعَّبًا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} ثَلَاثَةَ أَحْرُفٍ مُخْتَلِفَةٍ لِعُلْبَةٍ فِي المَطْبَخِ، {وَقُلْ|وَقُولِي} لِـ{أَهْلِكَ|أَهْلِكِ}: أَهِيَ مُكَعَّبٌ أَمْ لَا؟"
  ]
 },
