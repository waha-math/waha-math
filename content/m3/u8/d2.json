{
 "id": "m3.u8.d2",
 "title": "المَنْشُورُ المُسْتَطِيلُ",
 "icon": [
  "soicon"
 ],
 "concepts": {
  "C319": "المنشور المستطيل (متوازي المستطيلات): ستة أوجه مستطيلة، وأحرفه أربعة بكل طول من أطواله الثلاثة، والمكعب حالة خاصة منه بتساوي الأطوال، والأوجه المتقابلة متساوية (تفريغ تأجيل S1-U2)"
 },
 "bag": {
  "items": [
   {
    "icon": "box",
    "label": "bagBox"
   },
   {
