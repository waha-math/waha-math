 ],
 "concepts": {
  "C321": "مساحة السطح للمنشور المستطيل والمكعب: مجموع مساحات الأوجه الستة، وثلاثة أوجه × 2 بالتقابل، وبالسنتيمتر المربع أو المتر المربع بحسب الأبعاد (استدعاء C206 وC212)"
 },
