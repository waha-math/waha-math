 "labels": {
  "bagBox": "عُلْبَةٌ كَرْتُونِيَّةٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُلْبَةٌ كَرْتُونِيَّةٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "أُغَلِّفُ العُلْبَةَ بِهَذِهِ الوَرَقَةِ الصَّغِيرَةِ: تَكْفِي!"
  ],
  "hk.02": "الوَرَقَةُ ثَلَاثُونَ سَنْتِيمِتْرًا مُرَبَّعًا. هَلْ تَكْفِي حَقًّا؟ نَحْسُبُ أَوْجُهَ العُلْبَةِ أَوَّلًا.",
  "sa.01": "مِسَاحَةُ السَّطْحِ مَجْمُوعُ مِسَاحَاتِ الأَوْجُهِ السِّتَّةِ، وَكُلُّ وَجْهٍ مُسْتَطِيلٌ: الطُّولُ فِي العَرْضِ. وَكُلُّ وَجْهٍ يَتَكَرَّرُ فِي مُقَابِلِهِ.",
  "sa.02": "فَنَحْسُبُ ثَلَاثَةَ أَوْجُهٍ، وَنَضْرِبُ فِي اثْنَيْنِ: اثْنَانِ وَخَمْسُونَ سَنْتِيمِتْرًا مُرَبَّعًا، فَوَرَقَةُ فَوْضَى الصَّغِيرَةُ لَا تَكْفِي.",
  "sa.03": "وَإِذَا قِيسَتِ الأَبْعَادُ بِالمِتْرِ فَالمِسَاحَةُ بِالمِتْرِ المُرَبَّعِ: وَرَقٌ يَكْسُو صُنْدُوقًا مُكَعَّبًا مِنْ كُلِّ جِهَاتِهِ، حَرْفُهُ ثَلَاثَةُ أَمْتَارٍ: أَرْبَعَةٌ وَخَمْسُونَ مِتْرًا مُرَبَّعًا.",
  "mat.01": "{قِسْ|قِيسِي} أَحْرُفَ العُلْبَةِ الكَرْتُونِيَّةِ بِالمِسْطَرَةِ، {وَاحْسُبْ|وَاحْسُبِي} مِسَاحَةَ كُلِّ وَجْهٍ مُخْتَلِفٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مُغَلِّفُ المُجَسَّمَاتِ! أَيُّ وَرَقَةٍ تَكْفِي لِتَغْلِيفِ العُلْبَةِ كُلِّهَا؟",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: مِسَاحَةُ سَطْحِ مُكَعَّبٍ ضِلْعُهُ اثْنَانِ هِيَ اثْنَانِ فِي اثْنَيْنِ: أَرْبَعَةٌ. مَا خَطَؤُهَا؟",
  "pr.r1a": "حَسَبَتْ وَجْهًا وَاحِدًا، وَلِلْمُكَعَّبِ سِتَّةُ أَوْجُهٍ.",
  "pr.r1b": "لَا خَطَأَ: مِسَاحَةُ السَّطْحِ وَجْهٌ وَاحِدٌ.",
  "pr.r1c": "كَانَ عَلَيْهَا أَنْ تَضْرِبَ اثْنَيْنِ فِي ثَلَاثَةٍ.",
  "ch.find": "قَالَتْ فَوْضَى: مِسَاحَةُ سَطْحِ المُكَعَّبِ وَجْهٌ وَاحِدٌ. كَمْ هِيَ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! سِتَّةُ أَوْجُهٍ لَا وَجْهٌ."
  ],
  "ch.right": "سِتَّةُ أَوْجُهٍ مُتَسَاوِيَةٍ.",
  "ch.wrong": [
   "chaos",
   "وَجْهٌ وَاحِدٌ يَكْفِي."
  ],
  "ms.1": "لِمَاذَا نَضْرِبُ فِي اثْنَيْنِ فِي مِسَاحَةِ سَطْحِ العُلْبَةِ؟",
  "ms.1a": "كُلُّ وَجْهٍ يُسَاوِي الوَجْهَ المُقَابِلَ لَهُ.",
  "ms.1b": "لِأَنَّ لِلْعُلْبَةِ وَجْهَيْنِ فَقَطْ يُغَلَّفَانِ.",
  "ms.1c": "لِأَنَّنَا نُغَلِّفُ العُلْبَةَ مَرَّتَيْنِ.",
  "ms.recall": "نَتَذَكَّرُ: الوَرَقُ لِلْأَوْجُهِ: ثَلَاثَةُ أَوْجُهٍ مُخْتَلِفَةٍ، كُلٌّ فِي اثْنَيْنِ، ثُمَّ نَجْمَعُ.",
  "ms.x1": "لِعُلْبَةٍ ثَلَاثَةُ أَوْجُهٍ مُخْتَلِفَةٍ، مِسَاحَاتُهَا سِتَّةٌ وَثَمَانِيَةٌ وَاثْنَا عَشَرَ. كَيْفَ نَحْسُبُ وَرَقَهَا؟",
  "ms.x1a": "نَجْمَعُ الثَّلَاثَةَ، ثُمَّ نَضْرِبُ فِي اثْنَيْنِ.",
  "ms.x1b": "نَجْمَعُ الثَّلَاثَةَ، ثُمَّ نَضْرِبُ فِي سِتَّةٍ لِأَنَّ لَهَا سِتَّةَ أَوْجُهٍ.",
  "ms.x1c": "نَجْمَعُ الثَّلَاثَةَ وَنَكْتَفِي بِهَا: لِلْعُلْبَةِ ثَلَاثَةُ أَوْجُهٍ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} مِسَاحَةَ السَّطْحِ!",
  "wrap.01": "الحَجْمُ يَضْرِبُ، وَالسَّطْحُ يَجْمَعُ الأَوْجُهَ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} عُلْبَةَ عَصِيرٍ فَارِغَةً، {وَاحْسُبْ|وَاحْسُبِي} مِسَاحَةَ سَطْحِهَا، ثُمَّ يَقُصُّهَا الكَبِيرُ حَيْثُ {تُشِيرُ|تُشِيرِينَ} حَتَّى تَنْفَرِدَ شَبَكَةً، {وَصَوِّرْهَا|وَصَوِّرِيهَا} بِصَيْدِ الكَامِيرَا."
  ]
 },
