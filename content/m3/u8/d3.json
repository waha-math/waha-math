{
 "id": "m3.u8.d3",
 "title": "شَبَكَةُ المُجَسَّمِ",
 "icon": [
  "soicon"
 ],
 "concepts": {
  "C320": "شبكة المجسّم: الأوجه متصلة بأحرف تُطوى مجسّماً، وللمكعب شبكات مختلفة، وما لا يصلح (يتراكب وجهان أو ينفصل وجه)، والمتقابلان بينهما وجه"
 },
 "bag": {
  "items": [
   {
    "icon": "paper",
    "label": "bagCard"
   },
   {
    "icon": "scissors",
    "label": "bagScissors"
   }
  ],
  "ask": "bag.ask",
  "adult": "ورق مقوّى ومقص آمن ولاصق بإشرافكم.",
  "screenPath": "على الشاشة يحكم الطفل أتُطوى الشبكة مكعباً، ويختار الشبكة الصالحة، والشبكة التي تُطوى مجسّماً معيّناً."
 },
 "labels": {
  "bagCard": "وَرَقٌ مُقَوًّى",
  "bagScissors": "مِقَصٌّ آمِنٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقٌ مُقَوًّى وَمِقَصٌّ آمِنٌ مَعَ الكِبَارِ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "نَفْتَحُ العُلْبَةَ، فَتَبْقَى أَوْجُهُهَا كُلُّهَا مُتَّصِلَةً!"
  ],
  "hk.02": "لَكِنْ إِنْ قَصَصْنَا الأَحْرُفَ كُلَّهَا تَفَرَّقَتِ الأَوْجُهُ. نَقُصُّ أَحْرُفًا بِعَيْنِهَا فَقَطْ.",
  "nt.01": "الشَّبَكَةُ شَكْلٌ مُسَطَّحٌ: أَوْجُهُ المُجَسَّمِ مُتَّصِلَةٌ بِأَحْرُفٍ، تُطْوَى فَتَرْجِعُ مُجَسَّمًا.",
  "nt.02": "نَطْوِيهَا: كُلُّ وَجْهَيْنِ بِلَوْنٍ وَاحِدٍ يَتَقَابَلَانِ فِي المُكَعَّبِ، وَبَيْنَهُمَا وَجْهٌ فِي الشَّبَكَةِ.",
  "nt.03": "وَلِلْمُكَعَّبِ شَبَكَاتٌ مُخْتَلِفَةٌ: هَاتَانِ تُطْوَيَانِ مُكَعَّبًا وَاحِدًا.",
  "nt.04": "وَمَا لَا يَصْلُحُ: خَمْسَةٌ فِي صَفٍّ، أَوْ أَرْبَعَةٌ فِي مُرَبَّعٍ كَبِيرٍ، فَيَتَرَاكَبُ وَجْهَانِ عِنْدَ الطَّيِّ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى الوَرَقِ المُقَوَّى شَبَكَةَ مُكَعَّبٍ، {وَقُصَّهَا|وَقُصِّيهَا} بِالمِقَصِّ الآمِنِ مَعَ الكِبَارِ، {وَاطْوِهَا|وَاطْوِيهَا}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: المِفْتَاحُ المَطْوِيُّ! أَيُّ شَبَكَةٍ يُطْوَى مِنْهَا هَذَا المُجَسَّمُ؟",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: كُلُّ سِتَّةِ مُرَبَّعَاتٍ مُتَّصِلَةٍ تَصْلُحُ شَبَكَةً لِلْمُكَعَّبِ. مَا خَطَؤُهَا؟",
  "pr.r1a": "بَعْضُهَا يَتَرَاكَبُ فِيهِ وَجْهَانِ عِنْدَ الطَّيِّ.",
  "pr.r1b": "لَا خَطَأَ: سِتَّةُ مُرَبَّعَاتٍ تَصْنَعُ مُكَعَّبًا.",
  "pr.r1c": "المُكَعَّبُ يَحْتَاجُ ثَمَانِيَةَ مُرَبَّعَاتٍ لَا سِتَّةً.",
  "ch.find": "قَالَتْ فَوْضَى: هَذِهِ المُرَبَّعَاتُ السِّتَّةُ تُطْوَى مُكَعَّبًا. هَلْ تُطْوَى حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! يَتَرَاكَبُ وَجْهَانِ."
  ],
  "ch.right": "لَا تُطْوَى: يَتَرَاكَبُ وَجْهَانِ.",
  "ch.wrong": [
   "chaos",
   "سِتَّةُ مُرَبَّعَاتٍ تَكْفِي."
  ],
  "ms.1": "كَيْفَ نَتَحَقَّقُ أَنَّ الشَّبَكَةَ تُطْوَى مُكَعَّبًا؟",
  "ms.1a": "نَطْوِيهَا، فَلَا يَتَرَاكَبُ وَجْهَانِ وَلَا يَبْقَى فَرَاغٌ.",
  "ms.1b": "نَعُدُّ مُرَبَّعَاتِهَا فَقَطْ: سِتَّةُ مُرَبَّعَاتٍ مُتَّصِلَةٍ تَكْفِي.",
  "ms.1c": "نَتَأَكَّدُ أَنَّ مُرَبَّعَاتِهَا كُلَّهَا فِي صَفٍّ وَاحِدٍ.",
  "ms.recall": "نَتَذَكَّرُ: نَطْوِي وَنَتَحَقَّقُ، وَالوَجْهَانِ المُتَقَابِلَانِ بَيْنَهُمَا وَجْهٌ فِي الشَّبَكَةِ.",
  "ms.x1": "رَتَّبَ نَجَّارٌ سِتَّ قِطَعٍ مُرَبَّعَةٍ فِي صَفٍّ وَاحِدٍ، لِيَطْوِيَهَا صُنْدُوقًا مُكَعَّبًا. هَلْ تُطْوَى؟",
  "ms.x1a": "لَا: الطَّرَفَانِ يَتَرَاكَبَانِ، وَيَبْقَى وَجْهَانِ بِلَا غِطَاءٍ.",
  "ms.x1b": "نَعَمْ: سِتُّ قِطَعٍ مُتَّصِلَةٍ تَكْفِي لِأَيِّ مُكَعَّبٍ.",
  "ms.x1c": "نَعَمْ: إِذَا كَانَتِ القِطَعُ كُلُّهَا بِالحَجْمِ نَفْسِهِ تَمَامًا.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} شَبَكَةَ المُجَسَّمِ!",
  "wrap.01": "نَفْتَحُ المُجَسَّمَ شَبَكَةً، وَنَطْوِيهَا مُجَسَّمًا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} شَبَكَتَيْنِ مُخْتَلِفَتَيْنِ لِلْمُكَعَّبِ عَلَى وَرَقٍ، {وَاطْوِهِمَا|وَاطْوِيهِمَا} مَعَ {أَهْلِكَ|أَهْلِكِ}."
  ]
 },
