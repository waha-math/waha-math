 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُلْبَةٌ كَرْتُونِيَّةٌ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المُجَسَّمَاتِ أَخْطَاءُ فَوْضَى: مُكَعَّبٌ بِأَرْبَعَةِ أَوْجُهٍ، وَكُلُّ عُلْبَةٍ مُكَعَّبٌ، وَمِسَاحَةُ سَطْحِ مُكَعَّبٍ وَجْهٌ وَاحِدٌ، وَمَسْقَطٌ وَاحِدٌ يَكْفِي.",
  "hook.02": "مَنْ يُصَحِّحُهَا يَأْخُذُ شَارَةَ {بَنَّاءِ|بَنَّاءَةِ} المُجَسَّمَاتِ، وَيَجْرِي المَاءُ إِلَى البُسْتَانِ التَّاسِعِ.",
  "mat.01": "{عُدَّ|عُدِّي} أَوْجُهَ العُلْبَةِ الكَرْتُونِيَّةِ وَأَحْرُفَهَا، {وَقِسْهَا|وَقِيسِيهَا} بِالمِسْطَرَةِ، {وَانْظُرْ|وَانْظُرِي} إِلَيْهَا مِنَ الأَمَامِ وَالجَانِبِ وَالأَعْلَى. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: نَعُدُّ الظَّاهِرَ وَالمَخْفِيَّ، وَالمُكَعَّبُ مَنْشُورٌ مُسْتَطِيلٌ أَحْرُفُهُ مُتَسَاوِيَةٌ، وَالشَّبَكَةُ تُطْوَى بِلَا تَرَاكُبٍ.",
  "rv.02": "وَمِسَاحَةُ السَّطْحِ ثَلَاثَةُ أَوْجُهٍ فِي اثْنَيْنِ، وَالمَسْقَطُ صُورَةٌ مِنْ جِهَةٍ بِبُعْدَيْنِ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى المُجَسَّمَاتِ! {صَحِّحْ|صَحِّحِي} أَخْطَاءَهَا.",
  "gm.faces": "قَالَتْ فَوْضَى: لِلْمُكَعَّبِ أَرْبَعَةُ أَوْجُهٍ. كَمْ وَجْهًا لَهُ حَقًّا؟",
  "gm.edges": "قَالَتْ فَوْضَى: لِلْمُكَعَّبِ ثَمَانِيَةُ أَحْرُفٍ. كَمْ حَرْفًا لَهُ حَقًّا؟",
  "gm.cube": "قَالَتْ فَوْضَى: كُلُّ عُلْبَةٍ مُكَعَّبٌ. هَلْ هَذِهِ مُكَعَّبٌ؟",
  "gm.sa": "قَالَتْ فَوْضَى: مِسَاحَةُ سَطْحِ المُكَعَّبِ وَجْهٌ وَاحِدٌ. كَمْ هِيَ حَقًّا؟",
  "gm.view": "قَالَتْ فَوْضَى: مَسْقَطٌ وَاحِدٌ يَكْفِي. مَا المَسْقَطُ مِنَ الأَعْلَى؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.11": "قَالَ طَالِبٌ: مِسَاحَةُ سَطْحِ هَذِهِ العُلْبَةِ خَمْسَةٌ فِي اثْنَيْنِ فِي اثْنَيْنِ. مَا خَطَؤُهُ؟",
  "ts.11a": "ضَرَبَ الأَبْعَادَ الثَّلَاثَةَ، وَالسَّطْحُ مَجْمُوعُ سِتَّةِ أَوْجُهٍ.",
  "ts.11b": "لَا خَطَأَ: مِسَاحَةُ السَّطْحِ ضَرْبُ الأَبْعَادِ.",
  "ts.11c": "كَانَ عَلَيْهِ أَنْ يَجْمَعَ الأَبْعَادَ الثَّلَاثَةَ فَقَطْ.",
  "ts.12": "أَرْسَلَ صَدِيقٌ صُورَةَ عُلْبَةٍ مِنْ فَوْقِهَا فَقَطْ: مُرَبَّعٌ. هَلْ نَعْرِفُ أَنَّهَا مُكَعَّبٌ؟ لِمَاذَا؟",
  "ts.12a": "لَا: الصُّورَةُ مِنْ فَوْقٍ لَا تُرِينَا ارْتِفَاعَهَا.",
  "ts.12b": "نَعَمْ: إِذَا كَانَ المَسْقَطُ مُرَبَّعًا فَالعُلْبَةُ مُكَعَّبٌ.",
  "ts.12c": "نَعَمْ: الصُّورَةُ مِنْ فَوْقٍ تُرِينَا الأَوْجُهَ كُلَّهَا.",
  "ts.rem": "نَعُودُ إِلَى العُلَبِ الكَرْتُونِيَّةِ: نَقُصُّهَا مَعَ الكِبَارِ وَنَعُدُّ أَوْجُهَهَا، وَنُغَلِّفُ عُلْبَةً بِشَرِيطٍ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأُرْجِعُ الحَجَرَ، فَيَجْرِي المَاءُ إِلَى البُسْتَانِ التَّاسِعِ."
  ],
  "ts.win1": "{أَنْتَ بَنَّاءُ|أَنْتِ بَنَّاءَةُ} المُجَسَّمَاتِ!",
  "ts.win2": "{عَدَدْتَ|عَدَدْتِ} {وَطَوَيْتَ|وَطَوَيْتِ} {وَغَلَّفْتَ|وَغَلَّفْتِ} {وَرَسَمْتَ|وَرَسَمْتِ} المَسَاقِطَ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {بَنَّاءِ|بَنَّاءَةِ} المُجَسَّمَاتِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِخْتَرْ|اِخْتَارِي} عُلْبَةً أُخْرَى فِي المَطْبَخِ، {وَارْسُمْ|وَارْسُمِي} مَسَاقِطَهَا الثَّلَاثَةَ بِأَبْعَادِهَا، {وَاسْأَلْ|وَاسْأَلِي} {أَهْلَكَ|أَهْلَكِ}: أَيُّ عُلْبَةٍ هِيَ؟"
  ]
 },
