 ],
 "concepts": {
  "C405": "تطابق المثلثات (أ): ثلاثة أضلاع متناظرة متساوية (SSS)، وتعليله بالإنشاء بالفرجار (مثلث واحد)، والأجزاء المتناظرة، والفرق عن التشابه (استدعاء C408 وC314 وC240)"
 },
 "bag": {
