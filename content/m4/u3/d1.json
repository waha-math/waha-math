  "ask": "bag.ask",
  "adult": "فرجار ومسطرة.",
  "screenPath": "على الشاشة يحكم الطفل على مثلثين بأطوال أضلاعهما، ويختار المطابق للأصل، ويسمّي الأجزاء المتناظرة."
 },
 "labels": {
  "bagCompass": "فِرْجَارٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} فِرْجَارٌ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "هَذَانِ المُثَلَّثَانِ بِالشَّكْلِ نَفْسِهِ، فَهُمَا مُتَطَابِقَانِ!"
  ],
  "hk.02": "نَنْقُلُ الصَّغِيرَ عَلَى وَرَقٍ شَفَّافٍ فَوْقَ الكَبِيرِ: لَا يَنْطَبِقُ. الشَّكْلُ نَفْسُهُ وَالحَجْمُ مُخْتَلِفٌ: مُتَشَابِهَانِ، لَا مُتَطَابِقَانِ.",
  "sb.01": "نَبْنِي مُثَلَّثًا مِنْ أَضْلَاعِهِ الثَّلَاثَةِ: نَرْسُمُ القَاعِدَةَ سِتَّةً.",
  "sb.02": "وَمِنْ طَرَفَيْهَا قَوْسَانِ بِالفِرْجَارِ، خَمْسَةٌ وَأَرْبَعَةٌ، يَتَقَاطَعَانِ فِي نُقْطَةٍ وَاحِدَةٍ فَوْقَ القَاعِدَةِ.",
  "sb.03": "فَلَا يُبْنَى بِهَذِهِ الأَضْلَاعِ إِلَّا مُثَلَّثٌ وَاحِدٌ: إِذَا تَسَاوَتِ الأَضْلَاعُ الثَّلَاثَةُ المُتَنَاظِرَةُ فَالمُثَلَّثَانِ مُتَطَابِقَانِ.",
  "sb.04": "هَذَا سَبَبٌ بِالإِنْشَاءِ، وَالبُرْهَانُ الكَامِلُ بَعْدَ أَنْ نُعْلِنَ مُسَلَّمَةَ التَّطَابُقِ فِي الدَّرْسِ القَادِمِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} بِالمِسْطَرَةِ قَاعِدَةً، {وَارْسُمْ|وَارْسُمِي} مِنْ كُلِّ طَرَفٍ قَوْسًا بِالفِرْجَارِ، {وَصِلْ|وَصِلِي} مَوْضِعَ التِقَاءِ الأَقْوَاسِ بِالقَاعِدَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: القِطَعُ المُتَطَابِقَةُ! {اِخْتَرِ|اِخْتَارِي} المُثَلَّثَ الَّذِي يُطَابِقُ الأَصْلَ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: المُثَلَّثَانِ لَهُمَا الزَّوَايَا نَفْسُهَا، إِذَنْ هُمَا مُتَطَابِقَانِ. مَا خَطَؤُهَا؟",
  "pr.r1a": "الزَّوَايَا لَا تَكْفِي: قَدْ يَكُونَانِ مُتَشَابِهَيْنِ بِحَجْمَيْنِ.",
  "pr.r1b": "لَا خَطَأَ: الزَّوَايَا المُتَسَاوِيَةُ تَكْفِي لِلتَّطَابُقِ.",
  "pr.r1c": "الخَطَأُ أَنَّ زَوَايَا المُثَلَّثَيْنِ لَا تَتَسَاوَى.",
  "ch.find": "قَالَتْ فَوْضَى: هَذَانِ مُتَطَابِقَانِ لِأَنَّ شَكْلَهُمَا وَاحِدٌ. مَا العَلَاقَةُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! الشَّكْلُ وَاحِدٌ، وَالأَطْوَالُ مُخْتَلِفَةٌ."
  ],
  "ch.right": "نُقَارِنُ الأَضْلَاعَ المُتَنَاظِرَةَ.",
  "ch.wrong": [
   "chaos",
   "الشَّكْلُ يَكْفِي."
  ],
  "ms.1": "لِمَاذَا تَكْفِي الأَضْلَاعُ الثَّلَاثَةُ لِلتَّطَابُقِ؟",
  "ms.1a": "لِأَنَّ الفِرْجَارَ لَا يَبْنِي بِهَا إِلَّا مُثَلَّثًا وَاحِدًا.",
  "ms.1b": "لِأَنَّ زَوَايَا كُلِّ مُثَلَّثٍ مَجْمُوعُهَا مِئَةٌ وَثَمَانُونَ.",
  "ms.1c": "لِأَنَّ كُلَّ مُثَلَّثَيْنِ لَهُمَا ثَلَاثَةُ أَضْلَاعٍ يَتَطَابَقَانِ.",
  "ms.recall": "نَتَذَكَّرُ: إِذَا تَسَاوَتِ الأَضْلَاعُ الثَّلَاثَةُ المُتَنَاظِرَةُ فَالمُثَلَّثَانِ مُتَطَابِقَانِ، وَتَتَسَاوَى زَوَايَاهُمَا المُتَنَاظِرَةُ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} التَّطَابُقَ بِثَلَاثَةِ أَضْلَاعٍ!",
  "wrap.01": "ثَلَاثَةُ أَضْلَاعٍ مُتَسَاوِيَةٍ: مُثَلَّثٌ وَاحِدٌ لَا غَيْرُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قُصَّ|قُصِّي} ثَلَاثَ شَرَائِطَ، {وَاصْنَعْ|وَاصْنَعِي} بِهَا مُثَلَّثًا، ثُمَّ {اُطْلُبْ|اُطْلُبِي} مِنْ {أَهْلِكَ|أَهْلِكِ} أَنْ يَصْنَعُوا مُثَلَّثًا آخَرَ بِالشَّرَائِطِ نَفْسِهَا: هَلْ يَنْطَبِقَانِ؟"
  ]
 },
