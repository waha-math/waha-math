 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "كَبَّرْتُ صُورَةَ المُسْتَطِيلِ، فَصَارَ مُطَابِقًا لِلْأَوَّلِ!"
  ],
  "hk.02": "زَوَايَا المُسْتَطِيلَيْنِ مُتَسَاوِيَةٌ، لَكِنْ هَلْ أَضْلَاعُهُمَا مُتَسَاوِيَةٌ؟ لَا: الكَبِيرُ ضِعْفُ الصَّغِيرِ.",
  "sm.01": "مُثَلَّثٌ أَضْلَاعُهُ أَرْبَعَةٌ وَسِتَّةٌ وَثَمَانِيَةٌ.",
  "sm.02": "نُكَبِّرُهُ بِمُعَامِلِ وَاحِدٍ وَنِصْفٍ: سِتَّةٌ وَتِسْعَةٌ وَاثْنَا عَشَرَ. الزَّوَايَا لَا تَتَغَيَّرُ، وَالأَضْلَاعُ كُلُّهَا تُضْرَبُ فِي العَدَدِ نَفْسِهِ.",
  "sm.03": "الشَّكْلَانِ مُتَشَابِهَانِ: زَوَايَاهُمَا المُتَنَاظِرَةُ مُتَسَاوِيَةٌ، وَأَضْلَاعُهُمَا المُتَنَاظِرَةُ مُتَنَاسِبَةٌ. وَالمُتَطَابِقَانِ مُتَشَابِهَانِ بِمُعَامِلِ وَاحِدٍ.",
  "sm.04": "وَالضِّلْعُ المَجْهُولُ: نَقْسِمُ ضِلْعَيْنِ مُتَنَاظِرَيْنِ لِنَجِدَ المُعَامِلَ، ثُمَّ نَضْرِبُ فِيهِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ مُثَلَّثًا، {وَارْسُمْ|وَارْسُمِي} تَكْبِيرَهُ، {وَقِسْ|وَقِيسِي} أَضْلَاعَهُمَا بِالمِسْطَرَةِ {وَاقْسِمْ|وَاقْسِمِي} كُلَّ ضِلْعٍ عَلَى مُنَاظِرِهِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مُكَبِّرُ الصُّوَرِ! {اِخْتَرْ|اِخْتَارِي} بُعْدَيِ الصُّورَةِ المُكَبَّرَةِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: الشَّكْلَانِ مُتَشَابِهَانِ لِأَنَّ زَوَايَاهُمَا مُتَسَاوِيَةٌ. مَا خَطَؤُهَا؟",
  "pr.r1a": "تَنَاسُبُ الأَضْلَاعِ شَرْطٌ أَيْضًا: هُنَا لَا تَتَنَاسَبُ.",
  "pr.r1b": "لَا خَطَأَ: الزَّوَايَا المُتَسَاوِيَةُ تَكْفِي لِكُلِّ شَكْلٍ.",
  "pr.r1c": "المُتَشَابِهَانِ زَوَايَاهُمَا مُخْتَلِفَةٌ.",
  "ch.find": "قَالَتْ فَوْضَى: المُسْتَطِيلَانِ مُتَشَابِهَانِ لِأَنَّ زَوَايَاهُمَا قَائِمَةٌ. هَلْ هُمَا مُتَشَابِهَانِ؟",
  "ch.after": [
   "chaos",
   "آه! الأَضْلَاعُ لَا تَتَنَاسَبُ."
  ],
  "ch.right": "نَقْسِمُ كُلَّ ضِلْعٍ عَلَى مُنَاظِرِهِ.",
  "ch.wrong": [
   "chaos",
   "القَائِمَةُ تَكْفِي."
  ],
  "ms.1": "قَصَّتْ فَوْضَى مُثَلَّثًا، ثُمَّ قَصَّتْ نُسْخَةً تَنْطَبِقُ عَلَيْهِ تَمَامًا. هَلْ هُمَا مُتَشَابِهَانِ؟ لِمَاذَا؟",
  "ms.1a": "نَعَمْ: كُلُّ ضِلْعٍ فِيهَا يُسَاوِي نَظِيرَهُ مَرَّةً وَاحِدَةً، وَالزَّوَايَا نَفْسُهَا.",
  "ms.1b": "نَعَمْ: قَصَّتْهُمَا مِنْ وَرَقٍ وَاحِدٍ، فَهُمَا مُتَشَابِهَانِ.",
  "ms.1c": "لَا: المُتَطَابِقَانِ لَا يَكُونَانِ مُتَشَابِهَيْنِ، فَالتَّشَابُهُ غَيْرُ التَّطَابُقِ.",
  "ms.x1": "صُورَةٌ طُبِعَتْ بِحَجْمَيْنِ: طُولُ الكَبِيرَةِ وَعَرْضُهَا ضِعْفُ الصَّغِيرَةِ. لِمَاذَا تَبْدُوَانِ الشَّكْلَ نَفْسَهُ؟",
  "ms.x1a": "لِأَنَّ الأَطْوَالَ كُلَّهَا ضُرِبَتْ فِي العَدَدِ نَفْسِهِ، وَالزَّوَايَا لَمْ تَتَغَيَّرْ.",
  "ms.x1b": "لِأَنَّ الطُّولَ وَالعَرْضَ زَادَا بِالعَدَدِ نَفْسِهِ مِنَ السَّنْتِيمِتْرَاتِ فِي الصُّورَتَيْنِ.",
  "ms.x1c": "لِأَنَّ مِسَاحَةَ الكَبِيرَةِ ضِعْفُ مِسَاحَةِ الصُّورَةِ الصَّغِيرَةِ.",
  "ms.recall": "نَتَذَكَّرُ: المُتَشَابِهَانِ زَوَايَاهُمَا مُتَسَاوِيَةٌ وَأَضْلَاعُهُمَا مُتَنَاسِبَةٌ، وَالضِّلْعُ المَجْهُولُ بِالمُعَامِلِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} التَّشَابُهَ!",
  "wrap.01": "زَوَايَا مُتَسَاوِيَةٌ وَأَضْلَاعٌ مُتَنَاسِبَةٌ: مُتَشَابِهَانِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {صَوِّرْ|صَوِّرِي} بَابَ الغُرْفَةِ مِنْ مُوَاجَهَتِهِ، {وَقِسْ|وَقِيسِي} طُولَهُ وَعَرْضَهُ حَقِيقَةً وَفِي الصُّورَةِ مَعَ {أَهْلِكَ|أَهْلِكِ}، {وَاقْسِمْ|وَاقْسِمِي}: هَلِ النِّسْبَتَانِ مُتَقَارِبَتَانِ؟"
  ]
 },
