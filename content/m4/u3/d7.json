  "ask": "bag.ask",
  "adult": "فرجار ومسطرة.",
  "screenPath": "أسئلة الوحدة على الشاشة: شروط التطابق الثلاثة، والتشابه والضلع المجهول، وبراهين الرباعيات وتصنيفها من أقطارها."
 },
 "labels": {
  "bagCompass": "فِرْجَارٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} فِرْجَارٌ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المَرَايَا المُتَطَابِقَةِ مَصْنَعٌ يَصْنَعُ نُسَخًا مُتَطَابِقَةً وَمُكَبَّرَةً مِنَ القِطَعِ نَفْسِهَا. وَاليَوْمَ مَحْكَمَةُ التَّطَابُقِ: {تَحْكُمُ|تَحْكُمِينَ} عَلَى أَزْوَاجِ الأَشْكَالِ بِالشَّرْطِ.",
  "hook.02": "مَنْ يَحْكُمُ بِالشَّرْطِ يَبْنِي الجُزْءَ الثَّالِثَ مِنْ نَاعُورَةِ الاخْتِرَاعِ، وَيَأْخُذُ شَارَةَ {صَانِعِ|صَانِعَةِ} المَرَايَا المُتَطَابِقَةِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} بِالفِرْجَارِ وَالمِسْطَرَةِ مُثَلَّثًا وَنُسْخَةً مُطَابِقَةً لَهُ وَأُخْرَى مُكَبَّرَةً، {وَاكْتُبْ|وَاكْتُبِي} تَحْتَ كُلِّ نُسْخَةٍ شَرْطَهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: ثَلَاثَةُ أَضْلَاعٍ، أَوْ ضِلْعَانِ وَالزَّاوِيَةُ بَيْنَهُمَا، أَوْ زَاوِيَتَانِ وَالضِّلْعُ بَيْنَهُمَا: تَطَابُقٌ.",
  "rv.02": "وَالتَّشَابُهُ زَوَايَا مُتَسَاوِيَةٌ وَأَضْلَاعٌ مُتَنَاسِبَةٌ. وَبِالتَّطَابُقِ بَرْهَنَّا خَصَائِصَ الرُّبَاعِيَّاتِ وَعَكْسَهَا.",
  "gm.intro": "لُعْبَةُ: مَحْكَمَةُ التَّطَابُقِ! مُتَطَابِقَانِ أَمْ مُتَشَابِهَانِ أَمْ لَا هَذَا وَلَا ذَاكَ؟ {وَعَلِّلِ|وَعَلِّلِي} الحُكْمَ بِالشَّرْطِ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "gm.r1": "فِي المَحْكَمَةِ: هَلْ يَتَطَابَقُ المُثَلَّثَانِ؟ وَبِأَيِّ شَرْطٍ؟",
  "gm.r1a": "نَعَمْ: ضِلْعَانِ مُتَسَاوِيَانِ وَالزَّاوِيَةُ بَيْنَهُمَا.",
  "gm.r1b": "نَعَمْ: يَبْدُوَانِ بِالحَجْمِ نَفْسِهِ حِينَ نَنْظُرُ إِلَى الرَّسْمِ.",
  "gm.r1c": "لَا: نَحْتَاجُ الأَضْلَاعَ الثَّلَاثَةَ كُلَّهَا.",
  "gm.r2": "وَهَذَانِ: هَلْ يَتَطَابَقَانِ حَتْمًا؟ وَلِمَاذَا؟",
  "gm.r2a": "لَا يُحْكَمُ بِذَلِكَ: الزَّاوِيَةُ لَيْسَتْ بَيْنَ الضِّلْعَيْنِ.",
  "gm.r2b": "نَعَمْ: فِيهِمَا ضِلْعَانِ مُتَسَاوِيَانِ وَزَاوِيَةٌ مُتَسَاوِيَةٌ.",
  "gm.r2c": "نَعَمْ: الزَّاوِيَةُ المَعْلُومَةُ حَادَّةٌ فِي الِاثْنَيْنِ.",
  "ts.13": "قَالَتْ فَوْضَى: المُثَلَّثَانِ مُتَطَابِقَانِ لِأَنَّ فِيهِمَا ضِلْعَيْنِ مُتَسَاوِيَيْنِ وَزَاوِيَةً خَارِجَهُمَا. مَا خَطَؤُهَا؟",
  "ts.13a": "زَاوِيَةٌ خَارِجَ الضِّلْعَيْنِ قَدْ تَرْسُمُ مُثَلَّثَيْنِ مُخْتَلِفَيْنِ، فَلَا تَكْفِي.",
  "ts.13b": "لَا خَطَأَ: ضِلْعَانِ مَعَ زَاوِيَةٍ خَارِجَهُمَا يَكْفِيَانِ لِلتَّطَابُقِ.",
  "ts.13c": "الخَطَأُ أَنَّهَا لَمْ تَقِسِ الزَّاوِيَةَ بِالمِنْقَلَةِ.",
  "ts.14": "لِمَاذَا لَا يَكْفِي تَسَاوِي الزَّوَايَا لِإِثْبَاتِ التَّطَابُقِ؟",
  "ts.14a": "لِأَنَّ مُثَلَّثًا مُكَبَّرًا لَهُ الزَّوَايَا نَفْسُهَا وَأَضْلَاعٌ أَطْوَلُ.",
  "ts.14b": "بَلْ يَكْفِي، لِأَنَّ الزَّوَايَا المُتَسَاوِيَةَ تَصْنَعُ مُثَلَّثًا وَاحِدًا.",
  "ts.14c": "لِأَنَّ زَوَايَا المُثَلَّثِ لَا تَتَسَاوَى فِي مُثَلَّثَيْنِ مُخْتَلِفَيْنِ.",
  "ts.rem": "نَعُودُ إِلَى الفِرْجَارِ وَالعَلَامَاتِ وَالتَّكْبِيرِ وَالأَقْطَارِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! هَذَا الجُزْءُ الثَّالِثُ مِنْ نَاعُورَةِ الاخْتِرَاعِ."
  ],
  "ts.win1": "{أَخَذْتَ|أَخَذْتِ} شَارَةَ {صَانِعِ|صَانِعَةِ} المَرَايَا المُتَطَابِقَةِ!",
  "ts.win2": "{حَكَمْتَ|حَكَمْتِ} بِالشُّرُوطِ، {وَوَجَدْتَ|وَوَجَدْتِ} المَجْهُولَ بِالمُعَامِلِ، {وَصَنَّفْتَ|وَصَنَّفْتِ} الرُّبَاعِيَّاتِ مِنْ أَقْطَارِهَا.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {صَانِعِ|صَانِعَةِ} المَرَايَا المُتَطَابِقَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِسْأَلْ|اِسْأَلِي} {أَهْلَكَ|أَهْلَكِ}: لِمَاذَا لَا يَكْفِي تَسَاوِي الزَّوَايَا لِلتَّطَابُقِ؟ {وَاشْرَحْ|وَاشْرَحِي} لَهُمْ بِمُثَلَّثَيْنِ بِحَجْمَيْنِ."
  ]
 },
