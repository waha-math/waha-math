 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} كُوبٌ أُسْطُوَانِيٌّ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ الخَزَّانَاتِ مَصَانِعُ لِلْأُسْطُوَانَاتِ وَالأَهْرَامِ، وَمَقَايِيسُ لِلِّتْرِ. وَاليَوْمَ مَحْكَمَةُ الحُجُومِ: {تَحْكُمُ|تَحْكُمِينَ} {وَتَحْسُبُ|وَتَحْسُبِينَ}.",
  "hook.02": "مَنْ يَحْسُبُ الحُجُومَ وَيُوَحِّدُ الوَحْدَاتِ يَبْنِي الجُزْءَ السَّابِعَ مِنْ نَاعُورَةِ الاخْتِرَاعِ، وَيَأْخُذُ شَارَةَ {صَانِعِ|صَانِعَةِ} الخَزَّانَاتِ.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ كُوبًا أُسْطُوَانِيًّا، {وَاحْسُبْ|وَاحْسُبِي} حَجْمَهُ بِالسَّنْتِيمِتْرِ المُكَعَّبِ وَبِاللِّتْرِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: حَجْمُ الأُسْطُوَانَةِ مِسَاحَةُ القَاعِدَةِ فِي الارْتِفَاعِ، وَسَطْحُهَا دَائِرَتَانِ وَمُسْتَطِيلٌ طُولُهُ المُحِيطُ.",
  "rv.02": "وَالهَرَمُ وَالمَخْرُوطُ ثُلُثٌ، وَاللِّتْرُ أَلْفُ سَنْتِيمِتْرٍ مُكَعَّبٍ، وَالمِتْرُ المُكَعَّبُ أَلْفُ لِتْرٍ.",
  "gm.intro": "لُعْبَةُ: مُحَوِّلُ الخَزَّانِ! كَمْ يُسَاوِي؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.12": "قَالَتْ فَوْضَى: خَزَّانٌ نِصْفُ قُطْرِهِ خَمْسُونَ سَنْتِيمِتْرًا وَارْتِفَاعُهُ مِتْرٌ، فَحَجْمُهُ بَاي فِي خَمْسِينَ فِي خَمْسِينَ فِي وَاحِدٍ. مَا خَطَؤُهَا؟",
  "ts.12a": "لَمْ تُوَحِّدِ الوَحْدَاتِ: المِتْرُ مِئَةُ سَنْتِيمِتْرٍ قَبْلَ الضَّرْبِ.",
  "ts.12b": "لَا خَطَأَ: نَضْرِبُ الأَعْدَادَ كَمَا كُتِبَتْ فِي كُلِّ مَسْأَلَةٍ.",
  "ts.12c": "الخَطَأُ أَنَّهَا لَمْ تَقْسِمْ عَلَى ثَلَاثَةٍ كَمَا فِي حَجْمِ المَخْرُوطِ.",
  "ts.rem": "نَعُودُ إِلَى أَقْرَاصِ الأُسْطُوَانَةِ وَشَبَكَتِهَا وَالتَّعْبِئَاتِ الثَّلَاثِ وَمُكَعَّبِ اللِّتْرِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! هَذَا الجُزْءُ السَّابِعُ مِنْ نَاعُورَةِ الاخْتِرَاعِ."
  ],
  "ts.win1": "{أَخَذْتَ|أَخَذْتِ} شَارَةَ {صَانِعِ|صَانِعَةِ} الخَزَّانَاتِ!",
  "ts.win2": "{حَسَبْتَ|حَسَبْتِ} حُجُومَ الأُسْطُوَانَةِ وَالمَخْرُوطِ وَالكُرَةِ، وَسَطْحَ العُلْبَةِ، {وَحَوَّلْتَ|وَحَوَّلْتِ} اللِّتْرَ وَالمِتْرَ المُكَعَّبَ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {صَانِعِ|صَانِعَةِ} الخَزَّانَاتِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُحْسُبْ|اُحْسُبِي} مَعَ {أَهْلِكَ|أَهْلِكِ} سَعَةَ قِدْرِ الطَّبْخِ بِاللِّتْرِ مِنْ قُطْرِهِ وَارْتِفَاعِهِ، ثُمَّ {عُدَّ|عُدِّي} كَمْ كُوبَ قِيَاسٍ يَمْلَؤُهُ."
  ]
 },
