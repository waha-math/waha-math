  "adult": "ورق مربعات ومنقلة.",
  "screenPath": "أسئلة الوحدة على الشاشة: الانعكاس والدوران حول الأصل، والدوران بالمنقلة، والتركيب، ومسائل على الشبكة."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagProt": "مِنْقَلَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِنْقَلَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المِرْآةِ الكُبْرَى الكَامِلَةِ سَاحَةُ مَرَايَا وَعَجَلَةٌ تَدُورُ حَوْلَ مَرْكَزٍ. وَاليَوْمَ مَحْكَمَةُ التَّحْوِيلَاتِ: {تَحْكُمُ|تَحْكُمِينَ} {وَتُعَلِّلُ|وَتُعَلِّلِينَ}.",
  "hook.02": "مَنْ يَعْكِسُ وَيُدِيرُ وَيُرَكِّبُ يَبْنِي الجُزْءَ التَّاسِعَ مِنْ نَاعُورَةِ الاخْتِرَاعِ، وَيَأْخُذُ شَارَةَ {حَارِسِ|حَارِسَةِ} المَرَايَا الكُبْرَى.",
  "mat.01": "{عَلِّمْ|عَلِّمِي} عَلَى وَرَقِ المُرَبَّعَاتِ نُقْطَةً، {وَاعْكِسْهَا|وَاعْكِسِيهَا} عَلَى المِحْوَرِ الأُفُقِيِّ، {وَقِسْ|وَقِيسِي} بِالمِنْقَلَةِ زَاوِيَةً بَيْنَهُمَا وَبَيْنَ الأَصْلِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المِرْآةُ تُغَيِّرُ إِشَارَةً وَاحِدَةً، وَرُبْعُ الدَّوْرَةِ يُبَدِّلُ وَيُغَيِّرُ إِشَارَةَ الأَوَّلِ، وَنِصْفُهَا يُغَيِّرُ الإِشَارَتَيْنِ.",
  "rv.02": "وَالدَّوَرَانُ بِالمِنْقَلَةِ يَحْتَاجُ مَرْكَزًا وَزَاوِيَةً وَاتِّجَاهًا، وَانْعِكَاسَانِ عَلَى المِحْوَرَيْنِ يُسَاوِيَانِ نِصْفَ دَوْرَةٍ.",
  "gm.intro": "لُعْبَةُ: مَحْكَمَةُ التَّحْوِيلَاتِ! أَيُّ تَحْوِيلٍ هَذَا؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.12": "قَالَتْ فَوْضَى: نِصْفُ الدَّوْرَةِ لِلنُّقْطَةِ اثْنَانِ، خَمْسَةٌ يُعْطِي سَالِبَ اثْنَيْنِ، خَمْسَةً. مَا خَطَؤُهَا؟",
  "ts.12a": "نِصْفُ الدَّوْرَةِ يُغَيِّرُ الإِشَارَتَيْنِ، لَا وَاحِدَةً.",
  "ts.12b": "لَا خَطَأَ: نِصْفُ الدَّوْرَةِ يُغَيِّرُ إِشَارَةً وَاحِدَةً.",
  "ts.12c": "الخَطَأُ أَنَّهَا لَمْ تُبَدِّلِ الإِحْدَاثِيَّيْنِ قَبْلَ تَغْيِيرِ الإِشَارَةِ كَمَا فِي رُبْعِ الدَّوْرَةِ.",
  "ts.13": "لِمَاذَا يُعِيدُ انْعِكَاسَانِ عَلَى المِحْوَرَيْنِ الشَّكْلَ إِلَى مَوْضِعٍ كَالدَّوَرَانِ؟",
  "ts.13a": "الأَوَّلُ يُغَيِّرُ الأُفُقِيَّ وَالثَّانِي الرَّأْسِيَّ، كَنِصْفِ دَوْرَةٍ.",
  "ts.13b": "لِأَنَّ كُلَّ انْعِكَاسٍ يُدِيرُ الشَّكْلَ رُبْعَ دَوْرَةٍ حَوْلَ الأَصْلِ.",
  "ts.13c": "لِأَنَّ الانْعِكَاسَ الثَّانِيَ يُلْغِي الأَوَّلَ تَمَامًا، فَيَعُودُ الشَّكْلُ إِلَى مَكَانِهِ الأَوَّلِ.",
  "ts.rem": "نَعُودُ إِلَى المَرَايَا وَالعَجَلَةِ وَالمِنْقَلَةِ وَالمَدِينَةِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! هَذَا الجُزْءُ التَّاسِعُ مِنْ نَاعُورَةِ الاخْتِرَاعِ."
  ],
  "ts.win1": "{أَخَذْتَ|أَخَذْتِ} شَارَةَ {حَارِسِ|حَارِسَةِ} المَرَايَا الكُبْرَى!",
  "ts.win2": "{عَكَسْتَ|عَكَسْتِ} {وَأَدَرْتَ|وَأَدَرْتِ} عَلَى المُسْتَوَى الكَامِلِ، {وَدَوَّرْتَ|وَدَوَّرْتِ} بِالمِنْقَلَةِ، {وَرَكَّبْتَ|وَرَكَّبْتِ} التَّحْوِيلَاتِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {حَارِسِ|حَارِسَةِ} المَرَايَا الكُبْرَى!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَقِمْ|أَقِيمِي} مَعَ {أَهْلِكَ|أَهْلِكِ} مِرْآتَيْنِ مُتَعَامِدَتَيْنِ عَلَى وَرَقِ المُرَبَّعَاتِ، {وَضَعْ|وَضَعِي} عُمْلَةً، {وَاقْرَأْ|وَاقْرَئِي} إِحْدَاثِيَّاتِ صُوَرِهَا الثَّلَاثِ."
  ]
 },
