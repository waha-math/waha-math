 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قَلَمٌ وَوَرَقَةٌ لِلْحِسَابِ؟ أَمْ نَحْسُبُ فِي رُؤُوسِنَا؟",
  "hook.01": "وَصَلْنَا إِلَى بَوَّابَةِ المُخْتَرِعِينَ! النَّاعُورَةُ تَدُورُ، وَالحَارِسُ يَسْأَلُ عَنْ كُلِّ أَحْيَاءِ المَرْحَلَةِ.",
  "hook.02": "خَمْسَةٌ وَعِشْرُونَ سُؤَالًا، بِلَا عَجَلَةٍ. {خُذِ|خُذِي} اسْتِرَاحَةً مَتَى {شِئْتَ|شِئْتِ}.",
  "mat.01": "{خُذِ|خُذِي} القَلَمَ وَالوَرَقَةَ، {وَاحْسُبْ|وَاحْسُبِي} عَلَيْهَا مَا {شِئْتَ|شِئْتِ}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "w.1": "سِكَّتَا قِطَارٍ مُتَوَازِيَتَانِ يَقْطَعُهُمَا طَرِيقٌ مَائِلٌ. لِمَاذَا تَتَسَاوَى الزَّاوِيَتَانِ المُعَلَّمَتَانِ عَلَى جَانِبَيِ الطَّرِيقِ؟",
  "w.1a": "لِأَنَّهُمَا زَاوِيَتَا تَبَادُلٍ بَيْنَ مُتَوَازِيَيْنِ، وَزَاوِيَتَا التَّبَادُلِ مُتَسَاوِيَتَانِ.",
  "w.1b": "لِأَنَّهُمَا تَبْدُوَانِ مُتَسَاوِيَتَيْنِ إِذَا نَظَرْنَا إِلَيْهِمَا عَلَى الخَرِيطَةِ.",
  "w.1c": "لِأَنَّهُمَا مُتَجَاوِرَتَانِ عَلَى خَطٍّ، فَمَجْمُوعُهُمَا مِئَةٌ وَثَمَانُونَ وَكُلٌّ مِنْهُمَا نِصْفُهُ.",
  "w.2": "عَلَمَانِ مُثَلَّثَانِ زَوَايَاهُمَا مُتَسَاوِيَةٌ، أَحَدُهُمَا صَغِيرٌ وَالآخَرُ كَبِيرٌ. لِمَاذَا لَا نَقُولُ إِنَّهُمَا مُتَطَابِقَانِ؟",
  "w.2a": "لِأَنَّ تَسَاوِيَ الزَّوَايَا يَجْعَلُهُمَا مُتَشَابِهَيْنِ، وَالتَّطَابُقُ يَحْتَاجُ ضِلْعًا مُتَسَاوِيًا.",
  "w.2b": "لِأَنَّ الزَّوَايَا تُقَاسُ بِالمِنْقَلَةِ، وَالمِنْقَلَةُ تُخْطِئُ أَحْيَانًا كَثِيرَةً فِي القِيَاسِ.",
  "w.2c": "لِأَنَّ المُتَطَابِقَيْنِ تَخْتَلِفُ زَوَايَاهُمَا إِذَا اخْتَلَفَ مَوْضِعَاهُمَا.",
  "w.3": "عَصًا وَعَمُودٌ وَظِلَّاهُمَا فِي شَمْسِ العَصْرِ، وَالعَمُودُ ضِعْفُ العَصَا. لِمَاذَا جَا زَاوِيَةِ الشَّمْسِ وَاحِدَةٌ فِيهِمَا؟",
  "w.3a": "لِأَنَّ المُثَلَّثَيْنِ مُتَشَابِهَانِ، فَالمُقَابِلُ وَالوَتَرُ يَتَضَاعَفَانِ مَعًا.",
  "w.3b": "لِأَنَّ ظِلَّ العَصَا وَظِلَّ العَمُودِ مُتَسَاوِيَانِ فِي الطُّولِ فِي شَمْسِ العَصْرِ.",
  "w.3c": "لِأَنَّ جَا تُحْسَبُ مِنَ الوَتَرِ وَحْدَهُ، وَشُعَاعُ الشَّمْسِ وَاحِدٌ فِيهِمَا.",
  "fa.after": "{أَحْسَنْتَ|أَحْسَنْتِ} الصَّبْرَ! بَقِيَتْ مَهَامُّ الأَدَوَاتِ وَمَدِينَةُ المُهَنْدِسِينَ فِي يَوْمٍ آخَرَ.",
  "wrap.01": "انْتَهَى الجُزْءُ الأَوَّلُ مِنْ بَوَّابَةِ المُخْتَرِعِينَ."
 },
