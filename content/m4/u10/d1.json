 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قَلَمٌ وَوَرَقَةٌ لِلْحِسَابِ؟ أَمْ نَحْسُبُ فِي رُؤُوسِنَا؟",
  "hook.01": "وَصَلْنَا إِلَى بَوَّابَةِ المُخْتَرِعِينَ! النَّاعُورَةُ تَدُورُ، وَالحَارِسُ يَسْأَلُ عَنْ كُلِّ أَحْيَاءِ المَرْحَلَةِ.",
  "hook.02": "خَمْسَةٌ وَعِشْرُونَ سُؤَالًا، بِلَا عَجَلَةٍ. {خُذِ|خُذِي} اسْتِرَاحَةً مَتَى {شِئْتَ|شِئْتِ}.",
  "mat.01": "{خُذِ|خُذِي} القَلَمَ وَالوَرَقَةَ، {وَاحْسُبْ|وَاحْسُبِي} عَلَيْهَا مَا {شِئْتَ|شِئْتِ}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "w.1": "قَاطِعٌ عَلَى مُسْتَقِيمَيْنِ مُتَوَازِيَيْنِ. لِمَاذَا تَتَسَاوَى زَاوِيَتَا التَّبَادُلِ المُعَلَّمَتَانِ؟",
  "w.1a": "إِحْدَاهُمَا تُقَابِلُ بِالرَّأْسِ مُنَاظِرَةَ الأُخْرَى، وَالمُتَنَاظِرَتَانِ مُتَسَاوِيَتَانِ بِالتَّوَازِي.",
  "w.1b": "لِأَنَّهُمَا تَبْدُوَانِ مُتَسَاوِيَتَيْنِ فِي الرَّسْمِ إِذَا نَظَرْنَا جَيِّدًا.",
  "w.1c": "لِأَنَّ كُلَّ زَاوِيَتَيْنِ حَوْلَ القَاطِعِ مُتَسَاوِيَتَانِ، مَهْمَا كَانَ المُسْتَقِيمَانِ.",
  "w.2": "مُثَلَّثَانِ زَوَايَاهُمَا مُتَسَاوِيَةٌ. لِمَاذَا لَا يَكْفِي هَذَا لِنَقُولَ إِنَّهُمَا مُتَطَابِقَانِ؟",
  "w.2a": "قَدْ يَكُونُ أَحَدُهُمَا تَكْبِيرًا لِلْآخَرِ، فَيَتَشَابَهَانِ وَلَا يَتَطَابَقَانِ.",
  "w.2b": "لِأَنَّ الزَّوَايَا لَا تُقَاسُ إِلَّا بِالمِنْقَلَةِ، وَالمِنْقَلَةُ تُخْطِئُ أَحْيَانًا كَثِيرَةً.",
  "w.2c": "لِأَنَّ المُثَلَّثَيْنِ المُتَطَابِقَيْنِ لَا تَتَسَاوَى زَوَايَاهُمَا فِي الرَّسْمِ.",
  "w.3": "كَبَّرْنَا مُثَلَّثًا قَائِمًا إِلَى ضِعْفِهِ. لِمَاذَا لَا تَتَغَيَّرُ جَا زَاوِيَتِهِ؟",
  "w.3a": "المُقَابِلُ وَالوَتَرُ تَضَاعَفَا مَعًا، فَبَقِيَتْ نِسْبَتُهُمَا.",
  "w.3b": "لِأَنَّ جَا هِيَ طُولُ الوَتَرِ وَحْدَهُ، وَالوَتَرُ لَا يَتَغَيَّرُ بِالتَّكْبِيرِ.",
  "w.3c": "لِأَنَّ التَّكْبِيرَ يُضَاعِفُ الزَّاوِيَةَ نَفْسَهَا، فَتَبْقَى جَا كَمَا هِيَ.",
  "fa.after": "{أَحْسَنْتَ|أَحْسَنْتِ} الصَّبْرَ! بَقِيَتْ مَهَامُّ الأَدَوَاتِ وَمَدِينَةُ المُهَنْدِسِينَ فِي يَوْمٍ آخَرَ.",
  "wrap.01": "انْتَهَى الجُزْءُ الأَوَّلُ مِنْ بَوَّابَةِ المُخْتَرِعِينَ."
 },
