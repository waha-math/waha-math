 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُودَانِ وَوَرَقٌ شَفَّافٌ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "الزَّاوِيَتَانِ المُتَقَابِلَتَانِ بِالرَّأْسِ مُتَجَاوِرَتَانِ!"
  ],
  "hk.02": "عُودَانِ مُتَقَاطِعَانِ يَصْنَعَانِ أَرْبَعَ زَوَايَا. الأُولَى وَالثَّانِيَةُ مُتَجَاوِرَتَانِ تَشْتَرِكَانِ فِي ضِلْعٍ، وَالأُولَى وَالثَّالِثَةُ مُتَقَابِلَتَانِ بِالرَّأْسِ لَا تَشْتَرِكَانِ فِي ضِلْعٍ.",
  "vs.01": "زَاوِيَةٌ قِيَاسُهَا خَمْسُونَ، وَمُقَابِلَتُهَا بِالرَّأْسِ مَجْهُولَةٌ.",
  "vs.02": "نُدِيرُ الوَرَقَ الشَّفَّافَ نِصْفَ دَوْرَةٍ حَوْلَ الرَّأْسِ، فَتَنْطَبِقُ عَلَيْهَا: المُتَقَابِلَتَانِ بِالرَّأْسِ مُتَسَاوِيَتَانِ، وَالمُتَجَاوِرَتَانِ مِئَةٌ وَثَلَاثُونَ.",
  "mat.01": "{ضَعْ|ضَعِي} عُودًا يَقْطَعُ عُودًا آخَرَ عَلَى الوَرَقِ، {وَانْسَخْ|وَانْسَخِي} زَاوِيَةً عَلَى الوَرَقِ الشَّفَّافِ، {وَأَدِرْهُ|وَأَدِيرِيهِ} حَوْلَ الرَّأْسِ إِلَى مُقَابِلَتِهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: مِرْآةُ الرَّأْسِ! {دَوِّرِ|دَوِّرِي} العُودَ حَتَّى تَصِيرَ الزَّاوِيَةُ المَطْلُوبَةُ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: المُتَقَابِلَتَانِ بِالرَّأْسِ تَشْتَرِكَانِ فِي ضِلْعٍ. مَا خَطَؤُهَا؟",
  "pr.r1a": "المُتَجَاوِرَتَانِ تَشْتَرِكَانِ فِي ضِلْعٍ، لَا المُتَقَابِلَتَانِ.",
  "pr.r1b": "لَا خَطَأَ: كُلُّ زَاوِيَتَيْنِ عِنْدَ الرَّأْسِ تَشْتَرِكَانِ.",
  "pr.r1c": "المُتَقَابِلَتَانِ لَا رَأْسَ مُشْتَرَكًا لَهُمَا.",
  "ch.find": "قَالَتْ فَوْضَى: الزَّاوِيَةُ المُجَاوِرَةُ تُسَاوِي الزَّاوِيَةَ المَعْلُومَةَ. كَمْ هِيَ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! المُجَاوِرَةُ تُكَمِّلُهَا."
  ],
  "ch.right": "المُجَاوِرَتَانِ مُتَكَامِلَتَانِ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ الزَّوَايَا مُتَسَاوِيَةٌ."
  ],
  "ms.1": "لِمَاذَا تَتَسَاوَى المُتَقَابِلَتَانِ بِالرَّأْسِ؟",
  "ms.1a": "كُلٌّ مِنْهُمَا تُكَمِّلُ الزَّاوِيَةَ نَفْسَهَا إِلَى مُسْتَقِيمَةٍ.",
  "ms.1b": "لِأَنَّهُمَا تَشْتَرِكَانِ فِي ضِلْعٍ وَاحِدٍ عِنْدَ الرَّأْسِ.",
  "ms.1c": "لِأَنَّ الزَّوَايَا الأَرْبَعَ عِنْدَ تَقَاطُعِ أَيِّ مُسْتَقِيمَيْنِ مُتَسَاوِيَةٌ.",
  "ms.recall": "نَتَذَكَّرُ: المُتَقَابِلَتَانِ بِالرَّأْسِ مُتَسَاوِيَتَانِ، وَالمُتَجَاوِرَتَانِ عَلَى مُسْتَقِيمٍ مُتَكَامِلَتَانِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} المُتَقَابِلَتَيْنِ بِالرَّأْسِ!",
  "wrap.01": "المُتَقَابِلَتَانِ بِالرَّأْسِ مُتَسَاوِيَتَانِ!",
  "wrap.home": [
