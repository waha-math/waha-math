 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِنْقَلَةٌ وَمُثَلَّثُ رَسْمٍ؟ أَمْ نَعْمَلُ عَلَى الشَّاشَةِ؟",
  "hk.01": [
   "chaos",
   "رَسَمْتُ زَاوِيَتَيْنِ مُتَلَاصِقَتَيْنِ: ثَلَاثِينَ وَسَبْعِينَ. هُمَا مُتَتَامَّتَانِ!"
  ],
  "hk.02": "نَقِيسُهُمَا مَعًا بِالمِنْقَلَةِ: مِئَةُ دَرَجَةٍ، لَا تِسْعُونَ. فَلَيْسَتَا مُتَتَامَّتَيْنِ.",
  "cs.01": "زَاوِيَتَانِ مُتَلَاصِقَتَانِ تَمْلَآنِ زَاوِيَةً قَائِمَةً: أَرْبَعُونَ وَخَمْسُونَ، مَجْمُوعُهُمَا تِسْعُونَ. هُمَا مُتَتَامَّتَانِ.",
  "cs.02": "وَزَاوِيَتَانِ تَمْلَآنِ زَاوِيَةً مُسْتَقِيمَةً: خَمْسٌ وَسِتُّونَ وَمِئَةٌ وَخَمْسَ عَشْرَةَ، مَجْمُوعُهُمَا مِئَةٌ وَثَمَانُونَ. هُمَا مُتَكَامِلَتَانِ.",
  "cs.03": "وَنَجِدُ المَجْهُولَةَ بِالطَّرْحِ: مُكَمِّلَةُ الخَمْسِ وَالسِّتِّينَ مِئَةٌ وَثَمَانُونَ نَاقِصَ خَمْسٍ وَسِتِّينَ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} بِمُثَلَّثِ الرَّسْمِ زَاوِيَةً قَائِمَةً، {وَاقْسِمْهَا|وَاقْسِمِيهَا} بِشُعَاعٍ، {وَقِسْ|وَقِيسِي} بِالمِنْقَلَةِ الجُزْأَيْنِ {وَاجْمَعْهُمَا|وَاجْمَعِيهِمَا}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "gm.intro": "لُعْبَةُ: {أَكْمِلِ|أَكْمِلِي} الزَّاوِيَةَ! {دَوِّرِ|دَوِّرِي} الضِّلْعَ بِالزِّرَّيْنِ.",
  "pr.intro": "نَتَدَرَّبُ.",
  "pr.r1": "قَالَتْ فَوْضَى: زَاوِيَتَانِ مَجْمُوعُهُمَا مِئَةٌ مُتَتَامَّتَانِ. مَا خَطَؤُهَا؟",
  "pr.r1a": "المُتَتَامَّتَانِ مَجْمُوعُهُمَا تِسْعُونَ لَا مِئَةٌ.",
  "pr.r1b": "لَا خَطَأَ: كُلُّ زَاوِيَتَيْنِ مُتَلَاصِقَتَيْنِ مُتَتَامَّتَانِ.",
  "pr.r1c": "المُتَتَامَّتَانِ مَجْمُوعُهُمَا مِئَةٌ وَثَمَانُونَ.",
  "ch.find": "قَالَتْ فَوْضَى: هَاتَانِ الزَّاوِيَتَانِ مُتَتَامَّتَانِ. مَاذَا هُمَا حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! نَجْمَعُ أَوَّلًا ثُمَّ نَحْكُمُ."
  ],
  "ch.right": "مَجْمُوعُهُمَا يَحْكُمُ.",
  "ch.wrong": [
   "chaos",
   "النَّظَرُ يَكْفِي."
  ],
  "ms.1": "لِمَاذَا مُكَمِّلَةُ الزَّاوِيَةِ مِئَةٌ وَثَمَانُونَ نَاقِصَ قِيَاسِهَا؟",
  "ms.1a": "لِأَنَّهُمَا مَعًا تَمْلَآنِ زَاوِيَةً مُسْتَقِيمَةً.",
  "ms.1b": "لِأَنَّهُمَا مَعًا تَمْلَآنِ زَاوِيَةً قَائِمَةً وَاحِدَةً.",
  "ms.1c": "لِأَنَّ الزَّاوِيَتَيْنِ مُتَسَاوِيَتَانِ.",
  "ms.x1": "رُكْنُ وَرَقَةٍ قَائِمٌ قَسَمَهُ خَطٌّ زَاوِيَتَيْنِ. لِمَاذَا نَجِدُ إِحْدَاهُمَا بِطَرْحِ الأُخْرَى مِنْ تِسْعِينَ؟",
  "ms.x1a": "لِأَنَّهُمَا مَعًا تَمْلَآنِ الرُّكْنَ القَائِمَ، وَقِيَاسُهُ تِسْعُونَ.",
  "ms.x1b": "لِأَنَّهُمَا مَعًا تَمْلَآنِ زَاوِيَةً مُسْتَقِيمَةً، وَقِيَاسُهَا تِسْعُونَ.",
  "ms.x1c": "لِأَنَّ الخَطَّ يَقْسِمُ الرُّكْنَ زَاوِيَتَيْنِ مُتَسَاوِيَتَيْنِ مِنْهُ.",
  "ms.recall": "نَتَذَكَّرُ: المُتَتَامَّتَانِ تِسْعُونَ، وَالمُتَكَامِلَتَانِ مِئَةٌ وَثَمَانُونَ، وَالمَجْهُولَةُ بِالطَّرْحِ.",
  "ms.ok": "{أَتْقَنْتَ|أَتْقَنْتِ} المُتَتَامَّةَ وَالمُتَكَامِلَةَ!",
  "wrap.01": "تِسْعُونَ لِلْمُتَتَامَّتَيْنِ، وَمِئَةٌ وَثَمَانُونَ لِلْمُتَكَامِلَتَيْنِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} عَنْ زَاوِيَتَيْنِ مُتَكَامِلَتَيْنِ فِي البَيْتِ، كَبَابٍ مَفْتُوحٍ عَلَى حَائِطٍ، {وَقِسْ|وَقِيسِي} وَاحِدَةً، {وَاحْسُبِ|وَاحْسُبِي} الأُخْرَى مَعَ {أَهْلِكَ|أَهْلِكِ}."
  ]
 },
