  "adult": "فرجار ومنقلة.",
  "screenPath": "أسئلة الوحدة على الشاشة: المنصّف والعمود المنصّف وبرهاناهما، وجا وجتا وظا، والارتفاع."
 },
 "labels": {
  "bagCompass": "فِرْجَارٌ",
  "bagProt": "مِنْقَلَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} فِرْجَارٌ وَمِنْقَلَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المُنَصِّفَاتِ وَرْشَةُ فِرْجَارٍ كَبِيرَةٌ وَمِيزَانٌ لِلنِّسَبِ. وَاليَوْمَ مَحْكَمَةُ المُنَصِّفِ وَالنِّسْبَةِ: {تَحْكُمُ|تَحْكُمِينَ} {وَتَحْسُبُ|وَتَحْسُبِينَ}.",
  "hook.02": "مَنْ يُنْشِئُ وَيُبَرْهِنُ وَيَقِيسُ بِالنِّسَبِ يَبْنِي الجُزْءَ الثَّامِنَ مِنْ نَاعُورَةِ الاخْتِرَاعِ، وَيَأْخُذُ شَارَةَ {سَيِّدِ|سَيِّدَةِ} المُنَصِّفَاتِ.",
  "mat.01": "{نَصِّفْ|نَصِّفِي} زَاوِيَةً بِالفِرْجَارِ، {وَتَحَقَّقْ|وَتَحَقَّقِي} بِالمِنْقَلَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المُنَصِّفُ وَالعَمُودُ المُنَصِّفُ بِالفِرْجَارِ، وَنُقَطُهُمَا تَبْعُدُ بِالتَّسَاوِي، وَبُرْهَانُهُمَا بِالتَّطَابُقِ.",
  "rv.02": "وَجَا المُقَابِلُ عَلَى الوَتَرِ، وَجَتَا المُجَاوِرُ عَلَى الوَتَرِ، وَظَا المُقَابِلُ عَلَى المُجَاوِرِ.",
  "gm.intro": "لُعْبَةُ: مَحْكَمَةُ المُنَصِّفِ وَالنِّسْبَةِ! مَا اسْمُ الضِّلْعِ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.12": "قَالَتْ فَوْضَى: الارْتِفَاعُ هُوَ المَسَافَةُ مَقْسُومَةً عَلَى ظَا الزَّاوِيَةِ. مَا خَطَؤُهَا؟",
  "ts.12a": "ظَا المُقَابِلُ عَلَى المُجَاوِرِ، فَالارْتِفَاعُ المَسَافَةُ مَضْرُوبَةً فِي ظَا.",
  "ts.12b": "لَا خَطَأَ: نَقْسِمُ عَلَى ظَا لِنَجِدَ أَيَّ ارْتِفَاعٍ مَجْهُولٍ.",
  "ts.12c": "الخَطَأُ أَنَّهَا اسْتَعْمَلَتْ ظَا، وَالصَّوَابُ أَنْ تَسْتَعْمِلَ جَا الزَّاوِيَةِ.",
  "ts.rem": "نَعُودُ إِلَى القَوْسَيْنِ وَالوَتَرِ وَالجَدْوَلِ وَالشَّجَرَةِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! هَذَا الجُزْءُ الثَّامِنُ مِنْ نَاعُورَةِ الاخْتِرَاعِ."
  ],
  "ts.win1": "{أَخَذْتَ|أَخَذْتِ} شَارَةَ {سَيِّدِ|سَيِّدَةِ} المُنَصِّفَاتِ!",
  "ts.win2": "{أَنْشَأْتَ|أَنْشَأْتِ} المُنَصِّفَ وَالعَمُودَ المُنَصِّفَ {وَبَرْهَنْتَ|وَبَرْهَنْتِ}، {وَحَسَبْتَ|وَحَسَبْتِ} جَا وَجَتَا وَظَا وَالارْتِفَاعَ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {سَيِّدِ|سَيِّدَةِ} المُنَصِّفَاتِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَعِدْ|أَعِيدِي} مَسْحَ عَمُودِ الإِنَارَةِ مِنْ مَسَافَةٍ أُخْرَى، {وَقَارِنِ|وَقَارِنِي} الارْتِفَاعَيْنِ مَعَ {أَهْلِكَ|أَهْلِكِ}."
  ]
 },
