 "labels": {
  "bagCompass": "فِرْجَارٌ",
  "bagProt": "مِنْقَلَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} فِرْجَارٌ وَمِنْقَلَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي حَيِّ المُنَصِّفَاتِ وَرْشَةُ فِرْجَارٍ كَبِيرَةٌ وَمِيزَانٌ لِلنِّسَبِ. وَاليَوْمَ مَحْكَمَةُ المُنَصِّفِ وَالنِّسْبَةِ: {تَحْكُمُ|تَحْكُمِينَ} {وَتَحْسُبُ|وَتَحْسُبِينَ}.",
  "hook.02": "مَنْ يُنْشِئُ وَيُبَرْهِنُ وَيَقِيسُ بِالنِّسَبِ يَبْنِي الجُزْءَ الثَّامِنَ مِنْ نَاعُورَةِ الاخْتِرَاعِ، وَيَأْخُذُ شَارَةَ {سَيِّدِ|سَيِّدَةِ} المُنَصِّفَاتِ.",
  "mat.01": "{نَصِّفْ|نَصِّفِي} زَاوِيَةً بِالفِرْجَارِ، {وَتَحَقَّقْ|وَتَحَقَّقِي} بِالمِنْقَلَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المُنَصِّفُ وَالعَمُودُ المُنَصِّفُ بِالفِرْجَارِ، وَنُقَطُهُمَا تَبْعُدُ بِالتَّسَاوِي، وَبُرْهَانُهُمَا بِالتَّطَابُقِ.",
  "rv.02": "وَجَا المُقَابِلُ عَلَى الوَتَرِ، وَجَتَا المُجَاوِرُ عَلَى الوَتَرِ، وَظَا المُقَابِلُ عَلَى المُجَاوِرِ.",
  "gm.intro": "لُعْبَةُ: مَحْكَمَةُ المُنَصِّفِ وَالنِّسْبَةِ! {اُحْكُمْ|اُحْكُمِي} {وَعَلِّلْ|وَعَلِّلِي}.",
  "gm.r1": "حَكَمْنَا أَنَّ «جَا ثَلَاثِينَ نِصْفٌ» صَوَابٌ. لِمَاذَا؟",
  "gm.r1a": "لِأَنَّ المُقَابِلَ لِزَاوِيَةِ ثَلَاثِينَ نِصْفُ الوَتَرِ فِي كُلِّ قِيَاسٍ قِسْنَاهُ.",
  "gm.r1b": "لِأَنَّ ثَلَاثِينَ نِصْفُ سِتِّينَ، وَجَا السِّتِّينَ وَاحِدٌ صَحِيحٌ.",
  "gm.r1c": "لِأَنَّ الزَّاوِيَةَ ثَلَاثُونَ دَرَجَةً، فَنَقْسِمُهَا عَلَى سِتِّينَ وَنَأْخُذُ النَّاتِجَ.",
  "gm.r2": "حَكَمْنَا أَنَّ «العَمُودُ المُنَصِّفُ يَمُرُّ بِطَرَفِ القِطْعَةِ» خَطَأٌ. لِمَاذَا؟",
  "gm.r2a": "لِأَنَّهُ يَمُرُّ بِالمُنْتَصَفِ عَمُودِيًّا، وَالطَّرَفُ لَيْسَ المُنْتَصَفَ.",
  "gm.r2b": "لِأَنَّهُ يُوَازِي القِطْعَةَ فَلَا يَلْتَقِي بِهَا فِي نُقْطَةٍ.",
  "gm.r2c": "لِأَنَّ العَمُودَ المُنَصِّفَ يَمُرُّ بِالطَّرَفَيْنِ مَعًا لَا بِطَرَفٍ وَاحِدٍ.",
  "pr.r9": "قَالَتْ فَوْضَى: جَا خَمْسٍ وَأَرْبَعِينَ تُسَاوِي جَتَا خَمْسٍ وَأَرْبَعِينَ. مَا خَطَؤُهَا؟",
  "pr.r9a": "لَا خَطَأَ: الضِّلْعَانِ القَائِمَانِ مُتَسَاوِيَانِ فِي هَذِهِ الزَّاوِيَةِ.",
  "pr.r9b": "الخَطَأُ أَنَّ جَا أَكْبَرُ مِنْ جَتَا فِي الزَّوَايَا الحَادَّةِ.",
  "pr.r9c": "الخَطَأُ أَنَّ جَتَا خَمْسٍ وَأَرْبَعِينَ صِفْرٌ، فَلَا ضِلْعَ مُجَاوِرَ لِلزَّاوِيَةِ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "ts.12": "قَالَتْ فَوْضَى: الارْتِفَاعُ هُوَ المَسَافَةُ مَقْسُومَةً عَلَى ظَا الزَّاوِيَةِ. مَا خَطَؤُهَا؟",
  "ts.12a": "ظَا المُقَابِلُ عَلَى المُجَاوِرِ، فَالارْتِفَاعُ المَسَافَةُ مَضْرُوبَةً فِي ظَا.",
  "ts.12b": "لَا خَطَأَ: نَقْسِمُ عَلَى ظَا لِنَجِدَ الارْتِفَاعَ المَجْهُولَ.",
  "ts.12c": "الخَطَأُ أَنَّهَا اسْتَعْمَلَتْ ظَا، وَالصَّوَابُ أَنْ تَسْتَعْمِلَ جَا زَاوِيَةِ النَّظَرِ.",
  "ts.rem": "نَعُودُ إِلَى القَوْسَيْنِ وَالوَتَرِ وَالجَدْوَلِ وَالشَّجَرَةِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! هَذَا الجُزْءُ الثَّامِنُ مِنْ نَاعُورَةِ الاخْتِرَاعِ."
  ],
  "ts.win1": "{أَخَذْتَ|أَخَذْتِ} شَارَةَ {سَيِّدِ|سَيِّدَةِ} المُنَصِّفَاتِ!",
  "ts.win2": "{أَنْشَأْتَ|أَنْشَأْتِ} المُنَصِّفَ وَالعَمُودَ المُنَصِّفَ {وَبَرْهَنْتَ|وَبَرْهَنْتِ}، {وَحَسَبْتَ|وَحَسَبْتِ} جَا وَجَتَا وَظَا وَالارْتِفَاعَ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ {سَيِّدِ|سَيِّدَةِ} المُنَصِّفَاتِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِفْ|قِفِي} أَمَامَ عَمُودِ إِنَارَةٍ عَلَى بُعْدٍ يَقِيسُهُ {أَهْلُكَ|أَهْلُكِ} بِالشَّرِيطِ، {وَاقْرَأْ|وَاقْرَئِي} {أَنْتَ|أَنْتِ} زَاوِيَةَ النَّظَرِ بِالمِنْقَلَةِ وَالخَيْطِ، ثُمَّ {اُحْسُبِ|اُحْسُبِي} الارْتِفَاعَ {وَأَضِفِ|وَأَضِيفِي} ارْتِفَاعَ {عَيْنِكَ|عَيْنِكِ}."
  ]
 },
